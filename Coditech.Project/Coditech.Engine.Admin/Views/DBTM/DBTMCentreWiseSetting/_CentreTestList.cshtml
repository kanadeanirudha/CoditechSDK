@model DBTMCentreWiseTestListViewModel
@{
    Layout = null;
    ModelPopUpViewModel popup = new ModelPopUpViewModel() { ModelPopUpId = "AssociateTestPopup", ModalContentId = "AssociateTestPopupContent" };
}
<div class="row">
    <div class="col-sm-12 table-responsive">
        <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%;">
            <thead>
                <tr>
                    <th>
                        <input type="checkbox" id="chkSelectAll" /> All
                    </th>
                    <th>Activity</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.DBTMCentreWiseTestList?.Count > 0)
                {
                    foreach (var test in Model.DBTMCentreWiseTestList)
                    {
                        <tr>
                            <td>
                                <input type="checkbox"
                                       class="activity-checkbox"
                                       value="@test.DBTMTestMasterId"
                                       data-centrewisetestid="@test.DBTMCentreWiseTestId"
                                       data-associated="@test.IsAssociated.ToString().ToLower()"/>
                            </td>
                            <td>@test.TestName</td>
                            <td class="text-center">
                                @Html.Partial("~/Views/Shared/Datatable/_DatatableTrueFalse.cshtml", test.IsAssociated)
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@Html.Partial("~/Views/Shared/_ModelPopUp.cshtml", popup)