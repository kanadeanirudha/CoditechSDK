@model DBTMCentreWiseSettingViewModel
@{
    ViewBag.Title = Model.DBTMCentreWiseSettingId > 0 ? "Update Centre Wise Setting" : "Add Centre Wise Setting";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    PageHeaderViewModel headerModel = new PageHeaderViewModel
            {
                Title = ViewBag.Title,
                SaveButtonText = GeneralResources.SaveButtonText,
                CancelUrl = Url.Action("List", "OrganisationCentreMaster"),
                CancelButtonText = GeneralResources.CancelButtonText,
                ControllerName = controllerName,
                ActionName = actionName,
                FormId = AdminConstants.FormId + controllerName,
            };
    DropdownViewModel centreDropdown = new DropdownViewModel() { DropdownType = DropdownTypeEnum.AccessibleCentre.ToString(), DropdownName = "CentreCode", DropdownSelectedValue = Model.CentreCode, IsDisabled = Model.OrganisationCentreMasterId > 0 };
    ModelPopUpViewModel addTestModel = new ModelPopUpViewModel() { ModelPopUpId = "AssociateTestPopup",  ModalContentId = "AssociateTestPopupContent" };
}
<div class="page-content">
    <div class="container-fluid  mt-5">
        <div class="row">
            @if (Model.OrganisationCentreMasterId > 0)
            {
                <div class="col-lg-2">
                    @Html.Partial("~/Views/Organisation/OrganisationCentre/_OrganisationCentreSidePannel.cshtml", Model.OrganisationCentreMasterId.ToString())
                </div>
            }
            <div class="col-lg-10">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                        {
                            @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
                            @Html.HiddenFor(m => m.DBTMCentreWiseSettingId)
                            @Html.HiddenFor(m => m.OrganisationCentreMasterId)
                            @Html.HiddenFor(m => m.CentreCode)
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.CentreCode, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", centreDropdown)
                                        @Html.ValidationMessageFor(x => x.CentreCode)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.TypeOfCentre, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", new DropdownViewModel()
                               {
                                   DropdownSelectedValue = Model.TypeOfCentre ?? string.Empty,
                                   DropdownName = "TypeOfCentre",
                                   GroupCode = DropdownCustomTypeEnum.TypeOfCentre.ToString(),
                                   IsTextValueSame = true,
                                   IsRequired = true,
                                   IsStringProperty = true
                               })
                                        @Html.ValidationMessageFor(x => x.TypeOfCentre)
                                    </div>
                                </div>
                            <div class="col-lg-3">
                                <div class="mb-3">
                                    @Html.LabelFor(x => x.AllowJoiningCode, new { @class = "form-label required" })
                                    @Html.TextBoxFor(x => x.AllowJoiningCode, new { @class = "form-control", onkeypress = "return CoditechCommon.ValidNumeric()", maxlength = "99999", min = "1" })
                                    @Html.ValidationMessageFor(x => x.AllowJoiningCode)
                                </div>
                            </div>
                            </div>
                        }
                        <div class="accordion mt-4 compact-accordion" id="centreTestAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingCentreTest">
                                    <button class="accordion-button"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapseCentreTest"
                                            aria-expanded="true">
                                        <strong>Centrewise Activity List </strong>
                                    </button>
                                </h2>
                                <div id="collapseCentreTest"
                                     class="accordion-collapse collapse show"
                                     data-bs-parent="#centreTestAccordion">
                                    <div class="accordion-body">
                                        @Html.Partial("~/Views/DBTM/DBTMCentreWiseSetting/_CentreTestList.cshtml", Model.TestListViewModel ?? new DBTMCentreWiseTestListViewModel())
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .compact-accordion .accordion-button {
        padding-top: 6px !important;
        padding-bottom: 6px !important;
    }
    .compact-accordion .accordion-header {
        margin: 0;
    }
    .compact-accordion .accordion-item {
        border: 0;
    }
</style>
@Html.Partial("~/Views/Shared/_ModelPopUp.cshtml", addTestModel)
@section scripts {
    <script src="~/js/coditech/DBTM/DBTMCentreWiseTest.js"></script>
}

