@model DBTMActivitiesListViewModel
@{
    ViewBag.Title = "Activities List";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
}
<!-- Page Content-->
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Activities List : @Model.FirstName @Model.LastName</span>
                        <a class=" btn btn-sm btn-soft-secondary float-end" href="/DBTMTraineeDetails/Cancel?selectedCentreCode=@Model.SelectedCentreCode&GeneralTrainerMasterId=@Model.SelectedParameter2" role="button">
                            <i class="fas fa-arrow-left me-2"></i>Back
                        </a>
                    </div>
                    <div class="card-body">
                        <div id="DataTablesDivId" class="dataTables_wrapper dt-bootstrap5 no-footer">
                            @Html.Partial("~/Views/DBTM/DBTMActivities/_List.cshtml", Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="DBTMActivityDetailPopupId" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="DBTMActivityDetailPopupContentId">
        </div>
    </div>
</div>
<style>
    .stack-blur {
        filter: blur(4px);
        pointer-events: none;
    }
</style>
<!-- end page content -->
<script src="~/js/coditech/DBTM/DBTMTraineeDetails.js"></script>
<script src="~/js/coditech/DBTM/DBTMReports.js"></script>