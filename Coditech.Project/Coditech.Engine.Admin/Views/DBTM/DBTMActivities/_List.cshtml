@model DBTMActivitiesListViewModel
@{
    Layout = null;
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string css = "";
    ModelPopUpViewModel activityPopup = new ModelPopUpViewModel()
            {
                ModelPopUpId = "ActivityDetailsPopupId",
                ModalContentId = "ActivityDetailsContentId"
            };
}

<div class="row">
    @Html.Partial("~/Views/Shared/Datatable/_DatatableShowResult.cshtml", Model.PageListViewModel.RecordPerPage)
    @Html.Partial("~/Views/Shared/Datatable/_DatatableSearchData.cshtml", Model.PageListViewModel.SearchBy)
</div>

<div class="row">
    <div class="col-sm-12 table-responsive">
        <table id="datatable" class="action-set table table-striped table-bordered dt-responsive nowrap dataTable no-footer dtr-inline" style="border-collapse: collapse; border-spacing: 0px; width: 100%;" role="grid" aria-describedby="datatable_info">
            @Html.Partial("~/Views/Shared/Datatable/_DatatableColumns.cshtml", Model.PageListViewModel)
            @Html.HiddenFor(x => x.SelectedParameter1)
            @Html.HiddenFor(x => x.SelectedParameter2)
            <tbody>
                @if (Model?.ActivitiesList?.Count > 0)
                {
                    foreach (var item in Model?.ActivitiesList)
                    {
                        <tr>
                            <td>@item.TestName</td>
                            <td>@item.Date.ToCoditechDateWithTimeFormat()</td>
                            <td>@item.DeviceSerialCode</td>
                            <td class="text-center data-action">
                                <a data-bs-toggle="modal" data-bs-target="#ActivityDetailsPopupId" href="javascript:void(0)" onclick="DBTMTraineeDetails.GetActivityDetails('ActivityDetailsContentId', '@item.DBTMDeviceDataId', '@Model.SelectedParameter2')" title="View" class="btn btn-sm btn-soft-success btn-circle"> <i class="fas fa-eye"></i> </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@Html.Partial("~/Views/Shared/Datatable/_DatatablePagination.cshtml", Model.PageListViewModel)
@Html.Partial("~/Views/Shared/_ModelPopUp.cshtml", activityPopup)
<script src="~/js/coditech/DBTM/DBTMTraineeDetails.js"></script>
<style>
    #ActivityDetailsPopupId .modal-dialog {
        max-width: 1140px !important; 
    }
</style>
