@using Coditech.Admin.ViewModel
@model DBTMNewRegistrationViewModel
@{
    ViewBag.Title = "Trainee Registration";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    PageHeaderViewModel headerModel = new PageHeaderViewModel
            {
                Title = ViewBag.Title,
                SaveButtonText = !string.IsNullOrEmpty(Model.JoiningCode) && Model.AllTrainerList != null && Model.AllTrainerList.Any() ? GeneralResources.SaveButtonText : string.Empty,
                CancelUrl = Url.Action(AdminConstants.ActionRedirectToList, controllerName),
                CancelButtonText = GeneralResources.CancelButtonText,
                ControllerName = controllerName,
                ActionName = actionName,
                FormId = AdminConstants.FormId + controllerName,
            };
}
<!-- Page Content-->
<div class="page-content">
    <div class="container-fluid mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm("TraineeRegistration", controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                        {
                            @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
                            bool trainersLoaded = false;
                            bool isTrainer = false;
                            var user = SessionHelper.GetDataFromSession<UserModel>
                            (AdminConstants.UserDataSession);
                            if (user?.Custom1 == CustomConstants.DBTMTrainer)
                            {
                                isTrainer = true;
                            }
                            @if (!string.IsNullOrEmpty(Model.JoiningCode) && Model.AllTrainerList != null && Model.AllTrainerList.Any())
                            {
                                trainersLoaded = true;
                            }
                            string buttonText = trainersLoaded ? "Change" : "Join";
                            string clickHandler = trainersLoaded ? "ChangeJoinningCode()" : "GetTrainerDropdownByJoiningCode()";
                            string labelText = trainersLoaded ? "Loaded" : " ";
                            @Html.AntiForgeryToken()
                            <div class="row">
                                @if (!string.IsNullOrEmpty(Model.JoiningCode) && Model.AllTrainerList != null && Model.AllTrainerList.Any())
                                {
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label required" for="JoiningCode">Joining Code</label>
                                            @Html.TextBoxFor(x => x.JoiningCode, new { id = "JoiningCode", @class = "form-control", onkeypress = "return CoditechCommon.AvoidSpacing()", @readonly = "readonly" })
                                            @Html.ValidationMessageFor(x => x.JoiningCode)
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-lg-3">
                                        <div class="mb-3">
                                            <label class="form-label required" for="JoiningCode">Joining Code</label>
                                            @Html.TextBoxFor(x => x.JoiningCode, new { id = "JoiningCode", @class = "form-control", onkeypress = "return CoditechCommon.AvoidSpacing()" })
                                            @Html.ValidationMessageFor(x => x.JoiningCode)
                                        </div>
                                    </div>
                                }
                                <div class="col-lg-1">
                                    <div class="mb-1">
                                        <label class="form-label">&nbsp;</label>
                                        <div class="form-check" style="padding-left:0px !important; display:block !important">
                                            @* @if (!isTrainer)
                                            { *@
                                            <button type="button" class="btn btn-success" onclick="@clickHandler">@buttonText</button>
                                            @* } *@
                                        </div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.JoiningCode) && Model.AllTrainerList != null && Model.AllTrainerList.Any())
                                {
                                    <div class="col-lg-3">
                                        <div class="mb-3 multiselect-dropdown">
                                            @Html.LabelFor(x => x.SelectedTrainer, new { @class = "form-label required" })
                                            @if (isTrainer)
                                            {
                                                @Html.ListBoxFor(m => m.SelectedTrainer,
                                                         new SelectList(Model.AllTrainerList, "Value", "Text"),
                                                         new
                                                         {
                                                             @class = "selectpicker form-control",
                                                             multiple = "multiple",
                                                             data_live_search = "true",
                                                             disabled = "disabled"
                                                         })
                                            }
                                            else
                                            {
                                                @Html.ListBoxFor(m => m.SelectedTrainer,
                                                         new SelectList(Model.AllTrainerList, "Value", "Text"),
                                                         new
                                                         {
                                                             @class = "selectpicker form-control",
                                                             multiple = "multiple",
                                                             data_live_search = "true"
                                                         })
                                            }
                                            @Html.ValidationMessageFor(x => x.SelectedTrainer)
                                            @if (isTrainer)
                                            {
                                                foreach (var trainerId in Model.SelectedTrainer)
                                                {
                                                    <input type="hidden" name="SelectedTrainer" value="@trainerId" />
                                                }
                                            }
                                        </div>
                                    </div>
                                    <!-- Radio Buttons Section -->
                                    <div class="col-lg-4">
                                        <div class="mb-3">
                                            <label class="form-label required d-block">User Type</label>
                                            <div class="d-flex align-items-center gap-4">
                                                <div class="form-check">
                                                    @Html.RadioButtonFor(m => m.RegistrationType, "Batch",
                                                             new { @class = "form-check-input", id = "BatchUser" })
                                                    <label class="form-check-label ms-1" for="BatchUser">
                                                        Batch User
                                                    </label>
                                                </div>
                                                <div class="form-check">
                                                    @Html.RadioButtonFor(m => m.RegistrationType, "Camp",
                                                             new { @class = "form-check-input", id = "CampUser" })
                                                    <label class="form-check-label ms-1" for="CampUser">
                                                        Camp User
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            @Html.Partial("~/Views/Shared/DBTMRegistration/_DBTMTraineeRegistration.cshtml", Model)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/coditech/Common/CoditechCommon.js"></script>
@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $(".view-password").click(function () {
                $(this).toggleClass("fa fa-eye-slash");
                var inputAttribute = $('.password-input');
                if (inputAttribute.attr("type") == "password") {
                    inputAttribute.attr("type", "text");
                } else {
                    inputAttribute.attr("type", "password");
                }
            });

            $("#DateOfBirth").datepicker({
                changeMonth: true,
                changeYear: true,
                yearRange: "-100:+0",
                dateFormat: "yy-mm-dd",
                autoSize: true,
                gotoCurrent: true,
                showButtonPanel: true,
                closeText: 'Clear',
                minDate: "-80Y",
                maxDate: new Date(),
                onClose: function () {
                    if ($(document.activeElement).hasClass("ui-datepicker-close")) {
                        $(this).val('');
                    }
                }
            });
        });
        function GetTrainerDropdownByJoiningCode() {
            debugger;
            const joiningCode = $("#JoiningCode").val();
            if (joiningCode.length >= 5) {
                CoditechCommon.ShowLodder();
                const url = `/DBTMTraineeDetails/TraineeRegistration?joiningCode=${encodeURIComponent(joiningCode)}`;
                window.location.href = url;
            }
            else {
                if (joiningCode === '') {
                    CoditechNotification.DisplayNotificationMessage('Joining code is required.', 'error');
                }
                else {
                    CoditechNotification.DisplayNotificationMessage('Joining code must be at least 5 characters.', 'error');
                }
            }
        }
        function ChangeJoinningCode() {
            if (confirm("Are you sure?")) {
                window.location.href = "/DBTMTraineeDetails/TraineeRegistration?isChange=true";
            }
        }
    </script>
}