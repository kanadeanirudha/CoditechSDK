@using Coditech.Admin.Utilities;
@using Coditech.Common.API.Model;
@model DBTMTraineeProfileViewModel
@{
    ViewBag.Title = "User Profile";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string dashboardUrl = CoditechAdminSettings.DashboardUrl;
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0">User Profile</h4>

                         <button type="button" class="btn btn-success" onclick="DBTMTraineeDetails.DownloadAthleteReportPdf(@Model.DBTMTraineeDetailId,'@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Remarks ?? ""))')">
                        <i class="fa fa-download"></i> Download PDF
                        </button>
                    </div>

                    <div class="card-body">
                        <div class="dastone-profile">
                            <div class="row">
                                <div class="col-lg-4 align-self-center mb-3 mb-lg-0">
                                    <div class="dastone-profile-main">
                                        <div class="dastone-profile-main-pic position-relative" style="width: 110px; height: 110px;">
                                            @if (!string.IsNullOrEmpty(Model.PhotoMediaPath))
                                            {
                                                <img id="imagePreview" src="@Model.PhotoMediaPath" alt="User Image" class="rounded-circle w-100 h-100" style="object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div id="imagePreview" class="rounded-circle bg-soft-primary text-white w-100 h-100 d-flex align-items-center justify-content-center" style="font-size: 36px; object-fit: cover;">
                                                    @Model.FirstName.Substring(0, 1)@Model.LastName.Substring(0, 1)
                                                </div>
                                            }
                                        </div>

                                        <div class="dastone-profile_user-detail">
                                            <h5 class="dastone-user-name"> @Model.FirstName @Model.LastName</h5>
                                            <p class="mb-0 dastone-user-name-post">@Model.Specialization</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 ms-auto align-self-center">
                                    <ul class="list-unstyled personal-detail mb-0">
                                        <li>
                                            <i class="fas fa-birthday-cake me-2 text-secondary font-16 align-middle"></i>
                                            <b>Date Of Birth</b>: @Model.DateOfBirth.ToCoditechDateFormat()
                                        </li>
                                        <li class="mt-2">
                                            <i class="fas fa-calendar-check me-2 text-secondary font-16 align-middle"></i>
                                            <b>Date of Joining</b>: @Model.DateOfJoining.ToCoditechDateFormat()
                                        </li>
                                        <li class="mt-2">
                                            <i class="fas fa-trophy me-2 text-secondary font-16 align-middle"></i>
                                            <b>Rank</b>: @Model.Rank
                                        </li>
                                    </ul>
                                </div>

                                <div class="col-lg-4 align-self-center">
                                    <ul class="list-unstyled personal-detail mb-0">
                                        <li class="mt-2">
                                            <i class="fas fa-clock me-2 text-secondary font-16 align-middle"></i>
                                            <b>Duration</b>: @Model.TotalDuration
                                        </li>
                                        <li class="mt-2">
                                            <i class="fas fa-hourglass-half me-2 text-secondary font-16 align-middle"></i>
                                            <b>Weekly Hours</b>: @Model.WeekelyHours
                                        </li>
                                        <li class="mt-2">
                                            <i class="fas fa-weight me-2 text-secondary font-16 align-middle"></i>
                                            <b>Weight</b>: @Model.Weight
                                        </li>
                                    </ul>
                                </div>


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">

            <!-- PERSONAL INFORMATION FORM -->
            <div class="col-lg-6 col-xl-6">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0">Body Structure</h4>
                    </div>
                    <div class="card-body text-center">
                        <img src="~/assets/images/dbtm/DBTMBodyStructure.jpeg" alt="Body Structure" class="img-fluid" />
                    </div>
                </div>
            </div>

            <!-- GRAPHS -->
            <div class="col-lg-6 col-xl-6">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Graphs</h4>
                    </div>
                    <div class="card-body">
                        <canvas id="performanceChart" height="300"></canvas>
                    </div>
                </div>
            </div>

        </div>
        <!-- TEST PERFORMANCE RECORDS -->
        @{
            var traineeProfilePerformanceList = (Model.TraineeProfilePerformanceList ?? new List<DBTMTraineeProfilePerformanceModel>())
            .GroupBy(x => x.PerformanceMatrix).ToDictionary(g => g.Key, g => g.ToList());
        }
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header text-center">
                        <h4 class="card-title">Activity Performance</h4>
                    </div>
                    <div class="card-body">
                        @if (traineeProfilePerformanceList.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped text-center align-middle">
                                    <thead class="text-center">
                                        <tr>
                                            @foreach (var matrix in traineeProfilePerformanceList.Keys)
                                            {
                                                <th class="text-center">@matrix</th>
                                                <th class="text-center">Score</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int maxRows = traineeProfilePerformanceList.Values.Max(g => g.Count);
                                            for (int i = 0; i < maxRows; i++)
                                            {
                                                <tr>
                                                    @foreach (var matrix in traineeProfilePerformanceList.Keys)
                                                    {
                                                        var tests = traineeProfilePerformanceList[matrix];
                                                        if (i < tests.Count)
                                                        {
                                                            <td class="text-center align-middle">@tests[i].TestName</td>
                                                            if (tests[i].IsUp)
                                                            {
                                                                <td class="text-center align-middle"><i class="fas fa-arrow-up"></i> @tests[i].Score</td>
                                                            }
                                                            else
                                                            {
                                                                <td class="text-center align-middle"><i class="fas fa-arrow-down"></i> @tests[i].Score</td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center align-middle">-</td>
                                                            <td class="text-center align-middle">-</td>
                                                        }
                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-center">No performance records available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<iframe id="hiddenDownloader"
        style="display:none;"
        title="pdf-downloader">
</iframe>
<script src="~/js/coditech/DBTM/DBTMTraineeDetails.js"></script>
