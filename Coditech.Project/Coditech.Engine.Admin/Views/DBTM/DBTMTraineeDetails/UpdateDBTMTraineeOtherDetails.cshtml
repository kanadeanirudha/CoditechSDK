@model DBTMTraineeDetailsViewModel
@{
    ViewBag.Title = "Update Trainee Other Details";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    Dictionary<string, string> keyValuePairs = new Dictionary<string, string>();
    keyValuePairs.Add("DBTMTraineeDetailId", Model.DBTMTraineeDetailId > 0 ? Model.DBTMTraineeDetailId.ToString() : Model.EntityId.ToString());
    keyValuePairs.Add("PersonId", Model.PersonId.ToString());
    PageHeaderViewModel headerModel = new PageHeaderViewModel
            {
                Title = $"{ViewBag.Title} : {Model.FirstName} {Model.LastName}",
                SaveButtonText = GeneralResources.SaveButtonText,
                CancelUrl = Url.Action(AdminConstants.ActionRedirectToList, controllerName, new { SelectedCentreCode = Model.CentreCode, GeneralTrainerMasterId = Model.GeneralTrainerMasterId }),
                CancelButtonText = GeneralResources.CancelButtonText,
                ControllerName = controllerName,
                ActionName = actionName,
                FormId = AdminConstants.FormId + controllerName,
            };
}
<!-- Page Content-->
<div class="page-content">
    <div class="container-fluid mt-5">
        <div class="row">
            <div class="col-lg-2">
                @Html.Partial("~/Views/DBTM/DBTMTraineeDetails/_DBTMTraineeDetailsSidePannel.cshtml", keyValuePairs)
            </div>
            <div class="col-lg-10">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                        {
                            @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
                            @Html.HiddenFor(m => m.DBTMTraineeDetailId)
                            @Html.HiddenFor(m => m.PersonId)
                            @Html.HiddenFor(m => m.FirstName)
                            @Html.HiddenFor(m => m.LastName)
                            @Html.HiddenFor(m => m.CentreCode)
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.GroupEnumId, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", new DropdownViewModel()
                               {
                                   DropdownSelectedValue = Model.GroupEnumId.ToString(),
                                   DropdownName = "GroupEnumId",
                                   GroupCode = "GymGroup",
                                   IsRequired = true
                               })
                                        @Html.ValidationMessageFor(x => x.GroupEnumId)

                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.SourceEnumId, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", new DropdownViewModel()
                               {
                                   DropdownSelectedValue = Model.SourceEnumId.ToString(),
                                   DropdownName = "SourceEnumId",
                                   GroupCode = DropdownTypeEnum.LeadSource.ToString(),
                                   IsRequired = true
                               })
                                        @Html.ValidationMessageFor(x => x.SourceEnumId)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.AgeGroup, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml",
                                        new DropdownViewModel()
                                        {
                                            DropdownSelectedValue = Model.AgeGroup,
                                            DropdownName = "AgeGroup",
                                            GroupCode = DropdownCustomTypeEnum.AgeGroup.ToString(),
                                            IsRequired = true,IsDisabled=true
                                        })
                                        @Html.ValidationMessageFor(x => x.AgeGroup)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.Height, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.Height, new { @class = "form-control", onkeypress = "return CoditechCommon.ValidNumeric()", @min = "1" })
                                        @Html.ValidationMessageFor(x => x.Height)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.Weight, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.Weight, new { @class = "form-control", onkeypress = "return CoditechCommon.ValidDecimalNumeric()", @min = "1" })
                                        @Html.ValidationMessageFor(x => x.Weight)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.SpecializationEnumId, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", new DropdownViewModel()
                               {
                                   DropdownSelectedValue = Model.SpecializationEnumId.ToString(),
                                   DropdownName = "SpecializationEnumId",
                                   GroupCode = DropdownCustomTypeEnum.TraineeSpecialization.ToString(),
                                   IsRequired = true,
                               })
                                        @Html.ValidationMessageFor(x => x.SpecializationEnumId)
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.MedicalHistory, new { @class = "form-label" })
                                        @Html.TextAreaFor(x => x.MedicalHistory, new { @class = "form-control", @maxlength = "500" })
                                        @Html.ValidationMessageFor(x => x.MedicalHistory)
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.PastInjuries, new { @class = "form-label" })
                                        @Html.TextAreaFor(x => x.PastInjuries, new { @class = "form-control", @maxlength = "500" })
                                        @Html.ValidationMessageFor(x => x.PastInjuries)
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.OtherInformation, new { @class = "form-label" })
                                        @Html.TextAreaFor(x => x.OtherInformation, new { @class = "form-control", @maxlength = "500" })
                                        @Html.ValidationMessageFor(x => x.OtherInformation)
                                    </div>
                                </div>
                                @if (string.Equals(Model.TypeOfCentre?.Trim(), CustomConstants.School, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="row">
                                        <!-- School Name -->
                                        <div class="col-lg-4">
                                            <div class="mb-3">
                                                @Html.LabelFor(x => x.SchoolName, new { @class = "form-label required" })
                                                @Html.TextBoxFor(x => x.SchoolName, new { @class = "form-control", onkeypress = "return CoditechCommon.AllowAlphabetWithSpacing()" })
                                                @Html.ValidationMessageFor(x => x.SchoolName)
                                            </div>
                                        </div>

                                        <!-- Standard Dropdown (1–10) -->
                                        <div class="col-lg-4">
                                            <div class="mb-3">
                                                @Html.LabelFor(x => x.Standard, new { @class = "form-label required" })

                                                @Html.DropDownListFor(
                                                         x => x.Standard,
                                                         Enumerable.Range(1, 10)
                                                         .Select(i => new SelectListItem
                                        {
                                            Text = i.ToString(),
                                            Value = i.ToString()
                                        }),
                                                         "----Select Standard----",
                                                         new { @class = "form-control" }
                                                         )

                                                @Html.ValidationMessageFor(x => x.Standard)
                                            </div>
                                        </div>

                                        <!-- Section Dropdown (A–F) -->
                                        <div class="col-lg-4">
                                            <div class="mb-3">
                                                @Html.LabelFor(x => x.Section, new { @class = "form-label required" })

                                                @Html.DropDownListFor(
                                                         x => x.Section,
                                                         new List<SelectListItem>
                                        {
                                        new SelectListItem { Text = "A", Value = "A" },
                                        new SelectListItem { Text = "B", Value = "B" },
                                        new SelectListItem { Text = "C", Value = "C" },
                                        new SelectListItem { Text = "D", Value = "D" },
                                        new SelectListItem { Text = "E", Value = "E" },
                                        new SelectListItem { Text = "F", Value = "F" }
                                        },
                                                         "----Select Section----",
                                                         new { @class = "form-control" }
                                                         )

                                                @Html.ValidationMessageFor(x => x.Section)
                                            </div>
                                        </div>

                                    </div>
                                }

                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let heightInput = document.querySelector("[name='Height']");

        if (heightInput) {
            let heightValue = parseFloat(heightInput.value);

            // Check if the height is a whole number
            if (!isNaN(heightValue) && heightValue % 1 === 0) {
                heightInput.value = heightValue.toFixed(0); // Convert to integer format
            }
        }
    });
</script>
<script>
    $(document).ready(function () {

        var selectedText = '@Model.AgeGroup';

        $("#AgeGroup option").each(function () {

            if ($(this).text().trim() == selectedText.trim()) {

                $("#AgeGroup").val($(this).val()).trigger('change');

            }
        });

    });
</script>
