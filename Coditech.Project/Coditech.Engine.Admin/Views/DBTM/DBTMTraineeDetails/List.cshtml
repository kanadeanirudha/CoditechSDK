@model DBTMTraineeDetailsListViewModel
@{
    ViewBag.Title = "All Trainee Details List";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    UserModel userModel = SessionHelper.GetDataFromSession<UserModel>(AdminConstants.UserDataSession);

    DropdownViewModel centreDropdown = new DropdownViewModel() { DropdownType = DropdownTypeEnum.AccessibleCentre.ToString(), DropdownName = "SelectedCentreCode", DropdownSelectedValue = Model.SelectedCentreCode, ChangeEvent = "DBTMTraineeDetails.GetDBTMTrainerListByCentreCode('" + Model.ListType + "')" };
    DropdownViewModel trainerDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.CentrewiseDBTMTrainer.ToString(),
                DropdownName = "SelectedParameter1",
                Parameter = Model.SelectedCentreCode,
                DropdownSelectedValue = Convert.ToString(Model.GeneralTrainerMasterId),
                ChangeEvent = "DBTMTraineeDetails.GetDBTMTrainerListByGeneralTrainerMasterId('" + Model.ListType + "')",
                IsCustomDropdown = true,
                SelectedText = "All",
                SelectedValue = "0"
            };
    ModelPopUpViewModel traineePopup = new ModelPopUpViewModel() { ModelPopUpId = "TraineePopupId", ModalContentId = "TraineeContentId", PopUpSize = PopUpSizeEnum.ExtraLarge };
    ModelPopUpViewModel remarkPopup = new ModelPopUpViewModel() { ModelPopUpId = "RemarkPopupId", ModalContentId = "RemarkContentId" };
}
<!-- Page Content-->
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        @if (Model.ListType == "Active")
                        {
                            <span class="card-title">Active Trainee List</span>
                        }
                        else if (Model.ListType == "InActive")
                        {
                            <span class="card-title">Inactive Trainee List</span>
                        }
                        else
                        {
                            <span class="card-title">All Trainee Details List</span>
                        }
                        @if (userModel?.Custom1 == CustomConstants.DBTMTrainer)
                        {
                            <a class="btn btn-soft-primary" href="@Url.Action("TraineeRegistration", "DBTMTraineeDetails", new { trainerId = @Model.SelectedParameter1 })"> Add Trainee </a>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a href="javascript:void(0);"
                                   class="btn btn-sm btn-success"
                                   data-bs-toggle="modal"
                                   data-bs-target="#TraineePopupId"
                                   onclick="DBTMTraineeDetails.GetUploadTraineePopup('TraineeContentId')">
                                    <i class="fas fa-upload me-2"></i> Upload Trainee
                                </a>
                                @*Centre Owner *@
                                <a class="btn btn-soft-primary" href="/DBTMTraineeDetails/TraineeRegistration"> Add Trainee </a>
                            </div>
                        }

                    </div>
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-1">
                                <label>@AdminResources.LabelCentre</label>
                            </div>
                            <div class="col-md-4">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", centreDropdown)
                            </div>
                            <div class="col-md-1">
                                <label>Trainer</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", trainerDropdown)
                            </div>
                            <div class="col-md-1">
                                @*  <input type="button" class="btn btn-success" value="Show" id="ShowDataId" onclick="CoditechCommon.LoadListByCentreCode('@controllerName','@actionName')" /> *@
                                <input type="button" class="btn btn-success" value="Show" id="ShowDataId" onclick="DBTMTraineeDetails.GetDBTMTrainerListByGeneralTrainerMasterId('@Model.ListType')" />
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="DataTablesDivId" class="dataTables_wrapper dt-bootstrap5 no-footer">
                            @Html.Partial("~/Views/DBTM/DBTMTraineeDetails/_List.cshtml", Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("~/Views/Shared/_ModelPopUp.cshtml", traineePopup)
@Html.Partial("~/Views/Shared/_ModelPopUp.cshtml", remarkPopup)
<script src="~/js/coditech/DBTM/DBTMTraineeDetails.js"></script>