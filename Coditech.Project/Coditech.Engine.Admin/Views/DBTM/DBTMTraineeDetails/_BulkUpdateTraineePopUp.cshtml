@{
    Layout = null;
    DropdownViewModel batchDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.BatchWiseReports.ToString(),
                DropdownName = "GeneralBatchMasterId",
                IsCustomDropdown = true
            };
    DropdownViewModel orderByDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.DBTMTraineeBulkUpdateOrderBy.ToString(),
                DropdownName = "OrderBy",
                DropdownSelectedValue = "FirstNameAsc",
                IsCustomDropdown = true
            };
}
<div class="modal-header">
    <h5 class="modal-title">Bulk Update Trainee</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"> </button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <label class="form-label required">Batch</label>
        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", batchDropdown)
        <span class="text-danger field-validation-valid"
              data-valmsg-for="GeneralBatchMasterId"
              data-valmsg-replace="true">
        </span>
    </div>
    <div class="mb-3">
        <label class="form-label required">Order By</label>
        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", orderByDropdown)
    </div>
    <div class="mt-3 d-flex justify-content-end">
        <button type="button"
                class="btn btn-warning warning-bg px-4"
                onclick="DBTMTraineeDetails.DownloadBulkUpdateTemplate()">
            <i class="fas fa-download me-2"></i>
            Download Trainee
        </button>
    </div>
</div>
<div class="modal-footer">
    <div class="row w-100 align-items-center g-2">
        <div class="col-md-7">
            <input type="file"
                   id="BulkUpdateTraineeFile"
                   class="form-control"
                   accept=".xlsx" />
        </div>
        <div class="col-md-2">
            <button type="button"
                    class="btn btn-success w-100"
                    onclick="DBTMTraineeDetails.UploadBulkUpdateTraineeFile()">
                <i class="fas fa-upload me-2"></i>
                Upload
            </button>
        </div>
        <div class="col-12">
            <div id="BulkUpdateValidationMsg"
                 class="text-danger">
            </div>
        </div>
    </div>
</div>
<style>
    .warning-bg {
        background-color: #ffc107 !important;
        border-color: #ffc107 !important;
        color: #fff !important;
    }
</style>