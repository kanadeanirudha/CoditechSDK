@{
    Layout = null;
    long traineeId = (long)ViewBag.TraineeId;
    string remarks = ViewBag.Remarks as string;
}

<div class="modal-header">
    <h5 class="modal-title">Enter Remark</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <div class="mb-3">
        <label class="form-label">Remarks</label>
        <textarea id="RemarksText" class="form-control" rows="4">@remarks</textarea>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-success" onclick="DBTMTraineeDetails.ConfirmDownloadPdf(@traineeId,'RemarkPopupId_@traineeId')"> Download Report</button>
</div>