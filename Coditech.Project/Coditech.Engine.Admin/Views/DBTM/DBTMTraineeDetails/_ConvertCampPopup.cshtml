@{
    long traineeId = ViewBag.TraineeId;
}

<div class="modal-header">
    <h5 class="modal-title">Convert Camp User To Batch User</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body text-center">
    <span>Are you sure you want to convert this Camp User to Batch User?</span>
</div>

<div class="modal-footer">
    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

    <button class="btn btn-success"
            onclick="DBTMTraineeDetails.ConfirmConvert(@traineeId)">
        Confirm
    </button>
</div>