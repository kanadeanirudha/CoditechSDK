@{
    Layout = null;
}
<div class="modal-header">
    <h5 class="modal-title">Upload Trainee</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div id="stepDownload">
        <div class="row mb-4">
            <div class="col-md-12 d-flex gap-3">
                <button type="button" class="btn btn-warning btn-sm warning-bg" onclick="DBTMTraineeDetails.DownloadTemplatePopup()"><i class="fas fa-download me-2"></i> Download Template </button>
                @* <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancel </button> *@
            </div>
        </div>
    </div>
    <div id="stepUpload">
        <div class="row align-items-center">
            <div class="col-md-8">
                <input type="file" id="TraineeFile" class="form-control" accept=".csv,.xlsx" />
            </div>
            <div class="col-md-4">
                <button type="button" class="btn btn-success" onclick="DBTMTraineeDetails.UploadTraineeFile()"><i class="fas fa-upload me-2"></i> Upload File </button>
            </div>
        </div>
        <div id="UploadFileValidationMsg" class="text-danger mt-1 mb-3" style="font-size:13px;"></div>
        <h6 id="ErrorHeader" class="text-danger mb-2" style="display:none;"> Data Correction Required </h6>
        <div id="UploadErrorTableContainer" class="table-responsive" style="max-height:350px;"></div>
    </div>
</div>
<style>
    .warning-bg {
        background-color: #ffc107 !important;
        border-color: #ffc107 !important;
        color: #fff !important;
    }
</style>
