@model DBTMTraineeDetailsListViewModel
@{
    Layout = null;
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string css = "";
    UserModel userModel = SessionHelper.GetDataFromSession<UserModel>(AdminConstants.UserDataSession);
}

<div class="row">
    @Html.Partial("~/Views/Shared/Datatable/_DatatableShowResult.cshtml", Model.PageListViewModel.RecordPerPage)
    @Html.Partial("~/Views/Shared/Datatable/_DatatableSearchData.cshtml", Model.PageListViewModel.SearchBy)
</div>

<div class="row">
    <div class="col-sm-12 table-responsive">
        <table id="datatable" class="action-set table table-striped table-bordered dt-responsive nowrap dataTable no-footer dtr-inline" style="border-collapse: collapse; border-spacing: 0px; width: 100%;" role="grid" aria-describedby="datatable_info">
            @Html.Partial("~/Views/Shared/Datatable/_DatatableColumns.cshtml", Model.PageListViewModel)
            <tbody>
                @if (Model?.DBTMTraineeDetailsList?.Count > 0)
                {
                    foreach (var item in Model?.DBTMTraineeDetailsList)
                    {
                        {
                            css = item.IsActive ? "" : "pointer-events: none;";
                        };
                        <tr>
                            <td style="text-align: center; width: 0px">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" class="rounded-circle thumb-xs me-1" />
                                }
                                else
                                {
                                    <div class="avatar-box thumb-xxs align-self-center">
                                        <span class="avatar-title bg-soft-pink rounded-circle">@item.FirstName.Substring(0, 1)@item.LastName.Substring(0, 1)</span>
                                    </div>
                                }
                            </td>
                            <td>
                                @Html.Partial("~/Views/Shared/_ActionLinkWithIcon.cshtml",
                                         new ActionViewModel()
                        {
                            Action = "UpdateDBTMTraineePersonalDetails",
                            Controller = controllerName,
                            RouteValues = new { dBTMTraineeDetailId = item.DBTMTraineeDetailId, personId = item.PersonId, SelectedParameter2 = Model.SelectedParameter2 },
                            Text = item.PersonCode,
                            Title = "Update"
                        })
                            </td>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.DisplayName</td>
                            <td>@item.MobileNumber</td>
                            <td>@item.EmailId</td>
                            <td style="text-align: center;">
                                @if (item.NumberOfActivityPerformed > 0)
                                {
                                    <a href="@Url.Action("TraineeActivitiesList", controllerName, new {
                                           SelectedParameter1 = item.PersonCode,
                                           SelectedParameter2 = Model.SelectedParameter2
                                       })">
                                        <span class="badge badge-soft-info">@item.NumberOfActivityPerformed</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary">@item.NumberOfActivityPerformed</span>
                                }
                            </td>
                            <td>
                                @Html.Partial("~/Views/Shared/Datatable/_DatatableTrueFalse.cshtml", item.IsBatchUser)
                            </td>
                            <td>
                                @Html.Partial("~/Views/Shared/Datatable/_DatatableTrueFalse.cshtml", item.IsCampUser)
                            </td>
                            <td>
                                @Html.Partial("~/Views/Shared/Datatable/_DatatableTrueFalse.cshtml", item.IsActive)
                            </td>
                            <td class="text-center data-action">
                                <a href="@Url.Action("UpdateDBTMTraineePersonalDetails", controllerName, new {
                                       dBTMTraineeDetailId = item.DBTMTraineeDetailId,
                                       personId = item.PersonId,
                                       SelectedParameter2 = Model.SelectedParameter2
                                   })"
                                   title="Update"
                                   class="btn btn-sm btn-soft-success btn-circle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <span class="m-2">|</span>

                                <a href="@Url.Action("Profile", controllerName, new {
                                        dBTMTraineeDetailId = item.DBTMTraineeDetailId
                                    })"
                                   title="Profile"
                                   class="btn btn-sm btn-soft-warning btn-circle">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (userModel?.Custom1 != CustomConstants.DBTMTrainer)
                                {
                                    <span class="m-2">|</span>
                                    <a href="#" title="Delete" class="btn btn-sm btn-soft-danger btn-circle" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal_@item.DBTMTraineeDetailId">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                    <div class="modal fade" id="confirmDeleteModal_@item.DBTMTraineeDetailId" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteModalLabel_@item.DBTMTraineeDetailId" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered"
                                             style="max-width: 600px; width: calc(100% - 30px);"
                                             role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title"
                                                        id="confirmDeleteModalLabel_@item.DBTMTraineeDetailId">
                                                        Confirm Delete
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                                                    </button>
                                                </div>
                                                <div class="modal-body" style="text-align: left; padding: 24px;">
                                                    <div style="display: flex; align-items: flex-start; gap: 14px;">
                                                        <div style="font-size: 26px; flex-shrink: 0; color: #ff0050;">
                                                            <i class="fas fa-exclamation-triangle"></i>
                                                        </div>
                                                        <div style="flex: 1; min-width: 0; font-size: 16px; line-height: 1.6; color: #344563; overflow-wrap: anywhere;">
                                                            <p style="margin: 0 0 14px 0; font-weight: 600;">
                                                                Are you sure you want to delete your account?
                                                            </p>
                                                            <p style="margin: 0 0 14px 0;">
                                                                Once your account is deleted, this action cannot be undone.<br>
                                                                You will permanently lose access to your account and its associated data.<br>
                                                                Your account cannot be recovered or reactivated after deletion.<br>
                                                            </p>
                                                            <p style="margin: 0;">
                                                                Please make sure you want to proceed before confirming.
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <a href="@Url.Action("DeleteUserAccount", controllerName, new {entityId = item.DBTMTraineeDetailId, selectedCentreCode = Model.SelectedCentreCode })"
                                                       class="btn btn-outline-danger">
                                                        Delete
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @*  <span class="m-2">|</span>
                                <a href="javascript:void(0);"
                                   title="Download Report"
                                   data-bs-toggle="modal"
                                   data-bs-target="#RemarkPopupId"
                                   onclick="DBTMTraineeDetails.GetRemarks('RemarkContentId', @item.DBTMTraineeDetailId, '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Remarks ?? ""))')"
                                   class="text-primary fs-5">
                                    <i class="fa fa-download"></i>
                                </a> *@
                                @if (item.IsCampUser && !item.IsBatchUser)
                                {
                                    <span class="m-2">|</span>
                                    <a href="javascript:void(0);"
                                       title="Convert To Batch User"
                                       data-bs-toggle="modal"
                                       data-bs-target="#ConvertCampPopupId"
                                       onclick="DBTMTraineeDetails.OpenConvertPopup('ConvertCampContentId', @item.DBTMTraineeDetailId)"
                                       class="btn btn-sm btn-soft-primary btn-circle">
                                        <i class="fas fa-exchange-alt"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<iframe id="hiddenDownloader"
        style="display:none;"
        title="pdf-downloader">
</iframe>
@Html.Partial("~/Views/Shared/Datatable/_DatatablePagination.cshtml", Model.PageListViewModel)
