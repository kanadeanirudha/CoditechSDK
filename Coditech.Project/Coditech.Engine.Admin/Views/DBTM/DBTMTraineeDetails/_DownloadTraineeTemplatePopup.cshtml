@{
    Layout = null;
}
<div class="modal-header">
    <h5 class="modal-title">Download Trainee Template</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <label class="form-label required">Number of Trainees</label>
        <input type="number" id="TraineeCount" class="form-control" min="1" max="999" onkeypress="return CoditechCommon.ValidNumeric()" oninput="this.value = this.value.replace(/[^0-9]/g, '')" placeholder="Enter number of trainees" />
        <span class="text-danger field-validation-valid"
              data-valmsg-for="TraineeCount"
              data-valmsg-replace="true">
        </span>
    </div>
</div>
<div class="modal-footer">
    <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">
        Cancel
    </button>
    <button type="button"
            class="btn btn-success"
            onclick="DBTMTraineeDetails.ConfirmDownloadTemplate()">
        Download Template
    </button>
</div>
