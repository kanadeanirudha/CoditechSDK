@{
    Layout = null;
}
<div class="modal-header">
    <h5 class="modal-title">Download Trainee Template</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <label class="form-label">Number of Trainees</label>
        <input type="number"
               id="TraineeCount"
               class="form-control"
               min="1" />
    </div>
</div>
<div class="modal-footer">
    <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">
        Cancel
    </button>
    <button type="button"
            class="btn btn-success"
            onclick="DBTMTraineeDetails.ConfirmDownloadTemplate()">
        Download Template
    </button>
</div>
