@{
    Layout = null;
    UserModel userModel = SessionHelper.GetDataFromSession<UserModel>(AdminConstants.UserDataSession);
    DropdownViewModel trainerDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.CentrewiseDBTMTrainer.ToString(),
                DropdownName = "GeneralTrainerMasterId",
                Parameter = userModel?.SelectedCentreCode,
                IsCustomDropdown = true
            };
}
<div class="modal-header">
    <h5 class="modal-title">Download Trainee Template</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <label class="form-label required">Number of Trainees</label>
        <input type="text" id="TraineeCount" class="form-control" maxlength="3" inputmode="numeric" pattern="[0-9]*" oninput="this.value = this.value.replace(/\D/g,'').slice(0,3)" placeholder="Enter number of trainees" />
        <span class="text-danger field-validation-valid" data-valmsg-for="TraineeCount" data-valmsg-replace="true"></span>
    </div>
    @if (userModel?.Custom1 == CustomConstants.DBTMCentreOwner)
    {
        <div class="mb-3">
            <label class="form-label required">Trainer</label>
            @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", trainerDropdown)
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancel </button>
    <button type="button" class="btn btn-success" onclick="DBTMTraineeDetails.ConfirmDownloadTemplate()"><i class="fas fa-download me-2" /></i> Download Template </button>
</div>
<div id="DownloadTemplateValidationMsg" class="text-danger mb-2"></div>
