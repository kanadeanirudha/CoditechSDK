@model DBTMCampMasterViewModel
@{
    ViewBag.Title = Model.DBTMCampMasterId > 0 ? "Update Camp" : "Add Camp";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string css = Model.DBTMCampMasterId > 0 ? "col-lg-10" : "col-lg-12";
    Dictionary<string, string> keyValuePairs = new Dictionary<string, string>();
    keyValuePairs.Add("DBTMCampMasterId", Model.DBTMCampMasterId.ToString());
    DropdownViewModel centreDropdown = new DropdownViewModel() { DropdownType = DropdownTypeEnum.AccessibleCentre.ToString(), DropdownName = "CentreCode", DropdownSelectedValue = Model.CentreCode, ChangeEvent = "DBTMCamp.OnCentreChange()", IsDisabled = Model.DBTMCampMasterId > 0 };
    DropdownViewModel frequencyDropdown = new DropdownViewModel() { DropdownType = DropdownTypeEnum.SchedulerFrequency.ToString(), DropdownName = "CampFrequency", DropdownSelectedValue = Model.CampFrequency, ExcludedValues = new string[] { "Recurring", "Weekly" } };
    PageHeaderViewModel headerModel = new PageHeaderViewModel
            {
                Title = ViewBag.Title,
                SaveButtonText = GeneralResources.SaveButtonText,
                CancelUrl = Url.Action(AdminConstants.ActionRedirectToList, controllerName, new { SelectedCentreCode = Model.CentreCode }),
                CancelButtonText = GeneralResources.CancelButtonText,
                ControllerName = controllerName,
                ActionName = actionName,
                FormId = AdminConstants.FormId + controllerName,
            };
}
<!-- Page Content-->
<div class="page-content">
    <div class="container-fluid mt-5">
        <div class="row">
            @if (Model.DBTMCampMasterId > 0)
            {
                <div class="col-lg-2">
                    @Html.Partial("~/Views/DBTM/DBTMCampMaster/_DBTMCampSidePannel.cshtml", keyValuePairs)
                </div>
            }
            <div class="@css">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                        {
                            @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
                            @Html.HiddenFor(m => m.DBTMCampMasterId)
                            @Html.HiddenFor(x => x.WeekDays)
                            @if (Model.DBTMCampMasterId > 0)
                            {
                                @Html.HiddenFor(x => x.CentreCode)
                            }
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.CentreCode, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", centreDropdown)
                                        @Html.ValidationMessageFor(x => x.CentreCode)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.CampName, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.CampName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.CampName)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.CampLocation, new { @class = "form-label" })
                                        @Html.TextBoxFor(x => x.CampLocation, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.CampLocation)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.CampFrequency, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", frequencyDropdown)
                                        @Html.ValidationMessageFor(x => x.CampFrequency)
                                    </div>
                                </div>
                               @*  <div class="row">                              
                                    <div class="col-lg-12" id="weeklyDiv">
                                        <div class="mb-3 multiselect-dropdown">
                                            @Html.LabelFor(x => x.SelectedWeekDays, new { @class = "form-label required" })
                                            @Html.ListBoxFor(x => x.SelectedWeekDays, new SelectList(Model.SchedulerWeekDaysList, "Value", "Text"), new { @class = "selectpicker form-control", multiple = "multiple", data_live_search = "true" })
                                            @Html.ValidationMessageFor(x => x.SelectedWeekDays)
                                        </div>
                                    </div>
                                </div> *@
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.CampStartDate, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.CampStartDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readOnly" })
                                        @Html.ValidationMessageFor(x => x.CampStartDate)
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.CampEndDate, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.CampEndDate,AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readOnly" })
                                        @Html.ValidationMessageFor(x => x.CampEndDate)
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.CampStartTime, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.CampStartTime, new { @class = "form-control", type = "time" })
                                        @Html.ValidationMessageFor(x => x.CampStartTime)
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.Duration, new { @class = "form-label required" })
                                        <div class="d-flex gap-3">
                                            @Html.DropDownListFor(x => x.DurationHours,
                                                     new SelectList(Enumerable.Range(0, 12).Select(i => new { Value = i.ToString("D2"), Text = i.ToString("D2") }),
                                                     "Value", "Text"),
                                                     "HH",
                                                     new { @class = "form-select", id = "DurationHours" })

                                            @Html.DropDownListFor(x => x.DurationMinutes,
                                                     new SelectList(Enumerable.Range(0, 60).Where(i => i % 5 == 0).Select(i => new { Value = i.ToString("D2"), Text = i.ToString("D2") }),
                                                     "Value", "Text"),
                                                     "MM",
                                                     new { @class = "form-select", id = "DurationMinutes" })
                                        </div>
                                        @Html.ValidationMessageFor(x => x.Duration)
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.IsActive, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12" id="ActivityDropdownDiv">
                                    @Html.Partial("~/Views/DBTM/DBTMCampMaster/_ActivityDropdown.cshtml", Model)
                                </div>
                                @if (Model.DBTMCampMasterId == 0)
                                {
                                    <div class="col-lg-12">
                                        <div class="mb-3 multiselect-dropdown">
                                            <label class="form-label" for="CustomDropdownSelectedValue2">Camp User</label>
                                            @Html.ListBoxFor(x => x.CustomDropdownSelectedValue2, new SelectList(Model.CustomDropdownList2, "Value", "Text"), new { @class = "selectpicker form-control", multiple = "multiple", data_live_search = "true" })
                                            @Html.ValidationMessageFor(x => x.CustomDropdownSelectedValue2)
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script src="~/js/coditech/DBTM/DBTMCamp.js"></script>
    <script>
        function updateCampEndDate() {
            var selectedFrequency = $("#CampFrequency").val();
            var startDate = $("#CampStartDate").datepicker("getDate");
            if (!startDate) return;
            $("#CampEndDate").datepicker("option", "minDate", startDate);
            var endDate = $("#CampEndDate").datepicker("getDate");
            if (endDate && endDate < startDate) {
                $("#CampEndDate").datepicker("setDate", startDate);
            }
            if (selectedFrequency === "OneTime") {
                $("#CampEndDate")
                    .datepicker("setDate", startDate)
                    .prop("readonly", true);
                $("#CampEndDate").datepicker("option", "beforeShow", function () {
                    return false;
                });
            } else {
                $("#CampEndDate").prop("readonly", false);
                $("#CampEndDate").datepicker("option", "beforeShow", null);
            }
        }
        $(document).ready(function () {
            var today = new Date();
            var maxFutureDate = new Date(
                today.getFullYear() + 10,
                today.getMonth(),
                today.getDate()
            );
            $("#CampStartDate").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: "@AdminGeneralHelper.DateFormatForCalendar()",
            minDate: 0,
            maxDate: maxFutureDate,
            onSelect: function () {
                var startDate = $(this).datepicker("getDate");
                $("#CampEndDate").datepicker("option", "minDate", startDate);
                updateCampEndDate();
            }
            });
            $("#CampEndDate").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: "@AdminGeneralHelper.DateFormatForCalendar()",
            maxDate: maxFutureDate,
            beforeShow: function (input, inst) {
                var startDate = $("#CampStartDate").datepicker("getDate");
                if (startDate) {
                    $(this).datepicker("option", "minDate", startDate);
                }
            }
            });
            $("#CampFrequency").change(updateCampEndDate);
            updateCampEndDate();
            $('form').on('submit', function (e) {
                var hours = $('#DurationHours').val();
                var minutes = $('#DurationMinutes').val();
                if (hours === "00" && minutes === "00") {
                    var validationSpan = $('[data-valmsg-for="Duration"]');
                    validationSpan
                        .text("Duration cannot be 00 Hours and 00 Minutes.")
                        .addClass("field-validation-error")
                        .removeClass("field-validation-valid");
                    e.preventDefault();
                }
            });
        });
    </script>
}

