@using Coditech.Admin.Utilities
@using Coditech.Common.API.Model
@using Newtonsoft.Json
@model DBTMDashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    // Yearly Trainee Overview
    string[] backgroundColor = ["rgba(42, 118, 244, 0.18)", "rgba(42, 118, 244, 0.30)"];
    int monthCount = Model.YearlyTraineeOverviewList.Count();
    string[] XValuesBarYearlyTraineeTrainedOverview = new string[monthCount];
    decimal[] YValuesBarYearlyTraineeTrainedOverview = new decimal[monthCount];
    int count1 = 0;
    foreach (var item in Model.YearlyTraineeOverviewList)
    {
        XValuesBarYearlyTraineeTrainedOverview[count1] = Convert.ToString(item.MonthName);
        YValuesBarYearlyTraineeTrainedOverview[count1] = Convert.ToInt32(item.TotalTrainee);
        count1++;
    }
    var traineeDataset = new List<BarGraphsDatasetModel>
    {
        new BarGraphsDatasetModel
        {
            Label = "Trainees",
            Data = JsonConvert.SerializeObject(YValuesBarYearlyTraineeTrainedOverview),
            Color = JsonConvert.SerializeObject(backgroundColor)
        }
    };
    BarChartModel traineeTrainedviewModel = new BarChartModel()
            {
                BarChartId = "YearlyTraineeTrainedOverviewChart",
                XValues = JsonConvert.SerializeObject(XValuesBarYearlyTraineeTrainedOverview),
                XAxisLabel = "Months",
                YAxisLabel = "Trainees Count",
                Datasets = traineeDataset
            };
    ModelPopUpViewModel getTrainerDashboard = new ModelPopUpViewModel() { ModelPopUpId = "GetTrainerDashboard", ModalContentId = "GetTrainerDashboardContentId" };
}
<div class="page-content">
    <div class="container-fluid">
        <div class="row justify-content-center g-4">
            <div class="col-md-6 col-lg-4">
                <a href="/dbtmdeviceregistrationdetails/list" class="text-decoration-none">
                    <div class="card report-card h-100">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col">
                                    <p class="text-dark mb-0 fw-semibold">Peak Fast Pro</p>
                                    <h3 class="m-0 text-danger">@Model.NumberOfKitPurchase Kit</h3>
                                </div>
                                <div class="col-auto">
                                    <div class="report-main-icon bg-light-alt">
                                        <i class="fas fa-toolbox"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a href="/dbtmgeneralbatchmaster/dbtmcalendar" class="text-decoration-none">
                    <div class="card report-card h-100">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col">
                                    <p class="text-dark mb-0 fw-semibold">Weekly Device Load</p>
                                    <h3 class="m-0 text-danger">@Model.WeeklyDeviceLoad %</h3>
                                </div>
                                <div class="col-auto">
                                    <div class="report-main-icon bg-light-alt">
                                        <i class="fas fa-upload"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a href="/generaltrainermaster/list" class="text-decoration-none">
                    <div class="card report-card h-100">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col">
                                    <p class="text-dark mb-0 fw-semibold">Trainer</p>
                                    <h3 class="m-0 text-danger">@Model.NumberOfTrainers</h3>
                                </div>
                                <div class="col-auto">
                                    <div class="report-main-icon bg-light-alt">
                                        <i class="fas fa-user-check"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a href="/dbtmtraineedetails/list" class="text-decoration-none">
                    <div class="card report-card h-100">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col">
                                    <p class="text-dark mb-0 fw-semibold">Trainees</p>
                                    <h3 class="m-0 text-danger">@Model.NumberOfTrainees</h3>
                                </div>
                                <div class="col-auto">
                                    <div class="report-main-icon bg-light-alt">
                                        <i class="fas fa-user-check"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a href="/generalbatchmaster/list" class="text-decoration-none">
                    <div class="card report-card h-100">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col">
                                    <p class="text-dark mb-0 fw-semibold">Batches</p>
                                    <h3 class="m-0 text-danger">@Model.NumberOfBatches</h3>
                                </div>
                                <div class="col-auto">
                                    <div class="report-main-icon bg-light-alt">
                                        <i class="fas fa-layer-group"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            @*  <div class="col-md-6 col-lg-4">
                <a href="/generalbatchmaster/list" class="text-decoration-none">
                    <div class="card report-card h-100">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col">
                                    <p class="text-dark mb-0 fw-semibold">Top Athlete</p>
                                    <h3 class="m-0 text-danger">@Model.TopAthletsName</h3>
                                </div>
                                <div class="col-auto">
                                    <div class="report-main-icon bg-light-alt">
                                        <i class="fas fa-trophy"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </a> 
            </div> *@
        </div>
        <div class="row mt-4">
            <div class="col-12">
                <div class="card h-100">
                    <div class="card-header">
                        <h4 class="card-title">Trainees Trained By Month</h4>
                    </div>
                    <div class="card-body">
                        @Html.Partial("~/Views/Shared/Charts/_BarChart.cshtml", traineeTrainedviewModel)
                    </div>
                </div>
            </div>
        </div>

        @if (Model.TrainersList != null && Model.TrainersList.Any())
        {
            <div class="row mt-4 g-4">
                @foreach (var trainer in Model.TrainersList)
                {
                    <div class="col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="text-center">
                                    <div class="position-relative" style="width: 110px; height: 110px; margin: 0 auto;">
                                        @if (!string.IsNullOrEmpty(trainer.PhotoMediaPath))
                                        {
                                            <img src="@trainer.PhotoMediaPath" alt="Trainer Image"
                                                 class="rounded-circle w-100 h-100" style="object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-soft-primary text-white w-100 h-100
                                                            d-flex align-items-center justify-content-center"
                                                 style="font-size: 36px; object-fit: cover;">
                                                @trainer.FirstName.Substring(0, 1)@trainer.LastName.Substring(0, 1)
                                            </div>
                                        }
                                    </div>
                                    <ul class="list-unstyled my-1 mt-2">
                                        <li><h5 class="mb-0">@trainer.FirstName @trainer.LastName</h5></li>
                                        <li><small class="text-muted">@trainer.EmployeeDesignation</small></li>
                                        @* <li><small class="text-muted">CertificateNo</small></li> *@
                                    </ul>
                                </div>
                                <ul class="list-unstyled personal-detail mb-0 text-center">
                                    <li class="mt-2"><b>Specialization:</b> @trainer.TrainerSpecialization</li>
                                    <li class="mt-2"><b>Date Of Joining:</b> @trainer.DateOfJoining.ToCoditechDateFormat()</li>
                                    <li class="mt-2"><b>Total Duration Completed:</b> @trainer.DurationWithUs</li>
                                    <li class="mt-2"><b>Number Of Trainees Linked:</b> @trainer.NumberOfTrainees</li>
                                    <li class="mt-2"><b>Number Of Batches:</b> @trainer.NumberOfBatchesCreated</li>
                                    <li class="mt-2"><b>Weekly Working Hrs:</b> @trainer.WeeklyWorkingHours</li>
                                    @*  <div class="text-center mt-3">
                                        <a href="#" class="btn btn-sm btn-soft-primary">More Detail</a>
                                    </div> *@
                                    <div class="text-center mt-3">
                                        <div class="mb-6">
                                            <button type="button"
                                                    class="btn btn-gradient-info"
                                                    onclick="DBTMDashboard.OpenTrainerDetail('@trainer.EmployeeDesignation',
                                   '@getTrainerDashboard.ModalContentId',
                                   '@Model.NumberOfDaysRecord',
                                   '@trainer.GeneralTrainerMasterId',
                                   '@trainer.AdminRoleMasterId',
                                   '@trainer.UserMasterId')">
                                                More Detail
                                            </button>
                                        </div>
                                    </div>

                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
@Html.Partial("~/Views/Shared/_ModelFullScreenPopUp.cshtml", getTrainerDashboard)
<script src="~/js/Coditech/DBTM/DBTMDashboard.js"></script>