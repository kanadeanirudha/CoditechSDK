            "January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        };

    int[] YValuesBarYearlyTraineeTrainedOverview = new int[12];
    int count = 0;

    BarChartViewModel traineeTrainedviewModel = new BarChartViewModel()
