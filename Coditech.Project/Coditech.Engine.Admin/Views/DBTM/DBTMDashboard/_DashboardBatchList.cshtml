@model GeneralBatchListViewModel
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="card-title mb-0">Batch List</h4>
        @if (Convert.ToBoolean(ViewBag.IsTrainer))
        {
            <a href="@Url.Action("Create", "DBTMGeneralBatchMaster",new{ custom4 = Model.Custom4, ispopup = "true", istrainer = ViewBag.IsTrainer == true ? "true" : ""})"
               class="btn btn-sm btn-soft-primary">
                <i class="fas fa-plus me-2"></i>Add Batch
            </a>
        }
    </div>
    <div class="card-body">
        @Html.Partial("~/Views/GeneralMaster/GeneralBatchMaster/_BatchTableList.cshtml", Model)
    </div>
</div>