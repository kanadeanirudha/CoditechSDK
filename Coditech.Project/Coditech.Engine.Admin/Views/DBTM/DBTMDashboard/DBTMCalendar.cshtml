@using Newtonsoft.Json
@model DBTMDashboardViewModel
<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8">
                <div id="calendar" style="margin-top:20px;"></div>
            </div>

            <div class="col-md-4">
                <div id="eventDetails" class="card p-3 shadow-sm">
                    <h5>Event Details</h5>
                    <p><strong>Title:</strong> <span id="detailTitle">--</span></p>
                    <p><strong>Description:</strong> <span id="detailDesc">--</span></p>
                    <p><strong>Start Batch:</strong> <span id="detailStart">--</span></p>
                    <p><strong>End Batch:</strong> <span id="detailEnd">--</span></p>
                </div>
            </div>
        </div>
    </div>
</div>
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
<style>
    #calendar {
        margin-top: 30px;
    }

    .fc .fc-day-today {
        background-color: #E8F1FF !important;
    }

        .fc .fc-day-today .fc-daygrid-day-number {
            background: #ff3b5c;
            color: #fff !important;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            line-height: 28px;
            text-align: center;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

    .fc .fc-col-header-cell.fc-day-today,
    .fc .fc-timegrid-col.fc-day-today {
        background-color: #E8F1FF !important;
    }

        .fc .fc-col-header-cell.fc-day-today .fc-col-header-cell-cushion {
            background: #ff3b5c;
            color: #fff !important;
            border-radius: 15px;
            padding: 4px 10px;
            font-weight: 600;
        }

    .fc .fc-toolbar-title {
        color: #243447 !important;
        background: rgba(255,255,255,.88);
        padding: 6px 16px;
        border-radius: 20px;
        font-weight: 700;
        box-shadow: 0 2px 8px rgba(0,0,0,.15);
        text-shadow: none;
    }

    .fc .fc-header-toolbar {
        margin-top: 10px !important;
        margin-bottom: 18px !important;
    }
    /* Time column background */
    .fc .fc-timegrid-axis,
    .fc .fc-timegrid-axis-frame,
    .fc .fc-timegrid-slot-label,
    .fc .fc-timegrid-slot-label-frame {
        background: #eef6ff !important;
        color: #333 !important;
    }

    /* Left top "all-day" cell */
    .fc .fc-timegrid-axis-cushion,
    .fc .fc-scrollgrid-section-header th:first-child {
        background: #f8f9fa !important;
    }

    /* Entire calendar grid */
    .fc .fc-scrollgrid,
    .fc .fc-scrollgrid td,
    .fc .fc-scrollgrid th {
        background-color: #fff !important;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
<script>
       document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: function (fetchInfo, successCallback, failureCallback) {

                var midDate = new Date(fetchInfo.start);
                    midDate.setDate(midDate.getDate() + 15);

                var year = midDate.getFullYear();
                var month = midDate.getMonth();

                var firstDay = new Date(year, month, 1);
                var lastDay = new Date(year, month + 1, 0);

                $.ajax({
                    url: '/DBTMGeneralBatchMaster/GetCalendarData',
                    data: {
                        startDate: firstDay.toISOString().split('T')[0],
                        endDate: lastDay.toISOString().split('T')[0]
                    },
                    success: function (data) {
                        successCallback(data);
                    },
                    error: function (xhr) {
                        if (xhr.status == 401 || xhr.status == 403) {
                            location.reload();
                        }
                        failureCallback();
                    }
                });
            },
                eventClick: function(info) {
                    document.getElementById('detailTitle').innerText = info.event.title;
                    document.getElementById('detailDesc').innerText = info.event.extendedProps.description;

                    let start = info.event.start;
                    let end = info.event.end;

                    document.getElementById('detailStart').innerText = start? start.toLocaleString('en-GB', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }): '';
                    document.getElementById('detailEnd').innerText = end? end.toLocaleString('en-GB', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }): '';
                }
        });
        calendar.render();
    });
</script>