		<div class="row">
			<ul class="nav nav-tabs" id="myTab" role="tablist">
				<li class="nav-item" role="presentation">
					<button class="nav-link active"
							id="batches-tab"
							data-bs-toggle="tab"
							data-bs-target="#batchesPane"
							data-method="LoadBatchesPartial"
							data-method-type="POST"
							type="button"
							role="tab">
						Batches
					</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link"
							id="assignment-tab"
							data-bs-toggle="tab"
							data-bs-target="#assignmentPane"
							data-method="LoadAssignmentPartial"
							data-method-type="POST"
							type="button"
							role="tab">
						Assignment
					</button>
				</li>
			</ul>

			<div class="tab-content p-3" id="myTabContent">
				@* ✅ Hidden fields for both parameters *@
				@Html.Hidden("dataTableModel.SelectedParameter1", Model.SelectedParameter1, new { id = "hdnSelectedParameter1" })
				@Html.Hidden("dataTableModel.SelectedParameter2", Model.SelectedParameter2, new { id = "hdnSelectedParameter2" })

				<div class="tab-pane fade show active" id="batchesPane" role="tabpanel">
					<iframe name="batchesFrame"
							src="/DBTMDashboard/LoadBatchesPartial"
							width="100%" height="800px" frameborder="0"></iframe>
				</div>
				<div class="tab-pane fade" id="assignmentPane" role="tabpanel">
					<iframe name="assignmentFrame"
							src="/DBTMDashboard/LoadAssignmentPartial"
							width="100%" height="800px" frameborder="0"></iframe>
				</div>
			</div>
		</div><!-- container -->
	</div>
@section scripts {
		<!-- end page content -->
		<script src="~/js/coditech/DBTM/DBTMDashboard.js"></script>
		<script>
			$(function () {
			  // Initialize datepicker (if needed)
			  $(".datepicker").datepicker({
				  format: "dd/mm/yyyy",
				  autoclose: true
			  });

			  // Handle tab switch and iframe loading
			  $('#myTab button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
				var $btn = $(this);
				var pane = $btn.data('bs-target'); // "#batchesPane" / "#assignmentPane"
				var method = $btn.data('method') || ($btn.attr('id') === 'batches-tab' ? 'LoadBatchesPartial' : 'LoadAssignmentPartial');
				var methodType = String($btn.data('method-type') || 'POST').toUpperCase();

				var $iframe = $(pane).find('iframe');
				if (!$iframe.length) return;

				// ensure iframe has a name so target works
				var iframeName = $iframe.attr('name');
				if (!iframeName) {
				  iframeName = 'iframe_' + Date.now();
				  $iframe.attr('name', iframeName);
				}

				// read values from hidden fields
				var selectedVal1 = $('#hdnSelectedParameter1').val() || '';
				var selectedVal2 = $('#hdnSelectedParameter2').val() || '';

				if (methodType === 'POST') {
				  // POST into iframe
				  var $form = $('<form>', {
					method: 'POST',
					action: '/DBTMDashboard/' + method,
					target: iframeName
				  });

				  // send both params for model binding
				  $form.append($('<input>', {
					type: 'hidden',
					name: 'dataTableModel.SelectedParameter1',
					value: selectedVal1
				  }));
				  $form.append($('<input>', {
					type: 'hidden',
					name: 'dataTableModel.SelectedParameter2',
					value: selectedVal2
				  }));

				  // add antiforgery token if present
				  var $aft = $('input[name="__RequestVerificationToken"]').first();
				  if ($aft.length) $form.append($aft.clone());

				  $('body').append($form);
				  $form.trigger('submit').remove();
				} else {
				  // GET fallback with querystring
				  var url = '/DBTMDashboard/' + method + '?' + $.param({
					'dataTableModel.SelectedParameter1': selectedVal1,
					'dataTableModel.SelectedParameter2': selectedVal2
				  });
				  $iframe.attr('src', url);
				}
			  });

			  // initial load for the first active tab
			  $('#myTab button.active').trigger('shown.bs.tab');
			});
		</script>

}
