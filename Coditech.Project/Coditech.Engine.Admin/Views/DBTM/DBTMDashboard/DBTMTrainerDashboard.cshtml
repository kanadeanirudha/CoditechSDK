@section scripts {
		<!-- end page content -->
		<script src="~/js/coditech/DBTM/DBTMDashboard.js"></script>
		<script>
			$(function () {
				$(".datepicker").datepicker({
					format: "dd/mm/yyyy",
					autoclose: true
				});
						loadTabContent($("#myTab .nav-link.active"));

			// When switching tabs
				$('#myTab .nav-link').on('shown.bs.tab', function (e) {
					loadTabContent($(e.target));
				});
			});


			function loadTabContent(tabButton) {
			var targetPaneId = tabButton.attr("data-bs-target");
			var targetPane = $(targetPaneId);
			var methodName = tabButton.data("method");

			targetPane.html("<div class='loading'>Loading...</div>");

			$.ajax({
				url: `/DBTMDashboard/${methodName}`,
				type: 'POST',
				success: function (data) {
					targetPane.html(data);
				},
				error: function (xhr) {
					targetPane.html("<div class='text-danger'>Failed to load data</div>");
					console.error("Error:", xhr.responseText);
				}
			});
			}
		</script>
