@section scripts {
		<!-- end page content -->
		<script src="~/js/coditech/DBTM/DBTMDashboard.js"></script>
		<script>
			$(function () {
				// Initialize datepicker
				$(".datepicker").datepicker({
					format: "dd/mm/yyyy",
					autoclose: true
				});

				// Handle tab shown event
				$('#myTab button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
						e.preventDefault();
					var $tabBtn = $(this);
					var method = $tabBtn.data('method');          // e.g. "LoadBatchesPartial"
					var methodType = $tabBtn.data('method-type'); // "GET" or "POST"
					var targetPaneId = $tabBtn.data('bs-target'); // e.g. "#batchesPane"

					// Find iframe inside target pane
					var $iframe = $(targetPaneId).find("iframe");

					if ($iframe.length) {
						if (methodType.toUpperCase() === "GET") {
							// Simply set iframe src for GET
							$iframe.attr("src", "/DBTMDashboard/" + method);
						} else if (methodType.toUpperCase() === "POST") {
							// For POST, simulate form submission into iframe
							var iframeName = $iframe.attr("name");
							if (!iframeName) {
								iframeName = "iframe_" + Date.now();
								$iframe.attr("name", iframeName);
							}

							var $form = $('<form>', {
								method: 'POST',
								action: "/DBTMDashboard/" + method,
								target: iframeName
							}).appendTo('body');

							$form.submit();
							$form.remove();
						}
					}
				});

				// Trigger the first active tab so iframe loads on page load
				$('#myTab button.active').trigger('shown.bs.tab');
			});
		</script>

