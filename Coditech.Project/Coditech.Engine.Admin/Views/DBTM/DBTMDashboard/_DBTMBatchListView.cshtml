@model GeneralBatchListViewModel
@{
	Layout = "~/Views/Shared/_LayoutCustomMobile.cshtml";
	ViewBag.Title = "All Batch Details List";
	string controllerName = ViewContext.RouteData.Values["controller"].ToString();
	string actionName = ViewContext.RouteData.Values["action"].ToString();
	string isPopUpView = Convert.ToString(ViewBag.IsDashboardPopup);
    if (string.IsNullOrEmpty(isPopUpView))
    {
        isPopUpView = Convert.ToString(TempData["IsMobileCustom"]);
    }
    bool isTrainer = Convert.ToBoolean(ViewBag.IsTrainer);
    if (!isTrainer)
    {
        UserModel userModel = SessionHelper.GetDataFromSession<UserModel>(AdminConstants.UserDataSession);
        isTrainer = userModel?.Custom1 == "DBTMTrainer" || userModel?.Custom1 == "DBTMCentreOwner";
    }
}

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-12">
            @Html.Partial("~/Views/GeneralMaster/GeneralBatchMaster/_List.cshtml", Model)
        </div>
    </div>
</div>

<script src="~/js/coditech/DBTM/DBTMBatch.js"></script>
<script src="~/js/coditech/General/GeneralBatchUser.js"></script>
<script>
    setTimeout(function () {
        var notif = document.getElementById("notificationDivId");
        if (notif && notif.style.display !== "none") {
            notif.style.transition = "opacity 0.5s ease";
            notif.style.opacity = "0";
            setTimeout(function () { notif.style.display = "none"; }, 500);
        }
    }, 4000);
</script>
<script>
    function resizeParentIframe() {
        if (window.parent && window.parent !== window && window.frameElement) {
            window.frameElement.style.height =
                document.documentElement.scrollHeight + "px";
        }
    }

    $(document).ready(function () {
        resizeParentIframe();

        setTimeout(resizeParentIframe, 300);
        setTimeout(resizeParentIframe, 800);
    });

    window.addEventListener("load", resizeParentIframe);
</script>