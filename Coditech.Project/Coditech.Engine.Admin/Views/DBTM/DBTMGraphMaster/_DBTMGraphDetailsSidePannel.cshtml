@using Coditech.Admin.Utilities;
@model Dictionary<string, string>
@{
    Layout = null;
    int dBTMGraphMasterId = Convert.ToInt32(Model?.FirstOrDefault(x => x.Key == "DBTMGraphMasterId").Value);
    string graphCode = Model?.FirstOrDefault(x => x.Key == "GraphCode").Value;
    string actionName = ViewContext.RouteData.Values["action"].ToString();
}
<div class="card sidebar-card">
    <div class="card-body">
        <div class="files-nav">
            <div class="nav flex-column nav-pills" id="files-tab" aria-orientation="vertical">
                <a class="nav-link"
                   href="@Url.Action("Edit", "DBTMGraphMaster", new {
                       graphCode = graphCode
                   })"
                   aria-selected="true">
                    <i class="ti-menu"></i><h5 class="m-0 ps-2">Graph Details</h5>
                </a>
                <a class="nav-link"
                   href="@Url.Action("GraphVerticalViewSequenceList", "DBTMGraphMaster", new {
                           SelectedParameter1 = dBTMGraphMasterId
                       })"
                   aria-selected="true">
                    <i class="fas fa-id-card-alt"></i><h5 class="m-0 ps-2">Graph Vertical View Sequence</h5>
                </a>
            </div>
        </div>
    </div>
</div>