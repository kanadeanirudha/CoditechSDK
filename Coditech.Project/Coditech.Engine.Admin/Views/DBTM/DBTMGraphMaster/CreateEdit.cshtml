@model DBTMGraphMasterViewModel
@{
    ViewBag.Title = Model.DBTMGraphMasterId > 0 ? "Update Graph" : "Add Graph";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string css = Model.DBTMGraphMasterId > 0 ? "col-lg-10" : "col-lg-12";
    DropdownViewModel graphTypeDropdown = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.GraphType.ToString(), DropdownName = "GraphType", DropdownSelectedValue = Model.GraphType, IsCustomDropdown = true };
    PageHeaderViewModel headerModel = new PageHeaderViewModel
    {
        Title = ViewBag.Title,
        SaveButtonText = GeneralResources.SaveButtonText,
        CancelUrl = Url.Action(AdminConstants.ActionRedirectToList, controllerName),
        CancelButtonText = GeneralResources.CancelButtonText,
        ControllerName = controllerName,
        ActionName = actionName,
        FormId = AdminConstants.FormId + controllerName,
    };
}
<!-- Page Content-->
<div class="page-content">
    <div class="container-fluid mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card-body">
                    @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                    {
                        @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
                        @Html.HiddenFor(m => m.DBTMGraphMasterId)
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    @Html.LabelFor(x => x.GraphCode, new { @class = "form-label required" })
                                    @if (Model.DBTMGraphMasterId > 0)
                                    {
                                        @Html.TextBoxFor(x => x.GraphCode, new { @class = "form-control", @readonly = "readonly" })
                                    }
                                    else
                                    {
                                        @Html.TextBoxFor(x => x.GraphCode, new { @class = "form-control" })
                                    }
                                    @Html.ValidationMessageFor(x => x.GraphCode)
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    @Html.LabelFor(x => x.GraphName, new { @class = "form-label required" })
                                    @Html.TextBoxFor(x => x.GraphName, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(x => x.GraphName)
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    @Html.LabelFor(x => x.XParameter, new { @class = "form-label required" })
                                    @Html.TextBoxFor(x => x.XParameter, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(x => x.XParameter)
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    @Html.LabelFor(x => x.YParameter, new { @class = "form-label required" })
                                    @Html.TextBoxFor(x => x.YParameter, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(x => x.YParameter)
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3 multiselect-dropdown">
                                    @Html.LabelFor(x => x.DBTMSelectedTestCode, new { @class = "form-label required" })
                                    @Html.ListBoxFor(x => x.DBTMSelectedTestCode, new SelectList(Model.DBTMTestList, "Value", "Text"), new { @class = "selectpicker form-control", multiple = "multiple", data_live_search = "true" })
                                    @Html.ValidationMessageFor(x => x.DBTMSelectedTestCode)
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    @Html.LabelFor(x => x.GraphType, new { @class = "form-label required" })
                                    @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", graphTypeDropdown)
                                    @Html.ValidationMessageFor(x => x.GraphType)
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

