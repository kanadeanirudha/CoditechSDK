@model DBTMGraphMasterViewModel
@{
    ViewBag.Title = Model.DBTMGraphMasterId > 0 ? "Update Graph" : "Add Graph";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string css = Model.DBTMGraphMasterId > 0 ? "col-lg-10" : "col-lg-12";
    DropdownViewModel graphTypeDropdown = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.GraphType.ToString(), DropdownName = "GraphType", DropdownSelectedValue = Model.GraphType, IsCustomDropdown = true };
    DropdownViewModel graphModeDropdown = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.GraphMode.ToString(), DropdownName = "GraphMode", DropdownSelectedValue = Model.GraphMode, IsCustomDropdown = true };
    PageHeaderViewModel headerModel = new PageHeaderViewModel
    {
        Title = ViewBag.Title,
        SaveButtonText = GeneralResources.SaveButtonText,
        CancelUrl = Url.Action(AdminConstants.ActionRedirectToList, controllerName),
        CancelButtonText = GeneralResources.CancelButtonText,
        ControllerName = controllerName,
        ActionName = actionName,
        FormId = AdminConstants.FormId + controllerName,
    };
}
<!-- Page Content-->
<div class="page-content">
    <div class="container-fluid mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                        {
                            @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
                            @Html.HiddenFor(m => m.DBTMGraphMasterId)
                            <div class="row">
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.GraphCode, new { @class = "form-label required" })
                                        @if (Model.DBTMGraphMasterId > 0)
                                        {
                                            @Html.TextBoxFor(x => x.GraphCode, new { @class = "form-control", @readonly = "readonly" })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(x => x.GraphCode, new { @class = "form-control", @onkeypress = "return CoditechCommon.AvoidSpacing()" })
                                        }
                                        @Html.ValidationMessageFor(x => x.GraphCode)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.GraphName, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.GraphName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.GraphName)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4 multiselect-dropdown">
                                        @Html.LabelFor(x => x.DBTMSelectedTestCode, new { @class = "form-label required" })
                                        @Html.ListBoxFor(x => x.DBTMSelectedTestCode, new SelectList(Model.DBTMTestList, "Value", "Text"), new { @class = "selectpicker form-control", multiple = "multiple", data_live_search = "true" })
                                        @Html.ValidationMessageFor(x => x.DBTMSelectedTestCode)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.GraphType, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", graphTypeDropdown)
                                        @Html.ValidationMessageFor(x => x.GraphType)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.GraphMode, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", graphModeDropdown)
                                        @Html.ValidationMessageFor(x => x.GraphMode)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.XParameter, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.XParameter, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.XParameter)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.XParameterBasedOn, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.XParameterBasedOn, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.XParameterBasedOn)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.YParameter, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.YParameter, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.YParameter)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.YParameterBasedOn, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.YParameterBasedOn, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.YParameterBasedOn)
                                    </div>
                                </div>

                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.XAxixLabel, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.XAxixLabel, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.XAxixLabel)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.YAxixLabel, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.YAxixLabel, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.YAxixLabel)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.GraphSize, new { @class = "form-label" })
                                        @Html.TextBoxFor(x => x.GraphSize, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.GraphSize)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.OrderBy, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.OrderBy, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.OrderBy)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.IsYParameterCalculated, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsYParameterCalculated, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.IsCalculateAverage, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsCalculateAverage, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="mb-4">
                                        @Html.LabelFor(x => x.IsActive, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

