@using Coditech.Admin.Utilities;
@model DBTMActivityListViewSequenceListViewModel

@{
    ViewBag.Title = "Activity List View Sequence List";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    Dictionary<string, string> keyValuePairs = new Dictionary<string, string>();
    keyValuePairs.Add("DBTMTestMasterId", Model.DBTMTestMasterId.ToString());
    ModelPopUpViewModel addSequenceNumber = new ModelPopUpViewModel() { ModelPopUpId = "AddSequenceNumberPopupId", ModalContentId = "AddSequenceNumberContentId" };
}

<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-2">
                @Html.Partial("~/Views/DBTM/DBTMTestMaster/_DBTMActivityDetailsSidePannel.cshtml", keyValuePairs)
            </div>
            <div class="col-10">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="card-title">Activity List View Sequence List</span>
                        <div class="d-flex gap-2">
                            <a href="/@controllerName/CreateActivityListViewSequence?dBTMTestMasterId=@Model.DBTMTestMasterId"
                               class="btn btn-sm btn-soft-primary" role="button">
                                <i class="fas fa-plus me-2"></i>Create Activity List View Sequence
                            </a>
                            <a href="javascript:void(0)"
                               class="btn btn-sm btn-soft-primary"
                               title="Update Sequence Number"
                               onclick="DBTMActivityListViewSequence.UpdateSequenceNumber('@addSequenceNumber.ModalContentId','@Model.DBTMTestMasterId','@Model.SequenceNumber')">
                                <i class="fas fa-sync me-2"></i>Update Sequence Number
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="DataTablesDivId" class="dataTables_wrapper dt-bootstrap5 no-footer">
                            @Html.Partial("~/Views/DBTM/DBTMTestMaster/ActivityListViewSequence/_ActivityListViewSequenceList.cshtml", Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal wrapper -->
<div class="modal fade" id="@addSequenceNumber.ModelPopUpId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="@addSequenceNumber.ModalContentId">
            <!-- AJAX content will be loaded here -->
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/coditech/DBTM/DBTMActivityListViewSequence.js"></script>
}