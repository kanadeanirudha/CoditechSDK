@using Coditech.Admin.Utilities;
@model DBTMActivityListViewSequenceListViewModel
@{
    Layout = null;
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
}
<div class="row">
    <div class="col-sm-12 table-responsive">
        <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap dataTable no-footer dtr-inline" style="border-collapse: collapse; border-spacing: 0px; width: 100%;" role="grid" aria-describedby="datatable_info">
            @Html.Partial("~/Views/Shared/Datatable/_DatatableColumns.cshtml", Model.PageListViewModel)
            @Html.HiddenFor(x => x.SelectedParameter1)
            <tbody>
                @if (Model?.DBTMActivityListViewSequenceList?.Count > 0)
                {
                    foreach (var item in Model?.DBTMActivityListViewSequenceList)
                    {
                        <tr>
                            <td>@item.ParameterCode</td>
                            <td>@item.ColumnName</td>
                            <td>@item.SequenceNumber</td>
                            <td>@item.Recursion</td>
                            <td>@item.ConsecutiveParameterCode</td>
                            <td>
                                @Html.Partial("~/Views/Shared/Datatable/_DatatableTrueFalse.cshtml", item.IsCalculatedParameter)
                            </td>
                            <td>
                                @Html.Partial("~/Views/Shared/Datatable/_DatatableTrueFalse.cshtml", item.IsCalculatedConsecutiveParameterCode)
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
