@model DBTMTestViewModel
@{
    ViewBag.Title = Model.DBTMTestMasterId > 0 ? "Update Activity" : "Add Activity";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string css = Model.DBTMTestMasterId > 0 ? "col-lg-10" : "col-lg-12";
    Dictionary<string, string> keyValuePairs = new Dictionary<string, string>();
    keyValuePairs.Add("DBTMTestMasterId", Model.DBTMTestMasterId.ToString());
    DropdownViewModel dBTMPerformanceMatrix = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.DBTMPerformanceMatrix.ToString(), DropdownName = "DBTMPerformanceMatrixId", DropdownSelectedValue = Convert.ToString(Model.DBTMPerformanceMatrixId), IsCustomDropdown = true, IsRequired = true };
    PageHeaderViewModel headerModel = new PageHeaderViewModel
            {
                Title = ViewBag.Title,
                SaveButtonText = GeneralResources.SaveButtonText,
                CancelUrl = Url.Action(AdminConstants.ActionRedirectToList, controllerName),
                CancelButtonText = GeneralResources.CancelButtonText,
                ControllerName = controllerName,
                ActionName = actionName,
                FormId = AdminConstants.FormId + controllerName,
            };
}
<!-- Page Content-->
<div class="page-content">
    <div class="container-fluid mt-5">
        <div class="row">
            @if (Model.DBTMTestMasterId > 0)
            {
                <div class="col-lg-2">
                    @Html.Partial("~/Views/DBTM/DBTMTestMaster/_DBTMActivityDetailsSidePannel.cshtml", keyValuePairs)
                </div>
            }
            <div class="@css">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                        {
                            @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
                            @Html.HiddenFor(m => m.DBTMTestMasterId)
                            @Html.HiddenFor(m => m.TestMediaId)
                            @Html.HiddenFor(m => m.TestMediaPath)
                            @Html.HiddenFor(m => m.ActivityProtocolImage)
                            @Html.HiddenFor(m => m.ActivityProtocolImagePath)
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.DBTMActivityCategoryId, new { @class = "form-label" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", new DropdownViewModel()
                               {
                                   DropdownType = DropdownCustomTypeEnum.DBTMActivityCategory.ToString(),
                                   DropdownName = "DBTMActivityCategoryId",
                                   DropdownSelectedValue = Model.DBTMActivityCategoryId.ToString(),
                                   IsRequired = false,
                                   IsCustomDropdown = true
                               })
                                        @Html.ValidationMessageFor(x => x.DBTMActivityCategoryId, null)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.TestName, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.TestName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.TestName)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.TestCode, new { @class = "form-label required" })
                                        @if (Model.DBTMTestMasterId > 0)
                                        {
                                            @Html.TextBoxFor(x => x.TestCode, new { @class = "form-control", @readonly = "readonly" })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(x => x.TestCode, new { @class = "form-control", @onkeypress = "return CoditechCommon.AvoidSpacing()" })
                                        }
                                        @Html.ValidationMessageFor(x => x.TestCode)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.TestOutputHigher, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml",
                                                 new DropdownViewModel()
                                    {
                                        DropdownType = "TestOutputType",
                                        DropdownName = "TestOutputHigher",
                                        DropdownSelectedValue = Model.TestOutputHigher,
                                        IsCustomDropdown = true,
                                        IsRequired = true
                                    })
                                        @Html.ValidationMessageFor(x => x.TestOutputHigher)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.TestResultBasedon, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", new DropdownViewModel()
                               {
                                   DropdownSelectedValue = Model.TestResultBasedon ?? string.Empty,
                                   DropdownName = "TestResultBasedon",
                                   GroupCode = DropdownCustomTypeEnum.TestResultBasedon.ToString(),
                                   IsTextValueSame = true,
                                   IsRequired = true,
                                   IsStringProperty = true
                               })
                                        @Html.ValidationMessageFor(x => x.TestResultBasedon)
                                    </div>
                                </div>
                                <div class="row">
                                    @if (Model.DBTMTestMasterId > 0)
                                    {
                                        <div class="col-lg-12">
                                            <div class="mb-3 multiselect-dropdown">
                                                @Html.LabelFor(x => x.DBTMSelectedGraph, new { @class = "form-label required" })
                                                @Html.ListBoxFor(x => x.DBTMSelectedGraph, new SelectList(Model.DBTMGraphMasterList, "Value", "Text"), new { @class = "selectpicker form-control", multiple = "multiple", data_live_search = "true" })
                                                @Html.ValidationMessageFor(x => x.DBTMSelectedGraph)
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.DBTMPerformanceMatrixId, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", dBTMPerformanceMatrix)
                                        @Html.ValidationMessageFor(x => x.DBTMPerformanceMatrixId)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.MinimunPairedDevice, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.MinimunPairedDevice, new { @class = "form-control", @onkeypress = "return CoditechCommon.ValidNumeric()", @maxlength = "50" })
                                        @Html.ValidationMessageFor(x => x.MinimunPairedDevice)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.LapDistance, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.LapDistance, new { @class = "form-control", @maxlength = "50" })
                                        @Html.ValidationMessageFor(x => x.LapDistance)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.IsLapDistanceChange, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsLapDistanceChange, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.IsMultiTest, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsMultiTest, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.IsStartDirection, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsStartDirection, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="mb-6">
                                        @Html.LabelFor(x => x.TestMediaId, new { @class = "form-label" })
                                        <input type="file" id="testUpload" class="form-control" />
                                        <img id="testPreview" src="#" alt="Uploaded Test" style="display:none;width:100px;height:100px;margin-top:10px;" />
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-6">
                                        @Html.LabelFor(x => x.ActivityProtocolImage, new { @class = "form-label" })
                                        <input type="file" id="activityProtocolUpload" class="form-control" />
                                        <img id="activityProtocolPreview" src="#" alt="Activity Protocol" style="display:none;width:100px;height:100px;margin-top:10px;" />
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.IsActive, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.TestInstructions, new { @class = "form-label" })
                                        @Html.Partial("~/Views/Shared/Control/_HTMLEditor.cshtml", new HTMLEditorViewModel()
                               {
                                   EditorName = "TestInstructions",
                                   EditorValue = Model.TestInstructions
                               })
                                        @Html.ValidationMessageFor(x => x.TestInstructions)
                                    </div>
                                </div>

                            </div>
                            <br />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
@section scripts {
    <script type="text/javascript">
        var testMediaPath = $('#TestMediaPath').val();
        if (!(testMediaPath === '' || testMediaPath === null)) {
        $('#testPreview').attr('src', $('#TestMediaPath').val()).show();
        }
        var activityProtocolImagePath = $('#ActivityProtocolImagePath').val();
        if (!(activityProtocolImagePath === '' || activityProtocolImagePath === null)) {
            $('#activityProtocolPreview').attr('src', activityProtocolImagePath).show();
        }

        $('#testUpload').change(function () {
        var formData = new FormData();
        var fileInput = $('#testUpload')[0];
        $("#notificationDivId").hide();
        if (fileInput.files.length > 0) {
        CoditechCommon.ShowLodder();
        formData.append('files', fileInput.files[0]);
        $.ajax({
        url: '/GeneralCommon/UploadMedia',  // Ensure this matches the route
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (response) {
        if (response.status == true || response.status == "true") {
        $('#testPreview').attr('src', response.imageUrl).show();
        $('input[name="TestMediaId"]').val(response.photoMediaId);
        }
        else {
        CoditechNotification.DisplayNotificationMessage(response.message, "error")
        }
        CoditechCommon.HideLodder();
        },
        error: function (jqXHR, textStatus, errorThrown) {
        console.error('Error uploading file:', textStatus, errorThrown);
        CoditechCommon.HideLodder();
        }
        });
        }
        });
        $('#activityProtocolUpload').change(function () {
            var formData = new FormData();
            var fileInput = $('#activityProtocolUpload')[0];
            $("#notificationDivId").hide();
            if (fileInput.files.length > 0) {
                CoditechCommon.ShowLodder();
                formData.append('files', fileInput.files[0]);
                $.ajax({
                    url: '/GeneralCommon/UploadMedia',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.status == true || response.status == "true") {
                            $('#activityProtocolPreview').attr('src', response.imageUrl).show();
                            $('input[name="ActivityProtocolImage"]').val(response.photoMediaId);
                        }
                        else {
                            CoditechNotification.DisplayNotificationMessage(response.message, "error" );
                        }
                        CoditechCommon.HideLodder();
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error('Error uploading activity protocol image:', textStatus, errorThrown );
                        CoditechCommon.HideLodder();
                    }
                });
            }
        });
    </script>
}
