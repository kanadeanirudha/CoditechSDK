@using Coditech.Admin.Utilities;
@model DBTMTestWisePerformanceStandardListViewModel
@{
    ViewBag.Title = "DBTM TestWise Performance Standard";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    Dictionary<string, string> keyValuePairs = new Dictionary<string, string>();
    keyValuePairs.Add("DBTMTestMasterId", Model.DBTMTestMasterId.ToString());
}
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-2">
                @Html.Partial("~/Views/DBTM/DBTMTestMaster/_DBTMActivityDetailsSidePannel.cshtml", keyValuePairs)
            </div>
            <div class="col-lg-10">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="card-title">
                            DBTM TestWise Performance Standard : @Model.TestName
                        </span>
                    </div>
                    <div class="card-body">
                        <div id="DataTablesDivId"
                             class="dataTables_wrapper dt-bootstrap5 no-footer">
                            @Html.Partial( "~/Views/DBTM/DBTMTestMaster/DBTMTestWisePerformanceStandard/_DBTMTestWisePerformanceStandardList.cshtml",  Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script src="~/js/coditech/DBTM/DBTMTestWisePerformanceStandard.js"></script>
}