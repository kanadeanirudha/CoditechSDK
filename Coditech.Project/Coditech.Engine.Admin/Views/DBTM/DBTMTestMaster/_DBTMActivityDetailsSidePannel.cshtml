@using Coditech.Admin.Utilities;
@model Dictionary<string, string>
@{
    Layout = null;
    int dBTMTestMasterId = Convert.ToInt16(Model?.FirstOrDefault(x => x.Key == "DBTMTestMasterId").Value);
    short dBTMTestwisePerformanceStandardCategoryId = Convert.ToInt16(Model?.FirstOrDefault(x => x.Key == "DBTMTestwisePerformanceStandardCategoryId").Value);
    string actionName = ViewContext.RouteData.Values["action"].ToString();
}
<div class="card sidebar-card">
    <div class="card-body">
        <div class="files-nav">
            <div class="nav flex-column nav-pills" id="files-tab" aria-orientation="vertical">
                <a class="nav-link"
                   href="@Url.Action("Edit", "DBTMTestMaster", new {
                       dBTMTestMasterId = dBTMTestMasterId,
                   })"
                   aria-selected="true">
                    <i class="ti-menu"></i><h5 class="m-0 ps-2">Activity Details</h5>
                </a>
                <a class="nav-link"
                   href="@Url.Action("ActivityListViewSequenceList", "DBTMTestMaster", new {
                           SelectedParameter1 = dBTMTestMasterId
                       })"
                   aria-selected="true">
                    <i class="fas fa-id-card-alt"></i><h5 class="m-0 ps-2">Activity List View Sequence</h5>
                </a>
                <a class="nav-link"
                   href="@Url.Action("ActivityVerticalViewSequenceList", "DBTMTestMaster", new {
                           SelectedParameter1 = dBTMTestMasterId
                       })"
                   aria-selected="true">
                    <i class="fas fa-id-card-alt"></i><h5 class="m-0 ps-2">Activity Vertical View Sequence</h5>
                </a>
                <a class="nav-link"
                   href="@Url.Action("DBTMTestWisePerformanceStandardList", "DBTMTestMaster", new {
                            dBTMTestMasterId = dBTMTestMasterId, dBTMTestwisePerformanceStandardCategoryId = dBTMTestwisePerformanceStandardCategoryId
                        })"
                   aria-selected="true">
                    <i class="fas fa-id-card-alt"></i><h5 class="m-0 ps-2">ActivityWise Performance Standard</h5>
                </a>
            </div>
        </div>
    </div>
</div>