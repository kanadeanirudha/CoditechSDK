@model DBTMTraineeAssignmentListViewModel
@{
    if (!string.IsNullOrEmpty(Model.Custom4))
    {
        Layout = "~/Views/Shared/_LayoutCustomMobile.cshtml";
    }
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string isPopUpView = Convert.ToString(ViewBag.IsDashboardPopup);
    if (string.IsNullOrEmpty(isPopUpView))
    {
        isPopUpView = Convert.ToString(TempData["IsMobileCustom"]);
    }
    if (string.IsNullOrEmpty(isPopUpView) && !string.IsNullOrEmpty(Model.Custom4) && Model.Custom4.Equals("Mobile View", StringComparison.OrdinalIgnoreCase))
    {
        isPopUpView = "true";
    }
    bool isTrainer = Convert.ToBoolean(ViewBag.IsTrainer);
    if (!string.IsNullOrEmpty(Model.Custom4))
    {
        controllerName = "DBTMTraineeAssignment";
    }
}
@if (!string.IsNullOrEmpty(isPopUpView))
{
    @Html.Raw("<div id='DataTablesDivId'><div class='card'><div class='card-header d-flex justify-content-between align-items-center'><h4 class='card-title mb-0'>Assignment List</h4>")
    <div>
        @if (isTrainer)
        {
            <a href="@Url.Action("Create", "DBTMTraineeAssignment", new { custom4 = (string.IsNullOrEmpty(isPopUpView) ? "" : Model.Custom4), ispopup = string.IsNullOrEmpty(isPopUpView) ? "" : "true", istrainer = isTrainer ? "true" : "" })" class="btn btn-sm btn-primary"><i class="fas fa-plus me-2"></i>Add Assignment</a>
        }
    </div>
    @Html.Raw("</div><div class='card-body'>")
}
@if (string.IsNullOrEmpty(isPopUpView))
{
    <div class="row">
        @Html.Partial("~/Views/Shared/Datatable/_DatatableShowResult.cshtml", Model.PageListViewModel.RecordPerPage)
        @Html.Partial("~/Views/Shared/Datatable/_DatatableSearchData.cshtml", Model.PageListViewModel.SearchBy)
    </div>

    controllerName = "DBTMTraineeAssignment";
}
<div class="row">
    <div class="col-sm-12 table-responsive">
        <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap dataTable no-footer dtr-inline" style="border-collapse: collapse; border-spacing: 0px; width: 100%;" role="grid" aria-describedby="datatable_info">
            @Html.Partial("~/Views/Shared/Datatable/_DatatableColumns.cshtml", Model.PageListViewModel)
            @Html.HiddenFor(x => x.SelectedParameter1)
            @Html.Hidden("SelectedParameter4", Convert.ToBoolean(ViewBag.IsReadOnlyDashboard) ? "true" : "")
            <tbody>
                @if (Model?.DBTMTraineeAssignmentList?.Count > 0)
                {
                    foreach (var item in Model?.DBTMTraineeAssignmentList)
                    {
                        <tr>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td><span class="badge badge-soft-info">@item.TestName</span></td>
                            <td>@item.AssignedBy</td>
                            <td>@item.AssignmentDate.ToCoditechDateFormat()</td>
                            <td>@item.AssignmentTime.ToCoditechTimeFormat()</td>
                            <td class="text-center">
                                @Html.Partial("~/Views/Shared/Datatable/_DatatableStatusData.cshtml", new DataTableStatusViewModel() { Key = item.TestStatus, Value = item.TestStatus })
                            </td>
                            @if (string.IsNullOrEmpty(isPopUpView) || isTrainer)
                            {
                                <td class="text-center">
                                    @if (string.Equals(item.TestStatus, "Pending"))
                                    {
                                        <a href="@Url.Action("GetDBTMTraineeAssignment", controllerName, new {
                                                dBTMTraineeAssignmentUserId = item.DBTMTraineeAssignmentUserId,
                                                SelectedCentreCode = Model.SelectedCentreCode,
                                                GeneralTrainerMasterId = Model.SelectedParameter1,
                                                custom4 = (string.IsNullOrEmpty(isPopUpView) ? "" : Model.Custom4),
                                                ispopup = string.IsNullOrEmpty(isPopUpView) ? "" : "true",
                                                istrainer = isTrainer ? "true" : ""
                                            })"
                                           title="Update" 
                                           class="btn btn-sm btn-soft-success btn-circle me-2">
                                             <i class="fas fa-edit"> </i>
                                       </a>

                                        <span class="m-2">|</span>
                                       <a href="@Url.Action("SendAssignmentReminder", controllerName, new { 
                                                dBTMTraineeAssignmentId = item.DBTMTraineeAssignmentId,
                                                dBTMTraineeAssignmentUserId = item.DBTMTraineeAssignmentUserId,
                                                custom4 = string.IsNullOrEmpty(isPopUpView) ? Model.Custom4 : "Mobile View"
                                             })"
                                           title="Send Reminder"
                                           class="btn btn-sm btn-soft-danger btn-circle">
                                            <i class="fas fa-exclamation-triangle"></i>
                                        </a>
                                           <span class="m-2">|</span>
                                        <!-- Delete Button -->
                                        <a href="#" title="Delete" class="btn btn-sm btn-soft-danger btn-circle" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal_@item.DBTMTraineeAssignmentUserId">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="confirmDeleteModal_@item.DBTMTraineeAssignmentUserId" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Delete</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body" style="text-align: left;">
                                                        <span style="font-size: 24px; margin-right: 10px;"><i class="fas fa-exclamation-triangle text-danger"></i></span>
                                                        <span style="font-size: 16px;">Are you sure you want to delete this record?</span>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <!-- Delete action with selectedCentreCode parameter -->
                                                       <a href="@Url.Action("Delete", controllerName, new { 
                                                                dBTMTraineeAssignmentUserId = item.DBTMTraineeAssignmentUserId,
                                                                selectedCentreCode = Model.SelectedCentreCode,
                                                                SelectedParameter1 = Model.SelectedParameter1,
                                                                custom4 = string.IsNullOrEmpty(isPopUpView) ? Model.Custom4 : "Mobile View"
                                                             })"
                                                           class="btn btn-outline-danger">
                                                            Delete
                                                        </a>
                                                     </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                           <a href="@Url.Action("GetAssignmentResult", controllerName, new { 
                                                    SelectedParameter1 = item.DBTMDeviceDataId,
                                                    SelectedParameter2 = Model.SelectedParameter2,
                                                    SelectedCentreCode = Model.SelectedCentreCode,
                                                    custom4 = string.IsNullOrEmpty(isPopUpView) ? Model.Custom4 : "Mobile View"
                                                 })"
                                               title="View Assignment Result" 
                                               class="btn btn-sm btn-soft-warning btn-circle">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                    }
                                </td>
                            }

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@Html.Partial("~/Views/Shared/Datatable/_DatatablePagination.cshtml", Model.PageListViewModel)

@if (!string.IsNullOrEmpty(isPopUpView))
{
    @Html.Raw("</div></div></div>")
}
