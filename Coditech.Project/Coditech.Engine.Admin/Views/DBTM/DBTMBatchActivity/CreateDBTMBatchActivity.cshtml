@model DBTMBatchActivityViewModel
@{
    ViewBag.Title = "Create DBTM Batch Activity";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    PageHeaderViewModel headerModel = new PageHeaderViewModel
    {
        Title = Model.BatchName,
        SaveButtonText = GeneralResources.SaveButtonText,
        CancelUrl = Url.Action("GetDBTMBatchActivityList", controllerName, new { SelectedParameter1 = Model.GeneralBatchMasterId }),
        CancelButtonText = GeneralResources.CancelButtonText,
        ControllerName = controllerName,
        ActionName = actionName,
        FormId = AdminConstants.FormId + controllerName,
    };
}
<!-- Page Content-->

<div class="page-content">
    <div class="container-fluid mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                        {
                            @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
                            @Html.HiddenFor(m => m.DBTMBatchActivityId)
                            @Html.HiddenFor(x => x.GeneralBatchMasterId)
                            @Html.HiddenFor(m => m.BatchName)
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.DBTMTestMasterId, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", new DropdownViewModel()
                                        {
                                            DropdownType = DropdownCustomTypeEnum.DBTMBatchActivity.ToString(),
                                                                        DropdownName = "DBTMTestMasterId",
                                                                        DropdownSelectedValue = Model.DBTMTestMasterId.ToString(),
                                                                        Parameter = $"{Model.GeneralBatchMasterId}~false",
                                                                        IsCustomDropdown = true
                                                                        })
                                    @Html.ValidationMessageFor(x => x.DBTMTestMasterId)
                                </div>
                            </div>
                        </div>
                                                }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


