@using System.Data
@model LiveTestResultDashboardViewModel
@{
    Layout = null;
    ViewBag.Title = "Live Test Result";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="30" />
    <title>@ViewBag.Title</title>

    <!-- App css -->
    <link href="~/css/layout/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/layout/app.min.css" rel="stylesheet" type="text/css">
    <link href="~/css/layout/site.css" rel="stylesheet" />

    <style>
        .table-header-light {
            background-color: #f8f9fa;
            color: #212529;
        }

        .card-title-black {
            color: #000 !important;
        }
    </style>
</head>
<body>
    <div class="page-content">
        <div class="container-fluid">
            <!-- Page-Title -->
            <div class="row">
                <div class="col-sm-12">
                    <div class="page-title-box">
                        <div class="row">
                            <div class="col"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container-fluid mt-4">
                <h2 class="text-center text-primary fw-bold mb-4">Live Test Results</h2>

                <!-- Row 1 -->
                <div class="row g-4 justify-content-center">
                    @if (Model?.DataTableList?.Count > 0)
                    {
                        @foreach (DataTable dataTable in Model?.DataTableList)
                        {
                            @foreach (DataRow row in dataTable.Rows)
                            {
                                <div class="col-xl-3 col-lg-3 col-md-6 mb-4">
                                    <div class="card shadow h-100">
                                        <div class="card-body">

                                            @foreach (DataColumn col in dataTable.Columns)
                                            {
                                                <div class="mb-2">

                                                    <strong>@col.ColumnName :</strong>

                                                    @{
                                                        var value = row[col]?.ToString()?.Split('~');
                                                        var performanceGrade = value.Length > 3 ? value[3] : "";
                                                    }

                                                    @value[0]

                                                    @if (performanceGrade == "5")
                                                    {
                                                        <span>🥇🥇🥇🥇🥇</span>
                                                    }
                                                    else if (performanceGrade == "4")
                                                    {
                                                        <span>🥈🥈🥈🥈</span>
                                                    }
                                                    else if (performanceGrade == "3")
                                                    {
                                                        <span>🥉🥉🥉</span>
                                                    }
                                                    else if (performanceGrade == "1")
                                                    {
                                                        <span>🏅</span>
                                                    }

                                                </div>
                                            }

                                        </div>
                                    </div>
                                </div>
                            }                          
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</body>
</html>
