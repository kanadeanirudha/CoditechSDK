@using Coditech.Admin.ViewModel
@model DBTMNewRegistrationViewModel
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Trainer Registration";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
}
<div class="card-body p-0 auth-content" style="max-height: 550px; overflow-y: auto;">
    <ul class="nav-border nav nav-pills" role="tablist">
        <li class="nav-item">
            <a class="nav-link active fw-semibold" href="/dbtmnewregistration/traineeRegistration" role="tab">Trainee Registration</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="/dbtmnewregistration/trainerRegistration" role="tab">Trainer Registration</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="/dbtmnewregistration/centreregistration" role="tab">Device/Centre Registration</a>
        </li>
        <li class="nav-item">
            @* <a class="nav-link fw-semibold" href="/dbtmnewregistration/individualRegistration" role="tab">Individual Registration</a> *@
        </li>
    </ul>
    <!-- Tab panes -->
    <div class="tab-content">
        <div class="tab-pane active p-3" id="LogIn_Tab" role="tabpanel">
            @using (Html.BeginForm("TraineeRegistration", controllerName, FormMethod.Post))
            {
                bool trainersLoaded = false;
                @if (!string.IsNullOrEmpty(Model.JoiningCode) && Model.AllTrainerList != null && Model.AllTrainerList.Any())
                {
                    trainersLoaded = true;
                }
                string buttonText = trainersLoaded ? "Change" : "Join";
                string clickHandler = trainersLoaded ? "ChangeJoinningCode()" : "GetTrainerDropdownByJoiningCode()";
                string labelText = trainersLoaded ? "Loaded" : " ";          
                <div class="row">
                    @if (!string.IsNullOrEmpty(Model.JoiningCode) && Model.AllTrainerList != null && Model.AllTrainerList.Any())
                    {
                        <div class="col-lg-4">
                            <div class="mb-3">
                                <label class="form-label required" for="JoiningCode">Joining Code</label>
                                @Html.TextBoxFor(x => x.JoiningCode, new { id = "JoiningCode", @class = "form-control", onkeypress = "return CoditechCommon.AvoidSpacing()", @readonly = "readonly" })
                                @Html.ValidationMessageFor(x => x.JoiningCode)
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-lg-4">
                            <div class="mb-3">
                                <label class="form-label required" for="JoiningCode">Joining Code</label>
                                @Html.TextBoxFor(x => x.JoiningCode, new { id = "JoiningCode", @class = "form-control", onkeypress = "return CoditechCommon.AvoidSpacing()" })
                                @Html.ValidationMessageFor(x => x.JoiningCode)
                            </div>
                        </div>
                    }
                    <div class="col-lg-2 d-flex align-items-end">
                        <div class="mb-3 w-100">
                            <button type="button" class="btn btn-warning w-100" onclick="@clickHandler">
                                @buttonText
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.JoiningCode) && Model.AllTrainerList != null && Model.AllTrainerList.Any())
                    {
                        <div class="col-lg-6">
                            <div class="mb-3 multiselect-dropdown">

                                @Html.LabelFor(x => x.SelectedTrainer, new { @class = "form-label required" })

                                @Html.ListBoxFor(m => m.SelectedTrainer,
                                    new SelectList(Model.AllTrainerList, "Value", "Text"),
                                    new
                                    {
                                        @class = "selectpicker form-control",
                                        multiple = "multiple",
                                        data_live_search = "true",
                                        disabled = "disabled"   // makes dropdown readonly
                                    })

                                @Html.ValidationMessageFor(x => x.SelectedTrainer)

                                <!-- Hidden fields to post selected values -->
                                @if (Model.SelectedTrainer != null)
                                {
                                    foreach (var trainer in Model.SelectedTrainer)
                                    {
                                        <input type="hidden" name="SelectedTrainer" value="@trainer" />
                                    }
                                }

                            </div>
                        </div>
                    }
                </div>
                @Html.AntiForgeryToken()
                @Html.Partial("~/Views/Shared/DBTMRegistration/_DBTMTraineeRegistration.cshtml", Model)
                <div class="form-group row my-3">
                    <div class="col-sm-6">
                        <div class="custom-control custom-switch switch-success">
                            <div class="col-sm-6 text-end">
                                @if (!string.IsNullOrEmpty(Model.JoiningCode) && Model.AllTrainerList != null && Model.AllTrainerList.Any())
                                {
                                    <button class="btn btn-primary w-100 waves-effect waves-light">Register<i class="fas fa-sign-in-alt ms-1"></i></button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 text-end">
                        <a href="/user/login" class="theme-color ms-2"><i class="dripicons-lock"></i>Log in</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script src="~/js/coditech/Common/CoditechCommon.js"></script>
@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
                   $(".view-password").click(function () {
            $(this).toggleClass("fa-eye fa-eye-slash");

            // Sirf isi icon ke sath wala input change hoga
            var inputAttribute = $(this).siblings(".password-input");

            if (inputAttribute.attr("type") === "password") {
                inputAttribute.attr("type", "text");
            } else {
                inputAttribute.attr("type", "password");
            }
        });

            $("#DateOfBirth").datepicker({
                changeMonth: true,
                changeYear: true,
                yearRange: "-100:+0",
                dateFormat: "yy-mm-dd",
                autoSize: true,
                gotoCurrent: true,
                showButtonPanel: true,
                closeText: 'Clear',
                minDate: "-80Y",
                maxDate: new Date(),
                onClose: function () {
                    if ($(document.activeElement).hasClass("ui-datepicker-close")) {
                        $(this).val('');
                    }
                }
            });
        });
        function GetTrainerDropdownByJoiningCode() {
            debugger;
            const joiningCode = $("#JoiningCode").val();
            if (joiningCode.length >= 5) {
                CoditechCommon.ShowLodder();
                const url = `/DBTMNewRegistration/TraineeRegistration?joiningCode=${encodeURIComponent(joiningCode)}`;
                window.location.href = url;
            }
            else {
                if (joiningCode === '') {
                    CoditechNotification.DisplayNotificationMessage('Joining code is required.', 'error');
                }
                else {
                    CoditechNotification.DisplayNotificationMessage('Joining code must be at least 5 characters.', 'error');
                }
            }
        }
                     function ChangeJoinningCode() {
            if (confirm("Are you sure?")) {
                alert("Redirecting...");
                window.location.href = "/DBTMNewRegistration/TraineeRegistration";
            }
        }
    </script>
}
