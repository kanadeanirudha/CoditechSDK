@using System.Linq
@model DBTMActivityListViewSequenceListViewModel
@{
    Layout = null;
    var index = 1;
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    ModelPopUpViewModel activityPopup = new ModelPopUpViewModel() { ModelPopUpId = "ActivityListViewPopupId", ModalContentId = "ActivityListViewPopupContent" };
}

<div class="accordion-item mb-3 border-0 shadow-sm"
     style="border-radius:8px; overflow:hidden;">
    @foreach (var testGroup in Model.DBTMActivityListViewSequenceList.GroupBy(x => x.TestName))
    {
        var collapseId = $"collapseActivity{index}";
        var headingId = $"headingActivity{index}";
        <div class="accordion-item mb-2">
            <h2 class="accordion-header" id="@headingId">
                <button class="accordion-button fw-bold @(index > 1 ? "collapsed" : "")"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#@collapseId"
                        aria-expanded="@(index == 1 ? "true" : "false")"
                        aria-controls="@collapseId">
                    @testGroup.Key
                </button>
            </h2>

            <div id="@collapseId"
                 class="accordion-collapse collapse @(index == 1 ? "show" : "")"
                 aria-labelledby="@headingId"
                 data-bs-parent="#activityAccordion">

                <div class="accordion-body p-2">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-sm align-middle" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th>Column Display Name</th>
                                    <th>Display On(Mobile App or Web App)</th>
                                    <th>Is Column Cell Bold</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in testGroup)
                                {
                                    <tr id="row_@item.DBTMTestParameterListViewSequenceId">
                                        <!-- Column Name -->
                                        <td style="vertical-align:middle;">
                                            <span class="view-mode">
                                                @item.ColumnDisplayName
                                            </span>
                                            <input type="text"
                                                   class="form-control form-control-sm edit-mode"
                                                   value="@item.ColumnDisplayName"
                                                   style="display:none;" readonly />
                                        </td>
                                        <!-- Display On -->
                                        <td style="vertical-align:middle;">
                                            <span class="view-mode display-text">
                                                @System.Text.RegularExpressions.Regex.Replace(item.DisplayOn ?? "", "(\\B[A-Z])", " $1")
                                            </span>
                                            <select class="form-select form-select-sm edit-mode display-dropdown" style="display:none;">
                                                @if (item.DisplayOn == "Both")
                                                {
                                                    <option value="Both" selected>Both</option>
                                                }
                                                else
                                                {
                                                    <option value="Both">Both</option>
                                                }
                                                @if (item.DisplayOn == "OnlyMobileApp")
                                                {
                                                    <option value="OnlyMobileApp" selected>Only Mobile App</option>
                                                }
                                                else
                                                {
                                                    <option value="OnlyMobileApp">Only Mobile App</option>
                                                }
                                                @if (item.DisplayOn == "OnlyWeb")
                                                {
                                                    <option value="OnlyWeb" selected>Only Web App</option>
                                                }
                                                else
                                                {
                                                    <option value="OnlyWeb">Only Web App</option>
                                                }
                                                @if (item.DisplayOn == "None")
                                                {
                                                    <option value="None" selected>None</option>
                                                }
                                                else
                                                {
                                                    <option value="None">None</option>
                                                }
                                            </select>
                                        </td>
                                        <!-- Bold -->
                                        <td class="text-center" style="vertical-align:middle;">
                                            <span class="view-mode bold-text">
                                                @if (item.IsColumnCellBold)
                                                {
                                                    <span class="badge bg-success"><i class="fas fa-check"></i></span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger"><i class="fas fa-times"></i></span>
                                                }
                                            </span>
                                            <input type="checkbox" class="form-check-input edit-mode bold-checkbox"
                                            @(item.IsColumnCellBold ? "checked" : "") style="display:none;" />
                                        </td>
                                        <!-- Action -->
                                        <td class="text-center" style="vertical-align:middle;">
                                            <!-- Edit -->
                                            <button type="button"
                                                    class="btn btn-sm btn-soft-success btn-circle edit-btn"
                                                    onclick="DBTMActivityListViewSequence.EditRow(@item.DBTMTestParameterListViewSequenceId)"
                                                    style="padding:6px 10px;">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <!-- Save -->
                                            <button type="button"
                                                    class="btn btn-sm btn-soft-primary btn-circle save-btn"
                                                    onclick="DBTMActivityListViewSequence.SaveRow(@item.DBTMTestParameterListViewSequenceId,'@Model.CentreCode')"
                                                    style="display:none;padding:6px 10px;">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <!-- Cancel -->
                                            <button type="button"
                                                    class="btn btn-sm btn-soft-danger btn-circle cancel-btn"
                                                    onclick="DBTMActivityListViewSequence.CancelRow(@item.DBTMTestParameterListViewSequenceId)"
                                                    style="display:none;padding:6px 10px;">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        index++;
    }
    @if (!Model.DBTMActivityListViewSequenceList.Any())
    {
        <div class="text-danger fw-bold text-center">No Data Found</div>
    }
</div>
<style>
        #activityAccordion .accordion-item:first-child {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        #activityAccordion .accordion-item:first-child .accordion-header {
            margin-top: 0 !important;
        }

        #activityAccordion .accordion-item:first-child .accordion-button {
            margin-top: 0 !important;
            padding-top: 6px !important;
        }
</style>
@Html.Partial("~/Views/Shared/_ModelPopUp.cshtml", activityPopup)
<script src="~/js/coditech/DBTM/DBTMActivityListViewSequence.js"></script>
