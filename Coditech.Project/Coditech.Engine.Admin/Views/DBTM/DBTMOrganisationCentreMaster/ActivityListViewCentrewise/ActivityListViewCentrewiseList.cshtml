@using Coditech.Admin.Utilities;
@model DBTMActivityListViewSequenceListViewModel
@{
    ViewBag.Title = "Activity List View Sequence List";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    ModelPopUpViewModel addSequenceNumber = new ModelPopUpViewModel() { ModelPopUpId = "AddSequenceNumberPopupId", ModalContentId = "AddSequenceNumberContentId" };
}
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-2">
                @Html.Partial("~/Views/Organisation/OrganisationCentre/_OrganisationCentreSidePannel.cshtml", Model.OrganisationCentreMasterId.ToString())
            </div>
            <div class="col-10">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="card-title">Activity List View Sequence List</span>                      
                    </div>
                    <div class="card-body">
                        <div id="DataTablesDivId" class="dataTables_wrapper dt-bootstrap5 no-footer">
                            @Html.Partial("~/Views/DBTM/DBTMOrganisationCentreMaster/ActivityListViewCentrewise/_ActivityListViewCentrewiseList.cshtml", Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal wrapper -->
<div class="modal fade" id="@addSequenceNumber.ModelPopUpId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="@addSequenceNumber.ModalContentId">
            <!-- AJAX content will be loaded here -->
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/coditech/DBTM/DBTMActivityListViewSequence.js"></script>
}