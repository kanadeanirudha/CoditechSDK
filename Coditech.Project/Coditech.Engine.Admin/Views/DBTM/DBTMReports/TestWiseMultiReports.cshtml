@model DBTMReportsListViewModel
@{
    ViewBag.Title = "Activitywise Multiple Reports";
    DropdownViewModel testDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.DBTMTest.ToString(),
                DropdownName = "DBTMTestMasterId",
                DropdownSelectedValue = Model.DBTMTestMasterId.ToString(),
                IsCustomDropdown = true,
                ChangeEvent = "DBTMReports.GetDBTMTestWiseMultiReports()",
            };
    DropdownViewModel traineeDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.DBTMTraineeList.ToString(),
                DropdownName = "DBTMTraineeDetailId",
                DropdownSelectedValue = Model.DBTMTraineeDetailId.ToString(),
                ChangeEvent = "DBTMReports.GetDBTMTestWiseMultiReports()",
                IsCustomDropdown = true,
            };
    ModelPopUpViewModel activityPopup = new ModelPopUpViewModel()
            {
                ModelPopUpId = "DBTMActivityDetailPopupId",
                ModalContentId = "DBTMActivityDetailPopupContentId"
            };

    string url = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<!-- Page Content-->
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="card-title">Activity Reports</span>
                        <div class="d-flex align-items-center">
                            <!-- Toggle Switch -->
                            <div class="form-check form-switch me-3">
                                <div class="switch-field">
                                    <input type="radio" id="radio-list" name="switch-tile-list" value="list" checked onclick="window.open('@($"{url}/dbtmreports/testwisereports")', '_self');" />
                                    <label for="radio-list">List</label>
                                    <input type="radio" id="radio-tile" name="switch-tile-list" value="tile" onclick="window.open('@($"{url}/dbtmreports/TestWiseGraphReports")', '_self');" />
                                    <label for="radio-tile">Graph</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-1">
                                <label class="form-label" for="CustomDropdownSelectedValue1">Activity List</label>
                            </div>
                            <div class="col-md-7">
                                <div class="mb-3 multiselect-dropdown">
                                    @Html.ListBoxFor(x => x.CustomDropdownSelectedValue1, new SelectList(Model.CustomDropdownList1, "Value", "Text"), new { @class = "selectpicker form-control", id = "DBTMTestMasterId", multiple = "multiple", data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-1">
                                <label>Trainee List</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", traineeDropdown)
                            </div>
                            <div class="col-md-1">
                                @Html.LabelFor(x => x.FromDate, new { @class = "form-label" })
                            </div>
                            <div class="col-md-2">
                                @Html.TextBoxFor(x => x.FromDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-1">
                                @Html.LabelFor(x => x.ToDate, new { @class = "form-label" })
                            </div>
                            <div class="col-md-2">
                                @Html.TextBoxFor(x => x.ToDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readonly" })
                                <small id="toDateError" style="color:red; display:none;"> Please select From Date first </small>
                            </div>
                            <div class="col-md-2 align-items-end">
                                <input type="button" class="btn btn-success me-3" value="Show" id="ShowDataId" onclick="DBTMReports.GetDBTMTestWiseMultiReports()" />
                                <a id="DownloadBtn" class="btn btn-success" onclick="DBTMReports.DownloadExcelReport()">
                                    <i class="fa fa-download"></i> Download
                                </a>
                            </div>
                        </div>
                        <div id="DBTMTestWiseMultiReportsDivId" class="mt-3">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Activity Detail Popup -->
<div class="modal fade" id="@activityPopup.ModelPopUpId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="@activityPopup.ModalContentId">
            <!-- AJAX content loads here -->
        </div>
    </div>
</div>
<iframe id="hiddenDownloader" style="display:none;"></iframe>
<style>
    .switch-field {
        display: flex;
        overflow: hidden;
    }

        .switch-field input {
            position: absolute !important;
            clip: rect(0, 0, 0, 0);
            height: 1px;
            width: 1px;
            border: 0;
            overflow: hidden;
        }

        .switch-field label {
            background-color: #e4e4e4;
            color: rgba(0, 0, 0, 0.6);
            font-size: 14px;
            line-height: 1;
            text-align: center;
            padding: 8px 16px;
            margin-right: -1px;
            border: 1px solid rgba(0, 0, 0, 0.2);
            transition: all 0.2s ease-in-out;
            cursor: pointer;
        }

            .switch-field label:hover {
                background-color: rgba(255, 184, 34, 0.6);
                color: #000;
            }

        .switch-field input:checked + label {
            background-color: rgb(255, 184, 34);
            color: #000;
            font-weight: 600;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
            border-color: rgb(230, 165, 30);
        }

        .switch-field label:active {
            background-color: rgb(230, 165, 30);
            color: #fff;
        }

        .switch-field label:first-of-type {
            border-radius: 4px 0 0 4px;
        }

        .switch-field label:last-of-type {
            border-radius: 0 4px 4px 0;
        }

    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 15px;
    }

    .dataTables_wrapper .dataTables_paginate {
        margin-top: 8px;
        margin-bottom: 0;
        text-align: right;
    }

    .table-responsive {
        padding-bottom: 4px !important;
        box-sizing: border-box;
    }

    .activity-date a {
        background-color: #198754 !important;
        color: #fff !important;
        font-weight: 600;
    }
</style>
<script src="~/js/coditech/DBTM/DBTMReports.js"></script>
@section scripts {
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            DBTMReports.LoadActivityPerformedDates(false);
            $("#DBTMTestMasterId").on("changed.bs.select", function () {
               DBTMReports.LoadActivityPerformedDates(false);
            });

            $("#DBTMTraineeDetailId").change(function () {
               DBTMReports.LoadActivityPerformedDates(false);
            });
        });
    </script>
    <script type="text/javascript">
        var isFromDateSelected = false;
        function formatDate(d) {
            return d.getFullYear() + "-"
                + String(d.getMonth() + 1).padStart(2, "0") + "-"
                + String(d.getDate()).padStart(2, "0");
        }
        function updateToDate() {
            var fromDate = $("#FromDate").datepicker("getDate");
            if (fromDate) {
                $("#ToDate").datepicker("option", "minDate", fromDate);

                var toDate = $("#ToDate").datepicker("getDate");
                if (toDate && toDate < fromDate) {
                    $("#ToDate").datepicker("setDate", fromDate);
                }
            }
        }

        $(document).ready(function () {
            var dateFormat = "@AdminGeneralHelper.DateFormatForCalendar()";
            // FromDate
            $("#FromDate").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: dateFormat,
                language: "en",
                autoSize: true,
                gotoCurrent: true,
                clearBtn: true,
                showButtonPanel: true,
                closeText: 'Clear',
                maxDate: new Date(),
                beforeShowDay: function (date) {
            if (!activityPerformedDates || activityPerformedDates.length === 0) {
                return [true, "", ""]; 
            }

            var d = formatDate(date);
            if (activityPerformedDates.includes(d)) {
                return [true, "activity-date", "Activity Performed"];
            }
            return [true, "", ""];
        },
                onSelect: function () {
                     isFromDateSelected = true;
                     updateToDate();
                     $("#toDateError").hide();
                     updateToDate();
                }
            });

            // ToDate
            $("#ToDate").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: dateFormat,
                language: "en",
                autoSize: true,
                gotoCurrent: true,
                clearBtn: true,
                showButtonPanel: true,
                closeText: 'Clear',
                maxDate: new Date(),
                beforeShowDay: function (date) {
            if (!activityPerformedDates || activityPerformedDates.length === 0) {
                return [true, "", ""];   
            }

            var d = formatDate(date);
            if (activityPerformedDates.includes(d)) {
                return [true, "activity-date", "Activity Performed"];
            }
            return [true, "", ""];
        },
                onSelect: function () {
                    updateToDate();
                }
            });
            $("#ToDate").on("mousedown", function (e) {
            if (!isFromDateSelected) {
                $("#toDateError").show();
                e.preventDefault();
            } else {
                $("#toDateError").hide();
            }
            });
            updateToDate();
        });
    </script>
    <script>
        $.fn.dataTable.ext.errMode = 'none';
            $(document).on('ajaxComplete', function () {
                $("table[id^='datatable-']").each(function () {
                    if ($.fn.DataTable.isDataTable(this)) {
                        $(this).DataTable().destroy();
                    }
                    $(this).DataTable({
                        paging: true,
                        searching: true,
                        ordering: true,
                        responsive: true
                    });
                });
            });
    </script>
    <script>
        $(document).ready(function () {
            $('#DBTMTestMasterId').on('changed.bs.select', function (e, clickedIndex, isSelected) {
                var $select = $(this);
                var selectedValues = $select.val() || [];
                var allValue = "0";
                var totalOptions = $select.find('option').length - 1;
                if (clickedIndex === 0) {
                    if (isSelected) {
                        $select.find('option').prop('selected', true);
                    } else {
                        $select.find('option').prop('selected', false);
                    }
                    $select.selectpicker('refresh');
                    return;
                }
                var selectedWithoutAll = selectedValues.filter(v => v !== allValue);
                if (selectedWithoutAll.length !== totalOptions) {
                    $select.find('option[value="' + allValue + '"]').prop('selected', false);
                }
                if (selectedWithoutAll.length === totalOptions) {
                    $select.find('option[value="' + allValue + '"]').prop('selected', true);
                }
                $select.selectpicker('refresh');
            });
        });
    </script>
}
