@model DBTMReportsListViewModel
@{
    ViewBag.Title = "Batchwise Multiple Reports";
    DropdownViewModel batchDropdown = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.BatchWiseReports.ToString(), DropdownName = "GeneralBatchMasterId", DropdownSelectedValue = Model.GeneralBatchMasterId.ToString(), ChangeEvent = "DBTMReports.GetDBTMMultiTestListByGeneralBatchMasterId()", IsCustomDropdown = true };
    DropdownViewModel testDropdownn = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.BatchWiseMultiReports.ToString(), DropdownName = "DBTMTestMasterId", DropdownSelectedValue = Model.DBTMTestMasterId.ToString(), Parameter = $"{Model.GeneralBatchMasterId}~false", ChangeEvent = "DBTMReports.GetDBTMBatchWiseMultiReports('" + Model.GeneralBatchMasterId + "')", IsCustomDropdown = true, ExcludedValues = new[] { "0" } };
    ModelPopUpViewModel activityPopup = new ModelPopUpViewModel() { ModelPopUpId = "DBTMActivityDetailPopupId", ModalContentId = "DBTMActivityDetailPopupContentId" };
}
<!-- Page Content-->
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title">Batchwise Reports</h4>
                            </div><!--end col-->
                        </div>  <!--end row-->
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-1">
                                <label>Batch List</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", batchDropdown)
                            </div>
                            <div class="col-md-1">
                                <label class="form-label" for="CustomDropdownSelectedValue1">Activity List</label>
                            </div>
                            <div class="col-md-7">
                                <div class="mb-3 multiselect-dropdown">
                                    @Html.ListBoxFor(x => x.CustomDropdownSelectedValue1, new SelectList(Model.CustomDropdownList1, "Value", "Text"), new { @class = "selectpicker form-control", id = "DBTMTestMasterId", multiple = "multiple", data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-1">
                                @Html.LabelFor(x => x.FromDate, new { @class = "form-label" })
                            </div>
                            <div class="col-md-1">
                                @Html.TextBoxFor(x => x.FromDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-1">
                                @Html.LabelFor(x => x.ToDate, new { @class = "form-label" })
                            </div>
                            <div class="col-md-1">
                                @Html.TextBoxFor(x => x.ToDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control" })
                                <small id="toDateError" style="color:red; display:none;"> Please select From Date first </small>
                            </div>
                            <div class="col-md-1">
                                <input type="button" class="btn btn-success" value="Show" id="ShowDataId" onclick="DBTMReports.GetDBTMBatchWiseMultiReports()" />
                            </div>
                            <div class="col-md-3">
                                <!-- View in new tab -->
                                @*      <button type="button" class="btn btn-success" onclick="DBTMReports.GetDBTMBatchWiseMultiReportsFile()">View in xls</button> *@

                                <!-- Download latest -->
                                <a id="DownloadBtn" class="btn btn-success" onclick="DBTMReports.DownloadBatchExcelReport()">
                                    <i class="fa fa-download"></i> Download
                                </a>

                            </div>
                            <div id="DBTMBatchWiseMultiReportsDivId" class="mt-3">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Activity Detail Popup -->
<div class="modal fade" id="@activityPopup.ModelPopUpId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="@activityPopup.ModalContentId">
            <!-- AJAX content loads here -->
        </div>
    </div>
</div>
<iframe id="hiddenDownloader" style="display:none;"></iframe>
<style>
    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 15px;
    }

    .dataTables_wrapper .dataTables_paginate {
        margin-top: 8px;
        margin-bottom: 0;
        text-align: right;
    }

    .table-responsive {
        padding-bottom: 4px !important;
        box-sizing: border-box;
    }

    .activity-date a {
        background-color: #198754 !important;
        color: #fff !important;
        font-weight: 600;
    }
</style>
<script src="~/js/coditech/DBTM/DBTMReports.js"></script>
@section scripts {
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            DBTMReports.LoadBatchActivityPerformedDates();
            $("#DBTMTestMasterId").on("changed.bs.select", function () {
                DBTMReports.LoadBatchActivityPerformedDates();
            });
            $("#GeneralBatchMasterId").change(function () {
                DBTMReports.LoadBatchActivityPerformedDates();
            });
        });
    </script>
    <script type="text/javascript">
        var isFromDateSelected = false;
        function formatDate(d) {
            return d.getFullYear() + "-"
                + String(d.getMonth() + 1).padStart(2, "0") + "-"
                + String(d.getDate()).padStart(2, "0");
        }
        function updateToDate() {
            var fromDate = $("#FromDate").datepicker("getDate");
            if (fromDate) {
                $("#ToDate").datepicker("option", "minDate", fromDate);

                var toDate = $("#ToDate").datepicker("getDate");
                if (toDate && toDate < fromDate) {
                    $("#ToDate").datepicker("setDate", fromDate);
                }
            }
        }
        $(document).ready(function () {
            var dateFormat = "@AdminGeneralHelper.DateFormatForCalendar()";
            // FromDate
            $("#FromDate").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: dateFormat,
                language: "en",
                autoSize: true,
                gotoCurrent: true,
                clearBtn: true,
                showButtonPanel: true,
                closeText: 'Clear',
                maxDate: new Date(),
                beforeShowDay: function (date) {
                    var selectedActivities = $("#DBTMTestMasterId").val() || [];
                         if (!activityPerformedDates || activityPerformedDates.length === 0) {
                            return [true, "", ""];
                         }
                        var d = formatDate(date);
                        if (activityPerformedDates.includes(d)) {
                            return [true, "activity-date", "Activity Performed"];
                        }
                        return [true, "", ""];
                },
                onSelect: function () {
                    isFromDateSelected = true;
                    updateToDate();
                    $("#toDateError").hide();
                }
            });

            // ToDate
            $("#ToDate").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: dateFormat,
            maxDate: new Date(),
            beforeShowDay: function (date) {
                var selectedActivities = $("#DBTMTestMasterId").val() || [];
                if (!activityPerformedDates || activityPerformedDates.length === 0) {
                    return [true, "", ""];
                }
                var d = formatDate(date);
                if (activityPerformedDates.includes(d)) {
                    return [true, "activity-date", "Activity Performed"];
                }
              return [true, "", ""];
            },
            onSelect: function () {
                updateToDate();
            }
        });
        $("#ToDate").on("mousedown", function (e) {
            if (!isFromDateSelected) {
                $("#toDateError").show();
                e.preventDefault();
            } else {
                $("#toDateError").hide();
            }
        });
            updateToDate();
        });
    </script>
    <script>
        $.fn.dataTable.ext.errMode = 'none';
           $(document).on('ajaxComplete', function () {
             $("table[id^='datatable-']").each(function () {
                if ($.fn.DataTable.isDataTable(this)) {
                    $(this).DataTable().destroy();
                }
                $(this).DataTable({
                    paging: true,
                    searching: true,
                    ordering: true,
                    responsive: true
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {

            $("#DBTMTestMasterId").prop("disabled", true);

            $("#GeneralBatchMasterId").on("change", function () {
                var batchId = $(this).val();
                    if (batchId) {
                        $("#DBTMTestMasterId").prop("disabled", false);
                    } else {
                        $("#DBTMTestMasterId").prop("disabled", true);
                    }
            });
            $('#DBTMTestMasterId').on('changed.bs.select', function (e, clickedIndex, isSelected) {
                var $select = $(this);
                var selectedValues = $select.val() || [];
                var allValue = "0";
                var totalOptions = $select.find('option').length - 1;
                if (clickedIndex === 0) {
                    if (isSelected) {
                        $select.find('option').prop('selected', true);
                    } else {
                        $select.find('option').prop('selected', false);
                    }
                    $select.selectpicker('refresh');
                    return;
                }
                var selectedWithoutAll = selectedValues.filter(v => v !== allValue);
                if (selectedWithoutAll.length !== totalOptions) {
                    $select.find('option[value="' + allValue + '"]').prop('selected', false);
                }
                if (selectedWithoutAll.length === totalOptions) {
                    $select.find('option[value="' + allValue + '"]').prop('selected', true);
                }
                $select.selectpicker('refresh');
            });
        });
    </script>
}