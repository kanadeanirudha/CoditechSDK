@model DBTMTraineeProfileListViewModel
@{
    ViewBag.Title = "Trainee Profile Details";
    DropdownViewModel batchDropdown = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.BatchWiseReports.ToString(), DropdownName = "GeneralBatchMasterId", DropdownSelectedValue = Model.GeneralBatchMasterId.ToString(), ChangeEvent = "DBTMReports.GetBatchUserListByBatchId()", IsCustomDropdown = true };
    DropdownViewModel traineeDropdownn = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.BatchWiseUser.ToString(), DropdownName = "DBTMTraineeDetailId", DropdownSelectedValue = Model.DBTMTraineeDetailId.ToString(), IsCustomDropdown = true, ChangeEvent = "DBTMReports.GetBatchWiseTraineeProfileDetailsList('" + Model.GeneralBatchMasterId + "')" };
    DropdownViewModel orderByDropdown = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.OrderBy.ToString(), DropdownName = "OrderBy", DropdownSelectedValue = Model.OrderBy, IsCustomDropdown = true };
}
<!-- Page Content-->
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title">Trainee Profile Details</h4>
                            </div><!--end col-->
                        </div>  <!--end row-->
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-1">
                                <label class="required">Batch List</label>
                            </div>
                            <div class="col-md-4">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", batchDropdown)
                            </div>

                            <div class="col-md-1">
                                <label class="form-label required" for="CustomDropdownSelectedValue1">Trainee List</label>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 multiselect-dropdown">
                                    @Html.ListBoxFor(x => x.CustomDropdownSelectedValue1, new SelectList(Model.CustomDropdownList1, "Value", "Text"), new { @class = "selectpicker form-control", id = "DBTMTraineeDetailId", multiple = "multiple", data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Date</label>
                            </div>
                            <div class="col-md-2">
                                @Html.TextBoxFor(x => x.ToDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Order By</label>
                            </div>
                            <div class="col-md-2">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", orderByDropdown)
                            </div>
                            <div class="col-md-1">
                                <input type="button"
                                       class="btn btn-success"
                                       value="Show"
                                       id="ShowDataId"
                                       onclick="DBTMReports.GetBatchWiseTraineeProfileDetailsListV2()" />
                            </div>
                            <div id="DBTMBatchWiseTraineeProfileDetailsDivId" class="mt-3">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .activity-date a {
        background-color: #198754 !important;
        color: #fff !important;
        font-weight: 600;
    }
</style>
<script src="~/js/coditech/DBTM/DBTMTraineeDetails.js"></script>
<script src="~/js/coditech/DBTM/DBTMReports.js"></script>
@section scripts {
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#DBTMTraineeDetailId").on("changed.bs.select", function () {
                DBTMReports.LoadTraineeProfileActivityDates();
            });
            $("#GeneralBatchMasterId").change(function () {
                DBTMReports.LoadTraineeProfileActivityDates();
            });
        var dateFormat = "@AdminGeneralHelper.DateFormatForCalendar()";
        $("#ToDate").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: dateFormat,
            maxDate: new Date(),
            beforeShowDay: function (date) {
                if (!activityPerformedDates || activityPerformedDates.length === 0) {
                    return [false, "", ""];
                }
                var d = date.getFullYear() + "-" +
                    String(date.getMonth() + 1).padStart(2, "0") + "-" +
                    String(date.getDate()).padStart(2, "0");

                if (activityPerformedDates.includes(d)) {
                    return [true, "activity-date", "Trainee Performed"];
                }
                   return [true, "", ""];
            }
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#DBTMTraineeDetailId').selectpicker();
            $("#DBTMTraineeDetailId")
                .prop("disabled", true)
                .selectpicker('refresh');
            $("#GeneralBatchMasterId").on("change", function () {
                var batchId = $(this).val();
                $("#DBTMTraineeDetailId")
                    .prop("disabled", !batchId)
                    .selectpicker('refresh');
            });
            $('#DBTMTraineeDetailId').on('changed.bs.select',
                function (e, clickedIndex, isSelected) {
                var $select = $(this);
                var selectedValues = $select.val() || [];
                var allValue = "0";
                var totalOptions = $select.find('option').length - 1;
                if (clickedIndex === 0) {
                    $select.find('option')
                           .prop('selected', isSelected);
                    $select.selectpicker('refresh');
                    return;
                }
                var selectedWithoutAll =
                    selectedValues.filter(v => v !== allValue);
                $select.find('option[value="0"]')
                       .prop('selected',
                             selectedWithoutAll.length === totalOptions);
                $select.selectpicker('refresh');
            });

        });
    </script>
}
