@model DBTMTraineeProfileListViewModel
@{
    ViewBag.Title = "Trainee Profile Details";
    DropdownViewModel batchDropdown = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.BatchWiseReports.ToString(), DropdownName = "GeneralBatchMasterId", DropdownSelectedValue = Model.GeneralBatchMasterId.ToString(), ChangeEvent = "DBTMReports.GetBatchUserListByBatchId()", IsCustomDropdown = true };
    DropdownViewModel traineeDropdownn = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.BatchWiseUser.ToString(), DropdownName = "DBTMTraineeDetailId", DropdownSelectedValue = Model.DBTMTraineeDetailId.ToString(), IsCustomDropdown = true, ChangeEvent = "DBTMReports.GetBatchWiseTraineeProfileDetailsList('" + Model.GeneralBatchMasterId + "')" };
    DropdownViewModel orderByDropdown = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.OrderBy.ToString(), DropdownName = "OrderBy", DropdownSelectedValue = Model.OrderBy, IsCustomDropdown = true };
    DropdownViewModel individualTraineeDropdown = new DropdownViewModel() { DropdownType = DropdownCustomTypeEnum.DBTMTraineeList.ToString(), DropdownName = "IndividualDBTMTraineeDetailId", IsCustomDropdown = true, ExcludedValues = new[] { "0" } };
}
<!-- Page Content-->
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="card-title">Trainee Profile Reports</span>
                        <div class="switch-field">
                            <input type="radio" id="IndividualProfileReport" name="ProfileReportMode" value="Individual" checked />
                            <label for="IndividualProfileReport">Individual</label>
                            <input type="radio" id="RankwiseReport" name="ProfileReportMode" value="Rankwise" />
                            <label for="RankwiseReport">RankWise</label>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-1" id="BatchListLabel">
                                <label class="required">Batch List</label>
                            </div>
                            <div class="col-md-4" id="BatchListWrapper">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", batchDropdown)
                            </div>
                            <div class="col-md-1" id="TraineeListLabel">
                                <label class="required">Trainee List</label>
                            </div>
                            <div class="col-md-6" id="TraineeListWrapper">
                                <div class="mb-3 multiselect-dropdown">
                                    @Html.ListBoxFor(x => x.CustomDropdownSelectedValue1, new SelectList(Model.CustomDropdownList1, "Value", "Text"), new { @class = "selectpicker form-control", id = "DBTMTraineeDetailId", multiple = "multiple", data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-1" id="IndividualTraineeListLabel" style="display:none;">
                                <label class="required">Trainee List</label>
                            </div>
                            <div class="col-md-6" id="IndividualTraineeListWrapper" style="display:none;">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", individualTraineeDropdown)
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Date</label>
                            </div>
                            <div class="col-md-2">
                                @Html.TextBoxFor(x => x.ToDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-1" id="OrderByLabel">
                                <label>Order By</label>
                            </div>
                            <div class="col-md-2" id="OrderByWrapper">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", orderByDropdown)
                            </div>
                            <div class="col-md-1">
                                <input type="button" class="btn btn-success" value="Show" id="ShowDataId" onclick="DBTMReports.GetBatchWiseTraineeProfileDetailsListV2()" />
                            </div>
                            <div id="DBTMBatchWiseTraineeProfileDetailsDivId" class="mt-3">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .activity-date a {
        background-color: #198754 !important;
        color: #fff !important;
        font-weight: 600;
    }

    #ui-datepicker-div {
        z-index: 99999 !important;
    }

    .switch-field {
        display: inline-flex;
        overflow: hidden;
        border-radius: 5px;
    }

        .switch-field input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
        }

        .switch-field label {
            padding: 7px 12px;
            margin: 0;
            background: #e4e4e4;
            color: #333;
            cursor: pointer;
            font-size: 13px;
            transition: background-color 0.2s ease;
        }

        .switch-field input:checked + label {
            background: #ffb822;
            color: #000;
            font-weight: 600;
        }

        .switch-field label:first-of-type {
            border-radius: 5px 0 0 5px;
        }

        .switch-field label:last-of-type {
            border-radius: 0 5px 5px 0;
        }
</style>
<script src="~/js/coditech/DBTM/DBTMTraineeDetails.js"></script>
<script src="~/js/coditech/DBTM/DBTMReports.js"></script>
@section scripts {
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#DBTMTraineeDetailId").on("changed.bs.select", function () {
                DBTMReports.LoadTraineeProfileActivityDates();
            });
            $("#GeneralBatchMasterId").change(function () {
                DBTMReports.LoadTraineeProfileActivityDates();
            });
        var dateFormat = "@AdminGeneralHelper.DateFormatForCalendar()";
        $("#ToDate").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: dateFormat,
            maxDate: new Date(),
                   beforeShowDay: function (date) {
            var d = date.getFullYear() + "-" +
                String(date.getMonth() + 1).padStart(2, "0") + "-" +
                String(date.getDate()).padStart(2, "0");

            if (activityPerformedDates && activityPerformedDates.includes(d)) {
                return [true, "activity-date", "Trainee Performed"];
            }
            return [true, "", ""];
        }
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#DBTMTraineeDetailId').selectpicker();
            $("#DBTMTraineeDetailId")
                .prop("disabled", true)
                .selectpicker('refresh');
            $("#GeneralBatchMasterId").on("change", function () {
                var batchId = $(this).val();
                $("#DBTMTraineeDetailId")
                    .prop("disabled", !batchId)
                    .selectpicker('refresh');
            });
            $('#DBTMTraineeDetailId').on('changed.bs.select',
                function (e, clickedIndex, isSelected) {
                var $select = $(this);
                var selectedValues = $select.val() || [];
                var allValue = "0";
                var totalOptions = $select.find('option').length - 1;
                if (clickedIndex === 0) {
                    $select.find('option')
                           .prop('selected', isSelected);
                    $select.selectpicker('refresh');
                    return;
                }
                var selectedWithoutAll =
                    selectedValues.filter(v => v !== allValue);
                $select.find('option[value="0"]')
                       .prop('selected',
                             selectedWithoutAll.length === totalOptions);
                $select.selectpicker('refresh');
            });

        });

        function ApplyProfileReportMode() {
            var reportMode = $('input[name="ProfileReportMode"]:checked').val();
            var isIndividual = reportMode === "Individual";
            $("#BatchListLabel, #BatchListWrapper, #TraineeListLabel, #TraineeListWrapper") .toggle(!isIndividual);
            $("#IndividualTraineeListLabel, #IndividualTraineeListWrapper").toggle(isIndividual);
            $("#OrderByLabel, #OrderByWrapper").toggle(!isIndividual);
            var $individualTrainee = $("#IndividualDBTMTraineeDetailId");
            if ($individualTrainee.length) {
                $individualTrainee.selectpicker();
                $individualTrainee.prop("disabled", false);
                $individualTrainee.selectpicker("refresh");
            }
            $("#DBTMBatchWiseTraineeProfileDetailsDivId").empty();
            activityPerformedDates = [];
            if ($("#ToDate").hasClass("hasDatepicker")) {
                $("#ToDate").datepicker("refresh");
            }
            DBTMReports.LoadTraineeProfileActivityDates();
        }
        $(document).ready(function () {
            $('input[name="ProfileReportMode"]').on("change", function () {
                ApplyProfileReportMode();
            });
            ApplyProfileReportMode();
        });
    </script>
}
