@using Coditech.Admin.Utilities;
@using Coditech.Common.API.Model;
@model DBTMReportTraineeProfileModel
@{
    ViewBag.Title = "User Profile";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string dashboardUrl = CoditechAdminSettings.DashboardUrl;
    ModelPopUpViewModel remarkPopup = new ModelPopUpViewModel()
    {
        ModelPopUpId = "RemarkPopupId_" + Model.DBTMTraineeDetailId,
        ModalContentId = "RemarkContentId_" + Model.DBTMTraineeDetailId
    };
}
<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #e9e9e9;
        font-family: Arial, Helvetica, sans-serif;
        color: #111;
        font-size: 9px;
    }

    .toolbar {
        position: sticky;
        top: 0;
        z-index: 20;
        padding: 10px;
        background: #222;
        text-align: center;
    }

        .toolbar button {
            border: 0;
            padding: 8px 14px;
            margin: 0 4px;
            border-radius: 4px;
            cursor: pointer;
            background: #fff;
            font-weight: 700;
        }

    .page {
        /* width: 210mm; */
        /* min-height: 297mm; */
        margin: 12px auto;
        background: #fff;
        padding: 10mm 9mm 8mm;
        box-shadow: 0 0 8px rgba(0,0,0,.25);
        position: relative;
        overflow: hidden;
    }

    .report-border {
        border: 1.5px solid #111;
        min-height: 279mm;
        padding: 3mm 7mm 0;
        position: relative;
    }

    .header {
        height: 65px;
        position: relative;
        border-bottom: 0;
    }

    .brand {
        font-size: 18px;
        font-weight: 900;
        color: #24395f;
        letter-spacing: -1px;
        line-height: 15px;
    }

        .brand span {
            display: block;
            color: #ee3f59;
            font-size: 6px;
            letter-spacing: 2px;
            margin-left: 4px;
        }

        .brand.right {
            position: absolute;
            right: 0;
            top: 0;
            text-align: right;
        }

    .center-name-report {
        position: absolute;
        top: 1px;
        left: 50%;
        transform: translateX(-50%);
        font-weight: 700;
        font-size: 12px;
        color: #000 !important;
    }

    .report-title {
        position: absolute;
        top: 25px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 14px;
        font-weight: 700;
    }

    .assessment-date {
        position: absolute;
        right: 0;
        top: 46px;
        font-size: 8px;
    }

    .top-grid {
        display: grid;
        grid-template-columns: 25% 39% 36%;
        gap: 8px;
        align-items: start;
    }

    .photo-box {
        height: 138px;
        width: 140px;
        border: 1.5px solid #222;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-left: 0;
    }

    .info-box {
        border: 1.5px solid #222;
        padding: 5px 6px;
        height: 200px;
        font-size: 8px;
    }

    .info-row {
        display: grid;
        grid-template-columns: 68px 1fr;
        margin: 2px 0;
        align-items: end;
    }

        .info-row b {
            font-size: 8px;
        }

    .line {
        border-bottom: 1px solid #555;
        min-height: 11px;
    }

    .sport-box {
        border: 1.5px solid #222;
        height: 165px;
        padding: 5px;
        position: relative;
    }

    .ball {
        width: 75px;
        height: 75px;
        margin: 3px auto 3px;
        display: block;
    }

    .sport-row {
        display: grid;
        grid-template-columns: 68px 1fr;
        margin: 3px 0;
        font-size: 8px;
    }

    .sport-line {
        border-bottom: 1px solid #555;
    }

    .middle {
        display: grid;
        grid-template-columns: 25% 39% 36%;
        gap: 8px;
        margin-top: 18px;
        align-items: start;
    }

    .anthro-area {
        min-height: 260px;
        position: relative;
    }

    .body-svg {
        width: 100px;
        height: 190px;
        /* display:block; */
        margin: 0 auto;
    }

    .measure-line {
        position: absolute;
        right: 22px;
        top: 4px;
        height: 190px;
        border-right: 1px solid #888;
    }

        .measure-line:before, .measure-line:after {
            content: "";
            position: absolute;
            width: 28px;
            border-top: 1px solid #888;
            right: -1px;
        }

        .measure-line:before {
            top: 0;
        }

        .measure-line:after {
            bottom: 0;
        }

    table {
        border-collapse: collapse;
        width: 100%;
    }

    .small-table td, .small-table th {
        border: 1px solid #777;
        padding: 3px 4px;
        font-size: 8px;
    }

    .small-table th {
        font-weight: 700;
    }
    /* .anthro-table { margin-top:3px; } */

    .score-summary {
        border: 1px solid #777;
        margin-top: 0;
        width: 100%;
    }

        .score-summary td {
            border: 1px solid #777;
            padding: 4px;
            height: 24px;
            font-size: 8px;
        }

        .score-summary .dark {
            background: #273a61;
            color: #fff;
            text-align: center;
            font-weight: 700;
        }

        .score-summary .green {
            color: #62bd3b;
            font-weight: 700;
        }

    .chart-title {
        text-align: center;
        font-size: 12px;
        color: #777;
        font-weight: 700;
        margin: 10px 0;
    }

    .bar-wrap {
        height: 155px;
    }

    .radar-title {
        text-align: center;
        font-size: 12px;
        font-weight: 700;
        margin: 10px 0 3px;
    }

    .radar-wrap {
        height: 180px;
    }

    .activities {
        text-align: center;
        font-weight: 700;
        color: #1f3155;
        font-size: 9px;
        margin-top: 3px;
    }

    .section-table {
        margin-top: 12px;
        font-size: 8px;
    }

        .section-table th,
        .section-table td {
            border: 1px solid #777;
            padding: 4px 5px;
            height: 19px;
        }

        .section-table th {
            font-weight: 700;
            text-align: left;
        }

        .section-table .cat-speed {
            background: #ef3e55;
        }

        .section-table .cat-power {
            background: #f36d22;
        }

        .section-table .cat-reaction {
            background: #ef3e55;
        }

        .section-table .cat-balance {
            background: #f36d22;
        }

        .section-table .cat-agility {
            background: #91c83e;
        }

        .section-table .cat-endurance {
            background: #91c83e;
        }

        .section-table .cat-strength {
            background: #91c83e;
        }

        .section-table .unit {
            background: #25a9d3;
            font-weight: 700;
        }

        .section-table .score-head {
            background: #273a61;
            color: #fff;
            text-align: center;
        }

        .section-table .value-green {
            background: #a9d8a0;
            font-weight: 700;
            text-align: center;
        }

        .section-table .value-red {
            background: #ef1717;
            color: #111;
            font-weight: 700;
            text-align: center;
        }

        .section-table .score {
            text-align: center;
        }

    .up {
        color: #7abd42;
        font-size: 15px;
        font-weight: bold;
    }

    .down {
        color: #e33b3b;
        font-size: 15px;
        font-weight: bold;
    }

    .notes {
        border: 1.5px solid #111;
        height: 45px;
        margin: 0 -7px;
        margin-top: 12px;
        padding: 4px;
        font-size: 8px;
    }

    .footer-bar {
        height: 9px;
        background: #050505;
        margin: 0 -7px;
    }

    .muted-line {
        color: #777;
    }

    .nowrap {
        white-space: nowrap;
    }

</style>
<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0">Trainee Profile</h4>
                        <div class="d-flex gap-2">
                            <a class="btn btn-soft-primary float-end" href="/DBTMTraineeDetails/Cancel?selectedCentreCode=@Model.SelectedCentreCode&GeneralTrainerMasterId=@Model.SelectedParameter2" role="button">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                            <button type="button"
                                    class="btn btn-success"
                                    data-bs-toggle="modal"
                                    data-bs-target="#RemarkPopupId_@Model.DBTMTraineeDetailId"
                                    onclick="DBTMTraineeDetails.GetRemarks('RemarkContentId_@Model.DBTMTraineeDetailId', @Model.DBTMTraineeDetailId,'@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Remarks ?? ""))')">
                                <i class="fa fa-download me-1"></i> Download Report
                            </button>
                            @if (!Model.IsListView)
                            {
                                <!-- BACK BUTTON  -->
                                <a class="btn btn-sm btn-soft-primary" href="@Url.Action("List", controllerName, new DataTableViewModel { SelectedCentreCode = Model.SelectedCentreCode, SelectedParameter1 = Model.SelectedParameter1 })">
                                    <i class="fas fa-arrow-left me-2"></i> Back
                                </a>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="dastone-profile">

                            <div class="page" id="report">
                                <div class="report-border">
                                    <div class="header">
                                        <div class="brand"><img style="height:45px" src="~/assets/images/dbtm/applicationlogo.png" /></div>
                                        <div class="center-name-report">Center Name:</div>
                                        <div class="brand right"> <img style="height:45px" src="~/assets/images/dbtm/applicationlogo.png" /></div>
                                        <div class="report-title">Fitness Report</div>
                                        <div class="assessment-date"><b>Assessment Date:</b> DDMMYYYY</div>
                                    </div>

                                    <div class="top-grid">
                                        <div class="photo-box">
                                            <img style="height: 115px;" src="~/assets/images/dbtm/maleavatar.png" />
                                        </div>

                                        <div class="info-box">
                                            <div class="info-row"><b>Report Title:</b><div class="line"></div></div>
                                            <div class="info-row"><b>Program<br>Name / Batch:</b><div class="line"></div></div>
                                            <div class="info-row"><b>Assessment<br>Location:</b><div class="line"></div></div>
                                            <div class="info-row"><b>Athlete /<br>Student Name:</b><div class="line"></div></div>
                                            <div class="info-row"><b>Gender:</b><div class="line"></div></div>
                                            <div class="info-row"><b>DOB:</b><div class="line"></div></div>
                                            <div class="info-row"><b>Age Group:</b><div class="line"></div></div>
                                            <div class="info-row"><b>Academy<br>Name:</b><div class="line"></div></div>
                                            <div class="info-row"><b>Coach Name:</b><div class="line"></div></div>
                                        </div>

                                        <div class="sport-box">
                                            <img class="ball" src="~/assets/images/dbtm/ball.jpg" />
                                            <div class="sport-row"><b>Sport and Position / Role:</b><div class="sport-line"></div></div>
                                            <div class="sport-row"><b>Batch Rank:</b><div class="sport-line"></div></div>
                                            <div class="sport-row"><b>Batch Name:</b><div class="sport-line"></div></div>
                                        </div>
                                    </div>

                                    <div class="middle">
                                        <div class="anthro-area">
                                            <img class="body-svg" src="~/assets/images/dbtm/heightweightmale.png" />
                                            <!-- <div class="measure-line"></div> -->

                                            <table class="small-table anthro-table">
                                                <tr><th>Anthropometry</th><th></th><th>Data<br>recorded<br>date</th></tr>
                                                <tr><th>Height (cm)</th><td>177.8</td><td>DDMMYYYY</td></tr>
                                                <tr><th>Weight (kg)</th><td>72.57</td><td>DDMMYYYY</td></tr>
                                                <tr><th>BMI</th><td>22.96</td><td></td></tr>
                                            </table>
                                        </div>

                                        <div>
                                            <table class="score-summary">
                                                <tr>
                                                    <td><b>Today's Overall<br>Activity Score:</td>
                                                    <td class="dark">31.033</td>
                                                    <td>6.10% <span class="up">↑</span></td>
                                                    <td>Improved</td>
                                                </tr>
                                                <tr>
                                                    <td><b>Past score:</td>
                                                    <td>29.25</td>
                                                    <td colspan="2">DDMMYYYY</td>
                                                </tr>
                                            </table>

                                            <div class="chart-title">Score Chart</div>
                                            <div class="bar-wrap"><canvas id="scoreChart"></canvas></div>
                                            <div class="activities">Activities</div>
                                        </div>

                                        <div>
                                            <div class="radar-title">Performance Matrix</div>
                                            <div class="radar-wrap"><canvas id="radarChart"></canvas></div>
                                        </div>
                                    </div>

                                    <table class="section-table">
                                        <tr>
                                            <th colspan="5" class="cat-speed">Speed</th>
                                            <th colspan="5" class="cat-agility">Agility</th>
                                        </tr>
                                        <tr>
                                            <th>Test</th>
                                            <th class="unit">Unit</th>
                                            <th>Value</th>
                                            <th class="score-head">Score</th>
                                            <th>% Improvement</th>
                                            <th>Test</th>
                                            <th class="unit">Unit</th>
                                            <th>Value</th>
                                            <th class="score-head">Score</th>
                                            <th>% Improvement</th>
                                        </tr>
                                        <tr>
                                            <td><b>10M sprint</b></td>
                                            <td>sec</td>
                                            <td class="value-green">1.972</td>
                                            <td class="score"></td>
                                            <td></td>
                                            <td><b>Illinois Agility</b></td>
                                            <td>sec</td>
                                            <td class="value-green">16.813</td>
                                            <td class="score">59.300</td>
                                            <td>xx.xx <span class="up">↑</span></td>
                                        </tr>
                                        <tr>
                                            <td><b>20M sprint</b></td>
                                            <td>sec</td>
                                            <td class="value-green">3.376</td>
                                            <td></td>
                                            <td></td>
                                            <td><b>Arrow headed L-R</b></td>
                                            <td>sec</td>
                                            <td class="value-green">17.775</td>
                                            <td></td>
                                            <td>xx.xx <span class="up">↑</span></td>
                                        </tr>
                                        <tr>
                                            <td><b>30M sprint</b></td>
                                            <td>sec</td>
                                            <td>4.727</td>
                                            <td class="score">10.000</td>
                                            <td>xx.xx <span class="up">↑</span></td>
                                            <td><b>Arrow headed L</b></td>
                                            <td>sec</td>
                                            <td class="value-green">8.918</td>
                                            <td class="score">14.500</td>
                                            <td>xx.xx <span class="up">↑</span></td>
                                        </tr>
                                        <tr>
                                            <td><b>RSA 30M</b></td>
                                            <td>sec</td>
                                            <td class="value-red">4.805</td>
                                            <td class="score">49.500</td>
                                            <td>xx.xx <span class="down">↓</span></td>
                                            <td><b>Arrow headed R</b></td>
                                            <td>sec</td>
                                            <td class="value-green">8.857</td>
                                            <td></td>
                                            <td>xx.xx <span class="up">↑</span></td>
                                        </tr>
                                    </table>
                                    <div class="notes"><b>Notes:</b></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
@section Scripts {
    <script src="~/js/coditech/DBTM/DBTMTraineeDetails.js"></script>
    <script src="~/js/coditech/DBTM/DBTMReports.js"></script>
}
<iframe id="hiddenDownloader"
        style="display:none;"
        title="pdf-downloader">
</iframe>
@Html.Partial("~/Views/Shared/_ModelPopUp.cshtml", remarkPopup)
