@using System.Data
@model DBTMReportVerticalDataViewModel
@{
    if (Model?.GraphModelList?.Count > 0)
    {
        Model.GraphModelList.ForEach(x => x.GraphSize = "col-lg-12");
    }
}
<div class="modal-header">
    <h6 class="modal-title m-0">Activity View Details</h6>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <!-- Details Table -->
    <table class="table table-bordered table-sm mb-3">
        <tr>
            <th style="width: 30%;">Athlete Name:</th>
            <td>@Model.AthleteName</td>
        </tr>
        <tr>
            <th>Activity Name:</th>
            <td>@Model.TestName</td>
        </tr>
        <tr>
            <th>Status:</th>
            <td>
                <span class="badge bg-success">
                    @Model.Status
                </span>
            </td>
        </tr>
        @*    <tr>
            <th>Direction:</th>
            <td>@Model.Direction</td>
        </tr> *@
        <tr>
            <th style="width: 35%; white-space: nowrap;"> Activity Performed On: </th>
            <td style="white-space: nowrap;"> @Model.TestPerformedTime.ToString("dd/MM/yyyy hh:mm tt")</td>
        </tr>
    </table>
    <!-- Data Table -->
    <div class="accordion" id="activityViewAccordion">
        <!-- TABLE VIEW -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="tableHeading">
                <button class="accordion-button fw-bold"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#tableCollapse"
                        aria-expanded="true">
                    Table View
                </button>
            </h2>
            <div id="tableCollapse"
                 class="accordion-collapse collapse show"
                 data-bs-parent="#activityViewAccordion">
                <div class="accordion-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-sm">
                            <thead>
                                <tr>
                                    @foreach (DataColumn col in Model.DataTable.Columns)
                                    {
                                        <th>@col.ColumnName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DataTable.Rows.Count > 0)
                                {
                                    foreach (DataRow row in Model.DataTable.Rows)
                                    {
                                        <tr>
                                            @foreach (DataColumn col in Model.DataTable.Columns)
                                            {
                                                <td>@row[col]</td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@Model.DataTable.Columns.Count"
                                            class="text-center text-danger fw-bold">
                                            No Data Found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- GRAPH VIEW -->
        <div class="accordion-item mt-2">
            <h2 class="accordion-header" id="graphHeading">
                <button class="accordion-button collapsed fw-bold"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#graphCollapse"
                        aria-expanded="false">
                    Graph View
                </button>
            </h2>
            <div id="graphCollapse"
                 class="accordion-collapse collapse"
                 data-bs-parent="#activityViewAccordion">
                @if (Model.GraphModelList != null && Model.GraphModelList.Count > 0)
                {
                    <div class="accordion-body p-4">
                        <div style="width:100%; min-height:500px;">
                            @Html.Partial("~/Views/Shared/Charts/_MultipleGraphs.cshtml", Model.GraphModelList)
                        </div>
                    </div>
                }
                else
                {
                    <div class="accordion-body text-center p-5">
                        <h5 class="text-muted">
                            Graph Coming Soon
                        </h5>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
<style>
        #activityViewAccordion .accordion-item:first-child {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        #activityViewAccordion .accordion-item:first-child .accordion-header {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        #activityViewAccordion .accordion-item:first-child .accordion-button {
            margin-top: 0 !important;
            padding-top: 4px !important;
        }
        #graphCollapse .graph-wrapper {
            padding: 40px 40px 60px 60px !important;
            box-sizing: border-box;
        }
</style>