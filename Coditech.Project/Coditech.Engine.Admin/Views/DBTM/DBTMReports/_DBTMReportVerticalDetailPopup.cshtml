@using System.Data
@model DBTMReportVerticalDataViewModel
@{
    if (Model?.GraphModelList?.Count > 0)
    {
        Model.GraphModelList.ForEach(x => x.GraphSize = "col-lg-12");
    }
}
<div class="modal-header">
    <h6 class="modal-title m-0">Activity View Details</h6>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <!-- Details Table -->
    <table class="table table-bordered table-sm mb-3 text-center align-middle">
        <tr>
            <th class="text-center" style="width:20%;">Athlete Name:</th>
            <td class="text-center" style="width:30%;">@Model.AthleteName</td>

            <th class="text-center" style="width:20%;">Activity Name:</th>
            <td class="text-center" style="width:30%;">@Model.TestName</td>
        </tr>

        <tr>
            <th class="text-center">Height:</th>
            <td class="text-center">@Model.Height</td>

            <th class="text-center">Status:</th>
            <td class="text-center">
                <span class="badge bg-success">@Model.Status</span>
            </td>
        </tr>

        <tr>
            <th class="text-center">Weight:</th>
            <td class="text-center">@Model.Weight</td>

            <th class="text-center">Activity Performed:</th>
            <td class="text-center">@Model.TestPerformedTime.ToString("dd/MM/yyyy hh:mm tt")</td>
        </tr>

        @if (Model.ActivityDetails?.Count > 0)
        {
            foreach (var item in Model.ActivityDetails)
            {
                <tr>
                    <th class="text-center"></th>
                    <td class="text-center"></td>
                    <th class="text-center">@item.Key:</th>
                    <td class="text-center">@item.Value</td>
                </tr>
            }
        }
    </table>
    <!-- Data Table -->
    <div class="accordion" id="activityViewAccordion">
        <!-- GRAPH VIEW -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="graphHeading">
                <button class="accordion-button fw-bold"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#graphCollapse"
                        aria-expanded="false">
                    Graph View
                </button>
            </h2>
            <div id="graphCollapse"
                 class="accordion-collapse collapse show"
                 data-bs-parent="#activityViewAccordion">
                @if (Model.GraphModelList != null && Model.GraphModelList.Count > 0)
                {
                    <div class="accordion-body p-4">
                        <div style="width:100%; min-height:500px;">
                            @Html.Partial("~/Views/Shared/Charts/_MultipleGraphs.cshtml", Model.GraphModelList)
                        </div>
                    </div>
                }
                else
                {
                    <div class="accordion-body text-center p-5">
                        <h5 class="text-muted">
                            Graph Coming Soon
                        </h5>
                    </div>
                }
            </div>
        </div>
        <!-- TABLE VIEW -->
        <div class="accordion-item mt-2">
            <h2 class="accordion-header" id="tableHeading">
                <button class="accordion-button collapsed fw-bold"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#tableCollapse"
                        aria-expanded="true">
                    Table View
                </button>
            </h2>
            <div id="tableCollapse"
                 class="accordion-collapse collapse"
                 data-bs-parent="#activityViewAccordion">
                <div class="accordion-body">
                    @if (Model.TurnList != null && Model.TurnList.Count > 0)
                    {
                        int turnIndex = 0;
                        <div class="accordion" id="turnAccordion">
                            @foreach (var turn in Model.TurnList)
                            {
                                string headingId = $"turnHeading_{turnIndex}";
                                string collapseId = $"turnCollapse_{turnIndex}";
                                <div class="accordion-item mb-2">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button class="accordion-button @(turnIndex == 0 ? "" : "collapsed")"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="@(turnIndex == 0 ? "true" : "false")">
                                            @turn.Key
                                        </button>
                                    </h2>
                                    <div id="@collapseId"
                                         class="accordion-collapse collapse @(turnIndex == 0 ? "show" : "")"
                                         data-bs-parent="#turnAccordion">
                                        <div class="accordion-body">
                                            <div class="table-responsive">
                                                <table class="table table-striped table-bordered table-sm text-center align-middle">
                                                    <thead>
                                                        <tr>
                                                            @foreach (DataColumn col in turn.Value.Columns)
                                                            {
                                                                <th class="text-center">@col.ColumnName</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (DataRow row in turn.Value.Rows)
                                                        {
                                                            <tr>
                                                                @foreach (DataColumn col in turn.Value.Columns)
                                                                {
                                                                    <td class="text-center">@row[col]</td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                turnIndex++;
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@* <div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div> *@
<style>
        #activityViewAccordion .accordion-item:first-child {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        #activityViewAccordion .accordion-item:first-child .accordion-header {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        #activityViewAccordion .accordion-item:first-child .accordion-button {
            margin-top: 0 !important;
            padding-top: 4px !important;
        }
        #graphCollapse .graph-wrapper {
            padding: 40px 40px 60px 60px !important;
            box-sizing: border-box;
        }
</style>