@model DBTMGraphListViewModel
@{
    ViewBag.Title = "Activity Reports";
    DropdownViewModel testDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.DBTMTest.ToString(),
                DropdownName = "DBTMTestMasterId",
                DropdownSelectedValue = Model.DBTMTestMasterId.ToString(),
                IsCustomDropdown = true,
                ChangeEvent = "DBTMReports.GetGraphListByDBTMTestMasterId()",
                Parameter = "IsActive"
            };
    DropdownViewModel traineeDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.DBTMTraineeGraphList.ToString(),
                DropdownName = "DBTMTraineeDetailId",
                DropdownSelectedValue = Model.DBTMTraineeDetailId.ToString(),
                ChangeEvent = "DBTMReports.GetDBTMTestWiseGraphReports()",
                IsCustomDropdown = true
            };
    DropdownViewModel graphModeDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.GraphMode.ToString(),
                DropdownName = "GraphMode",
                DropdownSelectedValue = Model.GraphMode,
                ChangeEvent = "DBTMReports.GetGraphListByGraphMode()",
                IsCustomDropdown = true
            };
    DropdownViewModel graphTypeDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.DBTMGraph.ToString(),
                DropdownName = "DBTMGraphMasterId",
                DropdownSelectedValue = Model.DBTMGraphMasterId.ToString(),
                IsCustomDropdown = true,
                ChangeEvent = "DBTMReports.GetDBTMTestWiseGraphReports()"
            };
    string url = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<!-- Page Content-->
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    @*   <div class="card-header">
                    <div class="row align-items-center">
                    <div class="col">
                    <h4 class="card-title">Activity Graph Reports</h4>
                    </div><!--end col-->
                    </div>  <!--end row-->
                    </div> *@
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="card-title">Activity Graph Reports</span>
                        <div class="d-flex align-items-center">
                            <!-- Toggle Switch -->
                            <div class="form-check form-switch me-3">
                                <div class="switch-field">
                                    <input type="radio" id="radio-list" name="switch-tile-list" value="list" onclick="window.open('@($"{url}/dbtmreports/testwisereports")', '_self');" />
                                    <label for="radio-list">List</label>
                                    <input type="radio" id="radio-tile" name="switch-tile-list" value="tile" checked onclick="window.open('@($"{url}/dbtmreports/TestWiseGraphReports")', '_self');" />
                                    <label for="radio-tile">Graph</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-1">
                                <label class="form-label">Activity List</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", testDropdown)
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Trainee List</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", traineeDropdown)
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Graph Mode</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", graphModeDropdown)
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-1">
                                <label class="form-label">Graph Type</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", graphTypeDropdown)
                            </div>
                            <div class="col-md-1">
                                @Html.LabelFor(x => x.FromDate, new { @class = "form-label" })
                            </div>
                            <div class="col-md-1">
                                @Html.TextBoxFor(x => x.FromDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-1">
                                @Html.LabelFor(x => x.ToDate, new { @class = "form-label" })
                            </div>
                            <div class="col-md-1">
                                @Html.TextBoxFor(x => x.ToDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-1">
                                <input type="button" class="btn btn-success" value="Show" id="ShowDataId" onclick="DBTMReports.GetDBTMTestWiseGraphReports()" />
                            </div>
                        </div>
                        <div class="row  mt-3">
                            <div class="col-lg-12 h-100">
                                <div id="DBTMTestWiseGraphReportsDivId">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .switch-field {
        display: flex;
        overflow: hidden;
    }

        .switch-field input {
            position: absolute !important;
            clip: rect(0, 0, 0, 0);
            height: 1px;
            width: 1px;
            border: 0;
            overflow: hidden;
        }

        .switch-field label {
            background-color: #e4e4e4;
            color: rgba(0, 0, 0, 0.6);
            font-size: 14px;
            line-height: 1;
            text-align: center;
            padding: 8px 16px;
            margin-right: -1px;
            border: 1px solid rgba(0, 0, 0, 0.2);
            transition: all 0.2s ease-in-out;
            cursor: pointer;
        }

            .switch-field label:hover {
                background-color: rgba(255, 184, 34, 0.6);
                color: #000;
            }

        .switch-field input:checked + label {
            background-color: rgb(255, 184, 34);
            color: #000;
            font-weight: 600;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
            border-color: rgb(230, 165, 30);
        }

        .switch-field label:active {
            background-color: rgb(230, 165, 30);
            color: #fff;
        }

        .switch-field label:first-of-type {
            border-radius: 4px 0 0 4px;
        }

        .switch-field label:last-of-type {
            border-radius: 0 4px 4px 0;
        }

</style>
<script src="~/js/coditech/DBTM/DBTMReports.js"></script>
@section scripts {
    <script type="text/javascript">
        function ShowHideDiv(type) {
            if (type == "list") {

            }
            else {

            }
            $("#SelectedParameter2").val(type);
        }
        function updateToDate() {
            var graphMode = $("#GraphMode").val();
            var fromDate = $("#FromDate").datepicker("getDate");
            if (graphMode === "InstantaneousChart" && fromDate) {
                $("#ToDate").datepicker("setDate", fromDate);
                $("#ToDate").prop("readonly", true);
            }
            else {
                $("#ToDate").prop("readonly", false);
                if (fromDate) {
                    $("#ToDate").datepicker("option", "minDate", fromDate);
                    var toDate = $("#ToDate").datepicker("getDate");
                    if (toDate && toDate < fromDate) {
                        $("#ToDate").datepicker("setDate", fromDate);
                    }
                }
            }
        }

        $(document).ready(function () {
            var dateFormat = "@AdminGeneralHelper.DateFormatForCalendar()";
            // FromDate
            $("#FromDate").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: dateFormat,
                language: "en",
                autoSize: true,
                gotoCurrent: true,
                clearBtn: true,
                showButtonPanel: true,
                closeText: 'Clear',
                maxDate: new Date(),
                onSelect: function () {
                    updateToDate();
                }
            }).on("change", function () { updateToDate(); });

             // ToDate
            $("#ToDate").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: dateFormat,
                language: "en",
                autoSize: true,
                gotoCurrent: true,
                clearBtn: true,
                showButtonPanel: true,
                closeText: 'Clear',
                maxDate: new Date(),
                onSelect: function () {
                    updateToDate();
                }
            });

            $("#ToDate").on("mousedown focus click", function (e) {
                var graphMode = $("#GraphMode").val();
                if (graphMode === "InstantaneousChart") {
                    e.stopImmediatePropagation();
                    e.preventDefault();
                    return false;
                }
            });
            updateToDate();
        });
    </script>
}
