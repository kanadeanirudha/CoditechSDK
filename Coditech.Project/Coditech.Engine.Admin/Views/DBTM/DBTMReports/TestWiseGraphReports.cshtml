@model DBTMGraphListViewModel
@{
    ViewBag.Title = "Activity Reports";
    DropdownViewModel testDropdown = new DropdownViewModel()
            {
        DropdownType = DropdownCustomTypeEnum.DBTMCentreWiseTest.ToString(),
                DropdownName = "DBTMTestMasterId",
                DropdownSelectedValue = Model.DBTMTestMasterId.ToString(),
                IsCustomDropdown = true,
                ChangeEvent = "DBTMReports.GetGraphListByDBTMTestMasterId()",
                Parameter = "IsActive"
            };
    DropdownViewModel traineeDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.DBTMTraineeGraphList.ToString(),
                DropdownName = "DBTMTraineeDetailId",
                DropdownSelectedValue = Model.DBTMTraineeDetailId.ToString(),
                ChangeEvent = "DBTMReports.GetDBTMTestWiseGraphReports()",
                IsCustomDropdown = true
            };
    DropdownViewModel graphModeDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownCustomTypeEnum.GraphMode.ToString(),
                DropdownName = "GraphMode",
                DropdownSelectedValue = Model.GraphMode,
                ChangeEvent = "DBTMReports.GetGraphListByGraphMode()",
                IsCustomDropdown = true
            };
    string url = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<!-- Page Content-->
<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    @*   <div class="card-header">
                    <div class="row align-items-center">
                    <div class="col">
                    <h4 class="card-title">Activity Graph Reports</h4>
                    </div><!--end col-->
                    </div>  <!--end row-->
                    </div> *@
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="card-title">Activity Graph Reports</span>
                        <div class="d-flex align-items-center">
                            <!-- Toggle Switch -->
                            <div class="form-check form-switch me-3">
                                <div class="switch-field">
                                    <input type="radio" id="radio-list" name="switch-tile-list" value="list" onclick="window.open('@($"{url}/dbtmreports/testwisereports")', '_self');" />
                                    <label for="radio-list">List</label>
                                    <input type="radio" id="radio-tile" name="switch-tile-list" value="tile" checked onclick="window.open('@($"{url}/dbtmreports/TestWiseGraphReports")', '_self');" />
                                    <label for="radio-tile">Graph</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-1">
                                <label class="form-label required">Activity List</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", testDropdown)
                            </div>
                            <div class="col-md-1">
                                <label class="form-label required">Trainee List</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", traineeDropdown)
                            </div>
                            <div class="col-md-1">
                                <label class="form-label required">Graph Mode</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", graphModeDropdown)
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-1">
                                <label class="form-label">Graph Type</label>
                            </div>
                            <div class="col-md-11">
                                <div class="mb-3 multiselect-dropdown">
                                    @Html.ListBoxFor(x => x.DBTMSelectedGraph, new SelectList(Model.DBTMGraphMasterList, "Value", "Text"), new { @class = "selectpicker form-control", multiple = "multiple", data_live_search = "true" })
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-center" style="margin-top:10px !important;">
                            <div class="col-md-1">
                                <label id="FromDateLabel" class="form-label">From Date</label>
                            </div>
                            <div class="col-md-3">
                                @Html.TextBoxFor(x => x.FromDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readonly", id = "FromDate" })
                            </div>
                            <div class="col-md-1" id="ToDateLabelWrapper">
                                <label class="form-label">To Date</label>
                            </div>
                            <div class="col-md-3" id="ToDateWrapper">
                                @Html.TextBoxFor(x => x.ToDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readonly", id = "ToDate" })
                            </div>
                            <div class="col-md-1">
                                <button type="button" class="btn btn-success w-100" onclick="DBTMReports.GetDBTMTestWiseGraphReports()">Show</button>
                            </div>
                        </div>
                        <div class="row  mt-3">
                            @* <div class="col-lg-12 h-100"> *@
                                <div id="DBTMTestWiseGraphReportsDivId">
                                </div>
                            @* </div> *@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .switch-field {
        display: flex;
        overflow: hidden;
    }

        .switch-field input {
            position: absolute !important;
            clip: rect(0, 0, 0, 0);
            height: 1px;
            width: 1px;
            border: 0;
            overflow: hidden;
        }

        .switch-field label {
            background-color: #e4e4e4;
            color: rgba(0, 0, 0, 0.6);
            font-size: 14px;
            line-height: 1;
            text-align: center;
            padding: 8px 16px;
            margin-right: -1px;
            border: 1px solid rgba(0, 0, 0, 0.2);
            transition: all 0.2s ease-in-out;
            cursor: pointer;
        }

            .switch-field label:hover {
                background-color: rgba(255, 184, 34, 0.6);
                color: #000;
            }

        .switch-field input:checked + label {
            background-color: rgb(255, 184, 34);
            color: #000;
            font-weight: 600;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
            border-color: rgb(230, 165, 30);
        }

        .switch-field label:active {
            background-color: rgb(230, 165, 30);
            color: #fff;
        }

        .switch-field label:first-of-type {
            border-radius: 4px 0 0 4px;
        }

        .switch-field label:last-of-type {
            border-radius: 0 4px 4px 0;
        }

    .multiselect-dropdown {
        margin-bottom: 0 !important;
    }

    .activity-date a {
        background-color: #198754 !important;
        color: #fff !important;
        font-weight: 600;
        border-radius: 4px;
    }
</style>
<script src="~/js/coditech/DBTM/DBTMReports.js"></script>
@section scripts {
    <script type="text/javascript">
        var activityPerformedDates = [];
        function applyGraphModeUI() {
            var mode = $("#GraphMode").val();
            if (mode === "InstantaneousChart") {
                $("#ToDateLabelWrapper").hide();
                $("#ToDateWrapper").hide();
                $("#FromDateLabel").text("Date");
                var fromDate = $("#FromDate").datepicker("getDate");
                if (fromDate) {
                    $("#ToDate").datepicker("setDate", fromDate);
                }
                $("#ToDate").datepicker("disable");
            }
            else {
                $("#ToDateLabelWrapper").show();
                $("#ToDateWrapper").show();
                $("#FromDateLabel").text("From Date");
                $("#ToDate").datepicker("enable");
            }
        }

        function updateToDate() {
            var mode = $("#GraphMode").val();
            var fromDate = $("#FromDate").datepicker("getDate");

            if (mode !== "InstantaneousChart" && fromDate) {
                $("#ToDate").datepicker("option", "minDate", fromDate);
                var toDate = $("#ToDate").datepicker("getDate");
                if (toDate && toDate < fromDate) {
                    $("#ToDate").datepicker("setDate", fromDate);
                }
            }
        }

        function formatDate(d) {
            return d.getFullYear() + "-"
                + String(d.getMonth() + 1).padStart(2, "0") + "-"
                + String(d.getDate()).padStart(2, "0");
        }
        $(document).ready(function () {
            var dateFormat = "@AdminGeneralHelper.DateFormatForCalendar()";

            $("#FromDate").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: dateFormat,
                maxDate: new Date(),

                beforeShowDay: function (date) {
                    var d = formatDate(date);

                    if (activityPerformedDates.includes(d)) {
                        return [true, "activity-date", "Activity Performed"];
                    }
                        return [false, "", "No activity on this date"];
                },

                onSelect: function () {
                    updateToDate();
                    applyGraphModeUI();
                }
            });

            $("#ToDate").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: dateFormat,
                maxDate: new Date(),

                beforeShowDay: function (date) {
                    var d = formatDate(date);

                    if (activityPerformedDates.includes(d)) {
                        return [true, "activity-date", "Activity Performed"];
                    }
                       return [false, "", "No activity on this date"];
                },

                onSelect: function () {
                    updateToDate();
                }
            });
            $("#ToDate").on("mousedown focus click", function (e) {
                if ($("#GraphMode").val() === "InstantaneousChart") {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                }
            });
            applyGraphModeUI();
        });
    </script>
}