@using Newtonsoft.Json
@using System.Data
@model DBTMGraphListViewModel
@{
    Layout = null;

    var xValues = Model.XValues;
    var datasets = new List<LineGraphsDatasetViewModel>();
    var colors = Model.Colors;
    int colorIndex = 0;
}
@if (!Model.IsRecordFound || Model.DataTable?.Rows.Count == 0)
{
    <div>No record found</div>
}
else
{
    foreach (DataRow row in Model.DataTable.Rows)
    {
        string performedOn = row["Activity Performed"]?.ToString();

        double abTime = Convert.ToDouble(row["A-B-Time"].ToString().Split(' ')[0]);
        double bcTime = Convert.ToDouble(row["B-C-Time"].ToString().Split(' ')[0]);
        double caTime = Convert.ToDouble(row["C-A-Time"].ToString().Split(' ')[0]);

        double abVelocity = Convert.ToDouble(row["A-B-Velocity"].ToString().Split(' ')[0]);
        double bcVelocity = Convert.ToDouble(row["B-C-Velocity"].ToString().Split(' ')[0]);
        double caVelocity = Convert.ToDouble(row["C-A-Velocity"].ToString().Split(' ')[0]);

        if (Model.GraphType == "DistanceTime")
        {
            datasets.Add(new LineGraphsDatasetViewModel
                        {
                            Label = $"Time ({performedOn})",
                            Data = JsonConvert.SerializeObject(new List<double> { 0, abTime, bcTime, caTime }),
                            Color = colors[colorIndex++ % colors.Count]
                        });
        }
        else if (Model.GraphType == "DistanceVelocity")
        {
            datasets.Add(new LineGraphsDatasetViewModel
                        {
                            Label = $"Velocity ({performedOn})",
                            Data = JsonConvert.SerializeObject(new List<double> { 0, abVelocity, bcVelocity, caVelocity }),
                            Color = colors[colorIndex++ % colors.Count]
                        });
        }
        else if (Model.GraphType == "TimeAndVelocity")
        {
            datasets.Add(new LineGraphsDatasetViewModel
                        {
                            Label = $"Time ({performedOn})",
                            Data = JsonConvert.SerializeObject(new List<double> { 0, abTime, bcTime, caTime }),
                            Color = colors[colorIndex++ % colors.Count]
                        });

            datasets.Add(new LineGraphsDatasetViewModel
                        {
                            Label = $"Velocity ({performedOn})",
                            Data = JsonConvert.SerializeObject(new List<double> { 0, abVelocity, bcVelocity, caVelocity }),
                            Color = colors[colorIndex++ % colors.Count]
                        });
        }
    }

    if (datasets.Any())
    {
        var chartModel = new LineGraphsViewModel
                    {
                        LineChartId = "multiLineChart_" + Guid.NewGuid().ToString("N"),
                        Title = Model.Title,
                        XAxisLabel = Model.XAxisLabel,
                        YAxisLabel = Model.YAxisLabel,
                        XValues = Model.XValues,
                        Datasets = datasets
                    };

        @Html.Partial("~/Views/Shared/ActivityGraphs/_LineGraphs.cshtml", chartModel)
    }
}