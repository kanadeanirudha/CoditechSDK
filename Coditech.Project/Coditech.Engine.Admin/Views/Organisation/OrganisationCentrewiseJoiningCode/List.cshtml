@model OrganisationCentrewiseJoiningCodeListViewModel
@{
    ViewBag.Title = "Organisation Centrewise Joining Code List";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    bool IsCentreOrTrainer = false;
    DropdownViewModel centreDropdown = new DropdownViewModel()
            {
                DropdownType = DropdownTypeEnum.AccessibleCentre.ToString(),
                DropdownName = "SelectedCentreCode",
                DropdownSelectedValue = Model.SelectedCentreCode,
                ChangeEvent = "OrganisationCentrewiseJoiningCode.JoiningCodeListByCentreCodeList()"
            };

    DropdownViewModel joiningCodeType = new DropdownViewModel()
            {
                DropdownType = DropdownTypeEnum.OrganisationJoiningCodeType.ToString(),
                DropdownName = "JoiningCodeTypeEnumId",
                DropdownSelectedValue = string.IsNullOrEmpty(Model.JoiningCodeTypeEnumId.ToString())
                        || Model.JoiningCodeTypeEnumId == 0
                        ? "0"
                        : Model.JoiningCodeTypeEnumId.ToString(),
                GroupCode = DropdownTypeEnum.OrganisationJoiningCodeType.ToString(),
                SelectedText = "All",
                SelectedValue = "0",
                ChangeEvent = "OrganisationCentrewiseJoiningCode.JoiningCodeListByCentreCodeList()"
            };
    DropdownViewModel joiningCodeStatus = new DropdownViewModel()
            {
                DropdownType = DropdownTypeEnum.JoiningCodeStatus.ToString(),
                DropdownName = "SelectedParameter2",
                DropdownSelectedValue = string.IsNullOrEmpty(Model.SelectedParameter2) ? "0" : Model.SelectedParameter2,
                SelectedText = "All",
                SelectedValue = "0",
                ChangeEvent = "OrganisationCentrewiseJoiningCode.JoiningCodeListByCentreCodeList()"
            };
    UserModel userModel = SessionHelper.GetDataFromSession<UserModel>(AdminConstants.UserDataSession);
    if (userModel.Custom1 == CustomConstants.DBTMCentreOwner || userModel.Custom1 == CustomConstants.DBTMTrainer)
    {
        IsCentreOrTrainer = true;
    }
}
<!-- Hidden field to pass user type to JS -->
<input type="hidden" id="DBTMCurrentUserType" value="@userModel?.Custom1" />

<div class="page-content mt-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Joining Code List</span>
                        @if (IsCentreOrTrainer)
                        {
                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-success"
                                        onclick="DBTMOrganisationCentrewiseJoiningCode.DownloadTraineeJoiningCode()">
                                    <i class="fas fa-download me-2"></i>Download Trainee Joining Code
                                </button>

                                @if (userModel.Custom1 == CustomConstants.DBTMCentreOwner)
                                {
                                    <a class="btn btn-sm btn-soft-primary float-end" href="/@controllerName/Create" role="button">
                                        <i class="fas fa-plus me-2"></i>Create Joining Code
                                    </a>
                                }
                            </div>
                        }
                    </div>

                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-1">
                                <label>@AdminResources.LabelCentre</label>
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", centreDropdown)
                            </div>
                            <div class="col-md-1">
                                <label>Joining Code Type</label>
                            </div>
                            <div class="col-md-2">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", joiningCodeType)
                            </div>
                            <div class="col-md-1">
                                <label>Joining Code Status</label>
                            </div>
                            <div class="col-md-2">
                                @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", joiningCodeStatus)
                            </div>
                            <div class="col-md-2">
                                <input type="button" class="btn btn-success" value="Show" id="ShowDataId"
                                       onclick="OrganisationCentrewiseJoiningCode.JoiningCodeListByCentreCodeList()" />
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold">

                                    Total Joining Code:  <span class="badge badge-soft-primary me-2 "><span id="TotalCodeCount"></span> </span>

                                    Total Active Joining Code: <span class="badge badge-soft-success me-2"> <span id="ActiveCodeCount"></span> </span>

                                    Total Used Joining Code: <span class="badge badge-soft-danger"> <span id="ExpiredCodeCount"></span> </span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div id="DataTablesDivId" class="dataTables_wrapper dt-bootstrap5 no-footer">
                            @Html.Partial("~/Views/Organisation/OrganisationCentrewiseJoiningCode/_List.cshtml", Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<iframe id="hiddenDownloader" style="display:none;"></iframe>

<!-- jQuery CDN (if not already loaded) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/coditech/Organisation/OrganisationCentrewiseJoiningCode.js"></script>
<script src="~/js/coditech/DBTM/DBTMOrganisationCentrewiseJoiningCode.js"></script>

<script>
    $(document).ready(function () {
        // ===== Dynamic JoiningCodeTypeEnumId dropdown logic =====
        var userType = $("#DBTMCurrentUserType").val(); // "dbtmtrainer" ya normal user
        var $dropdown = $("#JoiningCodeTypeEnumId");

        if(userType && userType.toLowerCase() === "dbtmtrainer") {
            // Remove "All" and "Trainer" options
            $dropdown.find('option').each(function() {
                var text = $(this).text().trim();
                if(text === "All" || text === "Trainer") {
                    $(this).remove();
                }
            });

            // Default select "Trainee"
            var traineeOption = $dropdown.find('option').filter(function() {
                return $(this).text().trim() === "Trainee";
            });
            if(traineeOption.length) {
                $dropdown.val(traineeOption.val());
            }
        } else {
            // Normal user select "All"
            var allOption = $dropdown.find('option').filter(function() {
                return $(this).text().trim() === "All";
            });
            if(allOption.length) {
                $dropdown.val(allOption.val());
            }
        }

        // Refresh Bootstrap selectpicker if used
        if($dropdown.hasClass("selectpicker")) {
            $dropdown.selectpicker('refresh');
        }

        // ===== Update total counts after AJAX =====
        const checkCounts = setInterval(function () {
            const $active = $('#AjaxActiveCodeCount');
            const $expired = $('#AjaxExpiredCodeCount');
            const $total = $('#AjaxTotalJoiningCodeCount');
            if ($active.length && $expired.length && $total.length &&
                $active.text().trim() !== '' && $expired.text().trim() !== '' && $total.text().trim() !== '') {
                const active = parseInt($active.text()) || 0;
                const expired = parseInt($expired.text()) || 0;
                const total = parseInt($total.text()) || 0;
                $('#ActiveCodeCount').text(active);
                $('#ExpiredCodeCount').text(expired);
                $('#TotalCodeCount').text(total);
                clearInterval(checkCounts);
            }
        }, 300);
    });
</script>
