@model GeneralTraineeAssociatedToTrainerViewModel
@{
    Layout = null;
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
}
<div class="modal-header">
    @if (Model.GeneralTraineeAssociatedToTrainerId > 0)
    {
        <h6 class="modal-title m-0">UnAssociate Trainer</h6>
    }
    else
    {
        <h6 class="modal-title m-0">Associate Trainer</h6>
    }
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
@using (Html.BeginForm("AssociateUnAssociateTrainer", controllerName, FormMethod.Post, new { id = "frmAssociateUnAssociateTrainer" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.GeneralTraineeAssociatedToTrainerId)
    @Html.HiddenFor(x => x.DBTMTraineeDetailId)
    @Html.HiddenFor(x => x.EntityId)
    @Html.HiddenFor(x => x.GeneralTrainerMasterId)
    @Html.HiddenFor(x => x.PersonId)
    <div class="modal-body">
        <div class="row">
            <div class="col-lg-12">
                <div class="mb-3">
                    @if (Model.GeneralTraineeAssociatedToTrainerId > 0)
                    {
                        <span>
                            Are you sure that you want to unassociate
                            <span class="font-15">@Model.FirstName @Model.LastName</span> as current trainer?
                        </span>
                    }
                    else
                    {
                        <span>
                            Are you sure that you want to associate
                            <span class="font-15">@Model.FirstName @Model.LastName</span> as current trainer?
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-success" onclick="GeneralTrainerMaster.AssociateUnAssociateTrainer(); return false;"> @AdminResources.LabelSave</button>
        <button type="button" class="btn btn-soft-secondary btn-sm" data-bs-dismiss="modal"> Close </button>
    </div>
}
@Html.Partial("_ValidationScriptsPartial")