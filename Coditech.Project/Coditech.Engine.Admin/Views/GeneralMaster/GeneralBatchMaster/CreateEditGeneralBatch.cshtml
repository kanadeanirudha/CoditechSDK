@model GeneralBatchViewModel
@{
    bool isPopup = Convert.ToString(ViewBag.IsPopup).ToLower() == "true" || !string.IsNullOrEmpty(Model.Custom4);
    if (isPopup)
    {
        Layout = "~/Views/Shared/_LayoutCustomMobile.cshtml";
        ViewBag.IsDashboardPopup = "true";
    }
    ViewBag.Title = Model.GeneralBatchMasterId > 0 ? "Update Batch Details" : "Add Batch";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    string css = Model.GeneralBatchMasterId > 0 ? "col-12 col-md-10" : "col-12";
    Dictionary<string, string> keyValuePairs = new Dictionary<string, string>();
    keyValuePairs.Add("GeneralBatchMasterId", Model.GeneralBatchMasterId.ToString());
    keyValuePairs.Add("Custom4", Model.Custom4?.ToString() ?? string.Empty);
    DropdownViewModel centreDropdown = new DropdownViewModel() { DropdownType = DropdownTypeEnum.AccessibleCentre.ToString(), DropdownName = "CentreCode", DropdownSelectedValue = Model.CentreCode, ChangeEvent = "DBTMBatch.OnCentreChange()", IsDisabled = Model.GeneralBatchMasterId > 0 };
    DropdownViewModel frequencyDropdown = new DropdownViewModel() { DropdownType = DropdownTypeEnum.SchedulerFrequency.ToString(), DropdownName = "BatchFrequency", DropdownSelectedValue = Model.BatchFrequency, ExcludedValues = new string[] { "Recurring", "Weekly" } };
    bool isTrainer = Convert.ToString(ViewBag.IsTrainer).ToLower() == "true";
    string cancelUrl = (isPopup && !isTrainer) ? "" : ((isPopup || !string.IsNullOrEmpty(Model.Custom4)) ? Url.Action("Cancel", "DBTMGeneralBatchMaster", new { SelectedCentreCode = Model.CentreCode, custom4 = string.IsNullOrEmpty(Model.Custom4) ? "Mobile View" : Model.Custom4 }) : Url.Action("Cancel", "DBTMGeneralBatchMaster", new { SelectedCentreCode = Model.CentreCode }));
    PageHeaderViewModel headerModel = new PageHeaderViewModel
            {
                Title = ViewBag.Title,
                SaveButtonText = GeneralResources.SaveButtonText,
                CancelUrl = cancelUrl,
                CancelButtonText = GeneralResources.CancelButtonText,
                ControllerName = controllerName,
                ActionName = actionName,
                FormId = AdminConstants.FormId + controllerName,
            };
    ModelPopUpViewModel transferBatchPopup = new ModelPopUpViewModel() { ModelPopUpId = "TransferBatchPopupId", ModalContentId = "TransferBatchContentId" };
}
<!-- Page Content-->
<div class="@(isPopup ? "" : "page-content")">
    @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
    <div class="container-fluid @(isPopup ? "pt-5 mt-5" : "mt-5")">
        <div class="row">
            @if (Model.GeneralBatchMasterId > 0)
            {
                <div class="col-12 col-md-2">
                    @Html.Partial("~/Views/GeneralMaster/GeneralBatchMaster/_GeneralBatchSidePannel.cshtml", keyValuePairs)
                </div>
            }
            <div class="@css">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                        {
                            @Html.HiddenFor(m => m.GeneralBatchMasterId)
                            @Html.HiddenFor(x => x.WeekDays)
                            @Html.HiddenFor(x => x.Custom4)
                            @Html.HiddenFor(x => x.Custom5)
                            <input type="hidden" name="ispopup" value="@Convert.ToString(ViewBag.IsPopup)" />
                            <input type="hidden" name="istrainer" value="@Convert.ToString(ViewBag.IsTrainer)" />
                            @if (Model.GeneralBatchMasterId > 0)
                            {
                                @Html.HiddenFor(x => x.CentreCode)
                            }
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.CentreCode, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", centreDropdown)
                                        @Html.ValidationMessageFor(x => x.CentreCode)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.BatchName, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.BatchName, new { @class = "form-control", @onkeypress = "return CoditechCommon.AllowAlphabetWithSpacingAndNumbers()" })
                                        @Html.ValidationMessageFor(x => x.BatchName)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.BatchFrequency, new { @class = "form-label required" })
                                        @Html.Partial("~/Views/Shared/Control/_DropdownList.cshtml", frequencyDropdown)
                                        @Html.ValidationMessageFor(x => x.BatchFrequency)
                                    </div>
                                </div>
                                @* <div class="row">                              
                                    <div class="col-lg-12" id="weeklyDiv">
                                        <div class="mb-3 multiselect-dropdown">
                                            @Html.LabelFor(x => x.SelectedWeekDays, new { @class = "form-label required" })
                                            @Html.ListBoxFor(x => x.SelectedWeekDays, new SelectList(Model.SchedulerWeekDaysList, "Value", "Text"), new { @class = "selectpicker form-control", multiple = "multiple", data_live_search = "true" })
                                            @Html.ValidationMessageFor(x => x.SelectedWeekDays)
                                        </div>
                                    </div>
                                </div> *@
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.BatchStartDate, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.BatchStartDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control", @readonly = "readOnly" })
                                        @Html.ValidationMessageFor(x => x.BatchStartDate)
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.BatchExpireDate, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.BatchExpireDate, AdminGeneralHelper.DateFormatForTextBox(), new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.BatchExpireDate)
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.BatchStartTime, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.BatchStartTime, new { @class = "form-control", type = "time" })
                                        @Html.ValidationMessageFor(x => x.BatchStartTime)
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.Duration, new { @class = "form-label required" })
                                        <div class="d-flex gap-3">
                                            @Html.DropDownListFor(x => x.DurationHours,
                                                     new SelectList(Enumerable.Range(0, 12).Select(i => new { Value = i.ToString("D2"), Text = i.ToString("D2") }),
                                                     "Value", "Text"),
                                                     "HH",
                                                     new { @class = "form-select", id = "DurationHours" })

                                            @Html.DropDownListFor(x => x.DurationMinutes,
                                                     new SelectList(Enumerable.Range(0, 60).Where(i => i % 5 == 0).Select(i => new { Value = i.ToString("D2"), Text = i.ToString("D2") }),
                                                     "Value", "Text"),
                                                     "MM",
                                                     new { @class = "form-select", id = "DurationMinutes" })
                                        </div>
                                        @Html.ValidationMessageFor(x => x.Duration)
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.IsActive, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12" id="ActivityDropdownDiv">
                                    @Html.Partial("~/Views/GeneralMaster/GeneralBatchMaster/_ActivityDropdown.cshtml", Model)
                                </div>
                                @if (Model.GeneralBatchMasterId == 0)
                                {
                                    <div class="col-lg-12">
                                        <div class="mb-3 multiselect-dropdown">
                                            <label class="form-label" for="CustomDropdownSelectedValue2">Batch User</label>
                                            @Html.ListBoxFor(x => x.CustomDropdownSelectedValue2, new SelectList(Model.CustomDropdownList2, "Value", "Text"), new { @class = "selectpicker form-control", multiple = "multiple", data_live_search = "true" })
                                            @Html.ValidationMessageFor(x => x.CustomDropdownSelectedValue2)
                                        </div>
                                    </div>
                                }
                               @*  @if (Model.GeneralBatchMasterId > 0)
                                {
                                    <div class="col-lg-3 mt-3">
                                        <button type="button"
                                                class="btn btn-sm btn-soft-primary btn-circle"
                                                data-bs-toggle="modal"
                                                data-bs-target="#TransferBatchPopupId"
                                                onclick="DBTMBatch.OpenTransferBatchPopup('TransferBatchContentId', @Model.GeneralBatchMasterId)">
                                            <i class="fas fa-exchange-alt"></i> Transfer Batch
                                        </button>
                                    </div>
                                } *@
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .stack-blur {
        filter: blur(4px);
        pointer-events: none;
    }
    #notificationDivId {
        position: fixed;
        z-index: 9999;
    }
    .spinner,
    .coditech-loader,
    #divLodder {
        position: fixed !important;
        z-index: 99999 !important;
    }
</style>
@Html.Partial("~/Views/Shared/_ModelPopUp.cshtml", transferBatchPopup)
@section scripts {
    <script src="~/js/coditech/Common/CoditechCommon.js"></script>
    <script src="~/js/coditech/DBTM/DBTMBatch.js"></script>
    <script type="text/javascript">
        function updateExpiryDate() {
            var selectedFrequency = $("#BatchFrequency").val();
            var startDate = $("#BatchStartDate").datepicker("getDate");
            if (selectedFrequency === "Weekly") {
                $("#weeklyDiv").show();
            } else {
                $("#weeklyDiv").hide();
            }
            if (!startDate) return;
            $("#BatchExpireDate").datepicker("option", "minDate", startDate);
            if (selectedFrequency === "OneTime") {
                $("#BatchExpireDate").datepicker("setDate", startDate).datepicker("disable");
            } else {
                $("#BatchExpireDate").datepicker("enable");
                if (!$("#BatchExpireDate").val()) {
                    $("#BatchExpireDate").datepicker("setDate", startDate);
                }
            }
        }
        $(document).ready(function () {
            $("#BatchFrequency").change(function () {
                updateExpiryDate();
            });
            DBTMBatch.Initialize();
            var today = new Date();
            var maxFutureDate = new Date(
            today.getFullYear() + 10,
            today.getMonth(),
            today.getDate()
        );
            // Start Date Datepicker
           $("#BatchStartDate").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: "@AdminGeneralHelper.DateFormatForCalendar()",
            language: "en",
            autoSize: true,
            minDate: 0,
            maxDate: maxFutureDate,
            onSelect: function (dateText) {
                var startDate = $(this).datepicker("getDate");
                $("#BatchExpireDate").datepicker("option", "minDate", startDate);
                updateExpiryDate();
            }
        });
        // Expiry Date Datepicker
        $("#BatchExpireDate").datepicker({
                    changeMonth: true,
                    changeYear: true,
                    dateFormat: "@AdminGeneralHelper.DateFormatForCalendar()",
                    language: "en",
                    autoSize: true,
                    yearRange: "c-0:c+10",
                    minDate: 0,
                    maxDate: maxFutureDate
        });
        if ($("#GeneralBatchMasterId").val() == 0) {
            var startVal = $("#BatchStartDate").val();
                if (startVal) {
                    $("#BatchStartDate").datepicker("setDate", startVal);
                }
                updateExpiryDate();
             }
        });

        $('form').submit(function (e) {
            var hours = $('#DurationHours').val();
            var minutes = $('#DurationMinutes').val();
                if (hours === "00" && minutes === "00") {
                    var validationSpan = $('[data-valmsg-for="Duration"]');
                    validationSpan.text("Duration cannot be 00 Hours and 00 Minutes.");
                    validationSpan.addClass("field-validation-error").removeClass("field-validation-valid");
                    e.preventDefault();
                } else {
                    var validationSpan = $('[data-valmsg-for="Duration"]');
                    validationSpan.text("");
                    validationSpan.addClass("field-validation-valid").removeClass("field-validation-error");
                }
                var frequency = $("#BatchFrequency").val();
                    if (frequency === "Weekly") {
                        var selectedWeekDays = $("#SelectedWeekDays option:selected").length;
                            if (selectedWeekDays === 0) {
                                var validationSpan = $('[data-valmsg-for="SelectedWeekDays"]');
                                    validationSpan.text("Please select at least one Week Day.");
                                    validationSpan.addClass("field-validation-error").removeClass("field-validation-valid");
                                    e.preventDefault();
                           }
                    }
                var startDate = $("#BatchStartDate").datepicker("getDate");
                var expiryDate = $("#BatchExpireDate").datepicker("getDate");

                if (startDate && expiryDate && expiryDate < startDate) {
                    var validationSpan = $('[data-valmsg-for="BatchExpireDate"]');
                        validationSpan.text("Expiry Date cannot be before Start Date.");
                        validationSpan.addClass("field-validation-error").removeClass("field-validation-valid");
                        e.preventDefault();
                } else {
                            var validationSpan = $('[data-valmsg-for="BatchExpireDate"]');
                                validationSpan.text("");
                                validationSpan.addClass("field-validation-valid").removeClass("field-validation-error");
                        }
             });
    </script>
}
