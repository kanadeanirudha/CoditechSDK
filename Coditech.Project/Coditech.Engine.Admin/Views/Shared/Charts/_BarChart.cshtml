@model BarChartModel
@{
    Layout = null;
}
<canvas id="@Model.BarChartId"></canvas>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
<script>
    var xValues = @Html.Raw(Model.XValues);
    var datasets = [];

    @foreach (var dataset in Model.Datasets)
    {
        <text>
            datasets.push({
                label: "@dataset.Label",
                data: @Html.Raw(dataset.Data),
                fill: false,
                backgroundColor: "@dataset.Color",
                borderColor: "rgba(42, 118, 244, 0.5)",
                borderWidth: 1,
                tension: 0.4
            });
        </text>
    }

        new Chart("@Model.BarChartId", {
            type: "bar",
            data: {
                labels: xValues,
                datasets: datasets
            },
            options: {
                title: {
                    display: true,
                    text: '@Model.Title'
                },
                scales: {
                    xAxes: [{
                        display: true,
                        scaleLabel: {
                            display: true,
                            labelString: '@Model.XAxisLabel'
                        }
                    }],
                    yAxes: [{
                        display: true,
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1,
                            callback: function (value) {
                                if (Number.isInteger(value)) {
                                    return value;
                                }
                            }
                        },
                        scaleLabel: {
                            display: true,
                            labelString: '@Model.YAxisLabel'
                        }
                    }]
                }
            }
        });
</script>