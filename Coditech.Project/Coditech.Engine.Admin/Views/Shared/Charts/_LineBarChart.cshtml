@model LineBarChartModel
@{
    Layout = null;
    var chartId = $"{Model.LineBarChartId}_{Guid.NewGuid().ToString("N")}";
}

<div class="chart-container" style="position:relative; height:400px; width:100%;">
    <canvas id="@chartId"></canvas>
</div>

<script>
    (function () {
        var ctx = document.getElementById('@chartId').getContext('2d');
        var xValues = @Html.Raw(Model.XValues);
        var datasets = [];

    @if (Model.GraphType == "BarChart" || Model.GraphType == "bar")
    {
        @foreach (var dataset in Model.Datasets)
        {
            <text>
                     datasets.push({
                     label: "@dataset.Label",
                     data: @Html.Raw(dataset.Data),
                           backgroundColor: "#dc3545",
                           borderColor: "#dc3545",
                           borderWidth: 2
                     });
            </text>
        }
    }
    else
    {
        @foreach (var dataset in Model.Datasets)
        {
            <text>
                    datasets.push({
                        label: "@dataset.Label",
                        data: @Html.Raw(dataset.Data),
                        fill: false,
                        borderColor: "@dataset.Color",
                        borderWidth: 2,
                        tension: 0.4
                    });
            </text>
        }
    }
    var textColor = getComputedStyle(document.body).color;
            new Chart(ctx, {
                type: "@Model.GraphType.ToLower()",
                data: {
                    labels: xValues,
                    datasets: datasets
                },
                    options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    legend: {
                        labels: {
                            fontColor: textColor
                        }
                    },
                    title: {
                        display: true,
                        text: '@Model.Title',
                        fontColor: textColor
                    },
                    scales: {
                        xAxes: [{
                            display: true,
                            ticks: {
                                fontColor: textColor
                            },
                            scaleLabel: {
                                display: true,
                                labelString: '@Model.XAxisLabel',
                                fontColor: textColor
                            }
                        }],
                        yAxes: [{
                            display: true,
                            ticks: {
                                fontColor: textColor
                            },
                            scaleLabel: {
                                display: true,
                                labelString: '@Model.YAxisLabel',
                                fontColor: textColor
                            }
                        }]
                    }
                }
            });
    })();
</script>
