@model LineBarChartModel
@{
    Layout = null;
    var chartId = $"{Model.LineBarChartId}_{Guid.NewGuid().ToString("N")}";
}

<div class="chart-container" style="position:relative; height:400px; width:100%;">
    <canvas id="@chartId"></canvas>
</div>

<script>
    (function () {
        var ctx = document.getElementById('@chartId').getContext('2d');
        var xValues = @Html.Raw(Model.XValues);
        var datasets = [];

    @if (Model.GraphType == "BarChart")
    {
        @foreach (var dataset in Model.Datasets)
        {
            <text>
                    datasets.push({
                        label: "@dataset.Label",
                        data: @Html.Raw(dataset.Data),
                        backgroundColor: "@dataset.Color",
                        borderColor: "@dataset.Color",
                        borderWidth: 2,
                        tension: 0.4
                    });
            </text>
        }
    }
    else
    {
        @foreach (var dataset in Model.Datasets)
        {
            <text>
                    datasets.push({
                        label: "@dataset.Label",
                        data: @Html.Raw(dataset.Data),
                        fill: false,
                        borderColor: "@dataset.Color",
                        borderWidth: 2,
                        tension: 0.4
                    });
            </text>
        }
    }

            new Chart(ctx, {
                type: "@Model.GraphType.ToLower()",
                data: {
                    labels: xValues,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    title: {
                        display: true,
                        text: '@Model.Title'
                    },
                    scales: {
                        xAxes: [{
                            display: true,
                            scaleLabel: { display: true, labelString: '@Model.XAxisLabel' }
                        }],
                        yAxes: [{
                            display: true,
                            scaleLabel: { display: true, labelString: '@Model.YAxisLabel' }
                        }]
                    }
                }
            });
    })();
</script>
