@model List<GraphModel>

@if (Model != null && Model.Any())
{
    foreach (var graph in Model)
    {
        <div class="graph-wrapper my-2">
            <h5 class="text-center font-weight-bold mb-3">
                @graph.GraphName
            </h5>

            @if (graph.GraphType == "LineChart" || graph.GraphType == "BarChart")
            {
                @Html.Partial("~/Views/Shared/Charts/_LineBarChart.cshtml", graph.LineChartModel)
            }
            else if (graph.GraphType == "PieChart")
            {
                @Html.Partial("~/Views/Shared/Charts/_PieChart.cshtml", graph.PieChartModel)
            }
        </div>
    }
}
else
{
    <p>No graphs found.</p>
}
<style>
    .graph-wrapper {
        padding-top: 20px;
        padding-bottom: 30px;
        border-bottom: 1px solid #eee;
    }

        .graph-wrapper h5 {
            margin-bottom: 20px !important;
        }
</style>