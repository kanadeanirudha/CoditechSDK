@model LineGraphsViewModel
<canvas id="@Model.LineChartId"></canvas>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
<script>
    var xValues = @Html.Raw(Model.XValues);
    var datasets = [];

    @foreach (var dataset in Model.Datasets)
    {
        <text>
                datasets.push({
                    label: "@dataset.Label",
                    data: @Html.Raw(dataset.Data),
                    fill: false,
                    borderColor: "@dataset.Color",
                    borderWidth: 2,
                    tension: 0.4
                });
        </text>
    }

     new Chart("@Model.LineChartId", {
        type: "line",
        data: {
            labels: xValues,
            datasets: datasets
        },
        options: {
            animation: {
                duration: 0
            },
            title: {
                display: true,
                text: '@Model.Title'
            },
            scales: {
                xAxes: [{
                    display: true,
                    scaleLabel: {
                        display: true,
                        labelString: '@Model.XAxisLabel'
                    }
                }],
                yAxes: [{
                    display: true,
                    scaleLabel: {
                        display: true,
                        labelString: '@Model.YAxisLabel'
                    }
                }]
            }
        }
    });
</script>