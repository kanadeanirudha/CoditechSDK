@model BarChartViewModel
<canvas id="@Model.BarChartId"></canvas>
<script>
    var xValues = @Html.Raw(Model.XValues);
    var yValues = @Html.Raw(Model.YValues);
    var bgColors = @Html.Raw(Model.BackgroundColor);

    new Chart(document.getElementById("@Model.BarChartId"), {
        type: "bar",
        data: {
            labels: xValues,
            datasets: [{
                label: "@Model.Title",
                data: yValues,
                backgroundColor: bgColors,
                borderColor: "rgba(255, 99, 132, 1)",
                borderWidth: 1
            }]
        },
        options: {
            title: {
                display: true,
                text: '@Model.Title',
                fontSize: 18
            },
            legend: {
                display: false
            },
            scales: {
                yAxes: [{
                    ticks: {
                        beginAtZero: true
                    },
                    scaleLabel: {
                        display: true,
                        labelString: '@Model.YAxisLabel'
                    }
                }],
                xAxes: [{
                    scaleLabel: {
                        display: true,
                        labelString: '@Model.XAxisLabel'
                    }
                }]
            },
            animation: {
                duration: 1000,
                easing: 'easeOutBounce'
            }
        }
    });
</script>
