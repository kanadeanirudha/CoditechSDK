@using System.Data
@model DBTMReportsListViewModel
@{
    Layout = null;
    var tableIndex = 1;
}

<div class="accordion" id="accordionExample">
    @if (Model?.DataTableList != null && Model.DataTableList.Count > 0)
    {
        foreach (var keyValue in Model.DataTableList)
        {
            var collapseId = $"collapse{tableIndex}";
            var headingId = $"heading{tableIndex}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button fw-bold @(tableIndex > 1 ? "collapsed" : "")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="@(tableIndex == 1 ? "true" : "false")"
                            aria-controls="@collapseId">
                        @keyValue.Key
                    </button>
                </h2>
                <div id="@collapseId"
                     class="accordion-collapse collapse @(tableIndex == 1 ? "show" : "")"
                     aria-labelledby="@headingId"
                     data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <div class="table-responsive">
                            <table id="datatable-@tableIndex" class="action-set table table-striped table-bordered dt-responsive nowrap dataTable no-footer dtr-inline"
                                   style="border-collapse: collapse; border-spacing: 0px; width: 100%;" role="grid">
                                <thead>
                                    <tr>
                                        @foreach (DataColumn col in keyValue.Value.Columns)
                                        {
                                            var parts = col.ColumnName.Split('~');
                                            var displayName = parts[0];
                                            var helpText = parts.Length > 1 ? parts[1] : string.Empty;

                                            <th>
                                                @displayName
                                                @if (!string.IsNullOrEmpty(helpText))
                                                {
                                                    <span class="ms-1 text-info" data-bs-toggle="tooltip" data-bs-placement="top" title="@helpText" style="cursor:pointer;">
                                                        <i class="fas fa-info-circle"></i>
                                                    </span>
                                                }
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (keyValue.Value.Rows.Count > 0)
                                    {
                                        foreach (DataRow row in keyValue.Value.Rows)
                                        {
                                            <tr>
                                                @foreach (DataColumn col in keyValue.Value.Columns)
                                                {
                                                    string[] value = row[col].ToString().Split('~');
                                                    string style = string.Empty;
                                                    if (value.Length > 1)
                                                    {
                                                        style = value[1] == "True" ? "font-weight: bold;" : "";
                                                        if (!string.IsNullOrEmpty(value[2].ToString()))
                                                        {
                                                            style = $"{style} color: #{value[2]};";
                                                        }
                                                    }
                                                    <td style="@style">@value[0]</td>
                                                }
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="@keyValue.Value.Columns.Count" class="text-danger fw-bold text-center">
                                                No Result Found
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            tableIndex++;
        }
    }
    else
    {
        <div class="text-danger fw-bold text-center">No Data Found</div>
    }
</div>
<style>
    #accordionExample .accordion-item:first-child {
        margin-top: 0 !important;
        padding-top: 0 !important;
    }

        #accordionExample .accordion-item:first-child .accordion-header {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }

        #accordionExample .accordion-item:first-child .accordion-button {
            margin-top: 0 !important;
            padding-top: 4px !important;
        }
</style>
@section scripts {
    <script>
        function initializeTooltips() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            initializeTooltips();
        });
    </script>
}
