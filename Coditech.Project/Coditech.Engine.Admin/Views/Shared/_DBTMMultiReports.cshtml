@using System.Data
@model DBTMReportsListViewModel
@{
    Layout = null;
}
<div class="row">
    <div class="col-sm-12 table-responsive">

        @if (Model?.DataTableList != null && Model.DataTableList.Count > 0)
        {
            var tableIndex = 1;
            foreach (var dt in Model.DataTableList)
            {
                <h5 class="mt-3 mb-2 fw-bold">Report Table @tableIndex</h5>
                <table class="action-set table table-striped table-bordered dt-responsive nowrap dataTable no-footer dtr-inline"
                       style="border-collapse: collapse; border-spacing: 0px; width: 100%;" role="grid">
                    <thead>
                        <tr>
                            @foreach (DataColumn col in dt.Columns)
                            {
                                <th>@col.ColumnName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (dt.Rows.Count > 0)
                        {
                            foreach (DataRow row in dt.Rows)
                            {
                                <tr>
                                    @foreach (DataColumn col in dt.Columns)
                                    {
                                        <td>@row[col]</td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@dt.Columns.Count" class="text-danger fw-bold text-center">
                                    No Result Found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                tableIndex++;
            }
        }
        else
        {
            <div class="text-danger fw-bold text-center">No Data Found</div>
        }
    </div>
</div>
