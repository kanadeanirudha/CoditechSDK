    <script>
        if (performance.navigation.type == 2) {
            location.reload();
        }

        window.onbeforeunload = function () {
            var inputs = document.getElementsByTagName("button");
            for (var i = 0; i < inputs.length; i++) {
                if (inputs[i].type == "button" || inputs[i].type == "submit") {
                    inputs[i].disabled = true;
                }
            }
        };
        function initializeSelect2Dropdowns(context) {
            var $context = context ? $(context) : $(document);
            var isIOS = $('body').hasClass('is-ios');
            var selector = isIOS ? 'select.js-select2, select.selectpicker' : 'select.js-select2';
            $context.find(selector).each(function () {
                var $select = $(this);
                if ($select.hasClass('select2-hidden-accessible')) return;
                if (isIOS && $select.data('selectpicker')) {
                    $select.selectpicker('destroy');
                    $select.removeClass('selectpicker');
                }
                var dropdownParentElement = $select.closest('.modal').length ? $select.closest('.modal') : null;
                $select.select2({
                    allowClear: false,
                    width: '100%',
                    dropdownParent: dropdownParentElement,
                    minimumResultsForSearch: 0
                }).on('select2:opening', function (e) {
                    $(this).next('.select2-container').css('width', '100%');
                });
            });
        }
        $(document).ready(function () {
            var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
            if (isIOS) {
                $('body').addClass('is-ios');
            }
            initializeSelect2Dropdowns();
            $(document).on('focus', '.select2-selection--single', function (e) {
                var $select = $(this).closest('.select2-container').prev('select');
                if (!$select.prop('disabled')) {
                    $select.select2('open');
                }
            });
            $(document).on('select2:open', function (e) {
                if ($('body').hasClass('is-ios')) {
                    setTimeout(function () {
                        var searchField = document.querySelector('.select2-search__field');
                        if (searchField) {
                            searchField.focus();
                        }
                    }, 100);
                }
            });
        });
    </script>
